<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- comment -%}
    Fonts are loaded here instead of through an @import rule so the browser
    can begin downloading them alongside the main stylesheet.
  {%- endcomment -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
  >

  <title>
    {%- if page_title -%}
      {{ page_title }} | {{ shop.name }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>

  {% if page_description %}
    <meta
      name="description"
      content="{{ page_description | escape }}"
    >
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <link
    rel="icon"
    href="{{ 'cameron-co-jewellery-favicon.webp' | asset_url }}"
  >

  <meta
    property="og:title"
    content="{{ page_title | default: shop.name }}"
  >

  {% if page_description %}
    <meta
      property="og:description"
      content="{{ page_description | escape }}"
    >
  {% endif %}

  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="website">

  {% if page_image %}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
  {% else %}
    <meta property="og:image" content="{{ 'cameron-co-homepage-hero-desktop.png' | asset_url }}">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}

  <link
    rel="stylesheet"
    href="{{ 'theme.css' | asset_url }}"
  >

  {% if template.name == 'index' %}
    <link
      rel="stylesheet"
      href="{{ 'index.css' | asset_url }}"
    >
  {% endif %}

  {%- capture h1_font_stack -%}
    {%- case settings.h1_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture h2_font_stack -%}
    {%- case settings.h2_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture h3_font_stack -%}
    {%- case settings.h3_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture h4_font_stack -%}
    {%- case settings.h4_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture h5_font_stack -%}
    {%- case settings.h5_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture h6_font_stack -%}
    {%- case settings.h6_font -%}
      {%- when 'playfair' -%}
        'Playfair Display', Georgia, serif
      {%- when 'garamond' -%}
        'EB Garamond', Georgia, serif
      {%- when 'baskerville' -%}
        'Libre Baskerville', Georgia, serif
      {%- else -%}
        'Cormorant Garamond', Georgia, serif
    {%- endcase -%}
  {%- endcapture -%}

  {%- capture paragraph_font_stack -%}
    {%- case settings.paragraph_font -%}
      {%- when 'montserrat' -%}
        'Montserrat', Arial, sans-serif
      {%- when 'inter' -%}
        'Inter', Arial, sans-serif
      {%- when 'poppins' -%}
        'Poppins', Arial, sans-serif
      {%- else -%}
        'Montserrat', Arial, sans-serif
    {%- endcase -%}
  {%- endcapture -%}

  <style>
    :root {
      --heading-1-color: {{ settings.h1_color }};
      --heading-1-font: {{ h1_font_stack }};
      --heading-1-size: {{ settings.h1_size | default: 40 }}px;

      --heading-2-color: {{ settings.h2_color }};
      --heading-2-font: {{ h2_font_stack }};
      --heading-2-size: {{ settings.h2_size | default: 40 }}px;

      --heading-3-color: {{ settings.h3_color }};
      --heading-3-font: {{ h3_font_stack }};
      --heading-3-size: {{ settings.h3_size | default: 40 }}px;

      --heading-4-color: {{ settings.h4_color }};
      --heading-4-font: {{ h4_font_stack }};
      --heading-4-size: {{ settings.h4_size | default: 40 }}px;

      --heading-5-color: {{ settings.h5_color }};
      --heading-5-font: {{ h5_font_stack }};
      --heading-5-size: {{ settings.h5_size | default: 40 }}px;

      --heading-6-color: {{ settings.h6_color }};
      --heading-6-font: {{ h6_font_stack }};
      --heading-6-size: {{ settings.h6_size | default: 40 }}px;

      --paragraph-color: {{ settings.paragraph_color }};
      --paragraph-font: {{ paragraph_font_stack }};

      --cc-button-primary-bg: {{ settings.button_primary_background | default: '#B09A6F' }};
      --cc-button-primary-text: {{ settings.button_primary_text | default: '#FFFFFF' }};
      --cc-button-primary-hover-bg: {{ settings.button_primary_hover_background | default: '#B9971F' }};
      --cc-button-primary-hover-text: {{ settings.button_primary_hover_text | default: '#FFFFFF' }};
      --cc-button-primary-border: {{ settings.button_primary_border | default: '#B09A6F' }};
      --cc-button-primary-hover-border: {{ settings.button_primary_hover_border | default: '#B9971F' }};
      --cc-button-primary-border-width: {{ settings.button_primary_border_width | default: 1 }}px;
      --cc-button-primary-radius: {{ settings.button_primary_radius | default: 100 }}px;
      --cc-button-primary-font-size: {{ settings.button_primary_font_size | default: 14 }}px;
      --cc-button-primary-transparency: {{ 100 | minus: settings.button_primary_transparency | default: 100 }}%;
      --cc-button-primary-hover-transparency: {{ 100 | minus: settings.button_primary_hover_transparency | default: 100 }}%;

      --cc-button-secondary-bg: {{ settings.button_secondary_background | default: '#171D29' }};
      --cc-button-secondary-text: {{ settings.button_secondary_text | default: '#FFFFFF' }};
      --cc-button-secondary-hover-bg: {{ settings.button_secondary_hover_background | default: '#0F141D' }};
      --cc-button-secondary-hover-text: {{ settings.button_secondary_hover_text | default: '#FFFFFF' }};
      --cc-button-secondary-border: {{ settings.button_secondary_border | default: '#171D29' }};
      --cc-button-secondary-hover-border: {{ settings.button_secondary_hover_border | default: '#0F141D' }};
      --cc-button-secondary-border-width: {{ settings.button_secondary_border_width | default: 1 }}px;
      --cc-button-secondary-radius: {{ settings.button_secondary_radius | default: 100 }}px;
      --cc-button-secondary-font-size: {{ settings.button_secondary_font_size | default: 14 }}px;
      --cc-button-secondary-transparency: {{ 100 | minus: settings.button_secondary_transparency | default: 100 }}%;
      --cc-button-secondary-hover-transparency: {{ 100 | minus: settings.button_secondary_hover_transparency | default: 100 }}%;

      --cc-button-outline-bg: {{ settings.button_outline_background | default: '#FFFFFF' }};
      --cc-button-outline-text: {{ settings.button_outline_text | default: '#171D29' }};
      --cc-button-outline-hover-bg: {{ settings.button_outline_hover_background | default: '#171D29' }};
      --cc-button-outline-hover-text: {{ settings.button_outline_hover_text | default: '#FFFFFF' }};
      --cc-button-outline-border: {{ settings.button_outline_border | default: '#171D29' }};
      --cc-button-outline-hover-border: {{ settings.button_outline_hover_border | default: '#171D29' }};
      --cc-button-outline-border-width: {{ settings.button_outline_border_width | default: 1 }}px;
      --cc-button-outline-radius: {{ settings.button_outline_radius | default: 100 }}px;
      --cc-button-outline-font-size: {{ settings.button_outline_font_size | default: 14 }}px;
      --cc-button-outline-transparency: {{ 100 | minus: settings.button_outline_transparency | default: 100 }}%;
      --cc-button-outline-hover-transparency: {{ 100 | minus: settings.button_outline_hover_transparency | default: 100 }}%;
    }


    /* =====================================================
       ACCESSIBILITY
       Hides content visually without reserving page space
       ===================================================== */

    .sr-only {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      clip-path: inset(50%) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }


    /* =====================================================
       GLOBAL HEADING AND PARAGRAPH DEFAULTS
       Theme settings → Headings / Paragraph
       ===================================================== */

    h1,
    h1.section-title {
      color: var(--heading-1-color);
      font-family: var(--heading-1-font);
      font-size: var(--heading-1-size);
    }

    h2,
    h2.section-title {
      color: var(--heading-2-color);
      font-family: var(--heading-2-font);
      font-size: var(--heading-2-size);
    }

    h3 {
      color: var(--heading-3-color);
      font-family: var(--heading-3-font);
      font-size: var(--heading-3-size);
    }

    h4 {
      color: var(--heading-4-color);
      font-family: var(--heading-4-font);
      font-size: var(--heading-4-size);
    }

    h5 {
      color: var(--heading-5-color);
      font-family: var(--heading-5-font);
      font-size: var(--heading-5-size);
    }

    h6 {
      color: var(--heading-6-color);
      font-family: var(--heading-6-font);
      font-size: var(--heading-6-size);
    }

    /*
      Elements using the shared body-font utility classes inherit
      the global paragraph settings when a section-specific setting
      has not been selected.

      Section-level inline styles and the font utility classes can
      still override these defaults.
    */

    .section-subtitle,
    [class*="cc-font-body-"] {
      color: var(--paragraph-color);
      font-family: var(--paragraph-font);
    }


    /* =====================================================
       ABOUT AND ARTICLE PAGE SELECTORS
       ===================================================== */

    .about-title-band h2,
    .live-article-hero h1 {
      color: var(--heading-2-color);
      font-family: var(--heading-2-font);
    }

    .about-expertise h2,
    .about-mission-grid h2,
    .about-text-card h2,
    .about-values-card h2,
    .article-section h2,
    .article-copy h2,
    .live-article-section h2 {
      color: var(--heading-2-color);
      font-family: var(--heading-2-font);
    }

    .live-article-section h2,
    .about-mission-grid h2,
    .about-text-card h2,
    .about-values-card h2,
    .faq-column-cc h2 {
      color: var(--heading-2-color);
      font-family: var(--heading-2-font);
    }

    .about-intro-copy p,
    .about-text-card p,
    .about-values-card p,
    .about-values-card li,
    .article-section p,
    .article-copy p,
    .article-card-grid p,
    .article-section li,
    .live-article-section p,
    .live-article-section li,
    .live-article-hero .tagline,
    .article-subtitle {
      color: var(--paragraph-color);
      font-family: var(--paragraph-font);
    }


    /* =====================================================
       FAQ AND OFFICE SERVICE SELECTORS
       ===================================================== */

    .faq-list summary,
    .faq-list details p,
    .service-list-item h2 {
      font-family: var(--paragraph-font);
    }


    /* =====================================================
       HOMEPAGE HEADER-TO-HERO SPACING
       Removes blank space above the first homepage section
       ===================================================== */

    body.index-page #main-content {
      display: block;
      margin: 0 !important;
      padding: 0 !important;
      gap: 0 !important;
      row-gap: 0 !important;
    }

    body.index-page #main-content > .sr-only {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
    }

    body.index-page #main-content > .shopify-section:first-of-type,
    body.index-page #main-content > [id^="shopify-section-"]:first-of-type {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }

    body.index-page .site-header {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }


    /* =====================================================
       MOBILE HOMEPAGE SPACING
       ===================================================== */

    @media (max-width: 900px) {
      body.index-page #main-content {
        margin-top: 0 !important;
        padding-top: 0 !important;
      }
    }
  </style>
</head>

<body class="cc-site {{ template.name | handleize }}-page">

  {% section 'header' %}

  {%- comment -%}
    Each Liquid page template below supplies its own main element.

    JSON templates built from sections do not include a
    template-level main wrapper, so the main element is added here.
  {%- endcomment -%}

  {% assign cc_json_templates = 'index,cart,page.ring-builder,page.diamonds,page.faq,page.melbourne-office,page.sydney-office,page.melbourne-services,page.sydney-services,page.contact,page.about,page.testimonials,page.jewellery-care,page.timeless-vs-trendy-jewellery,page.understanding-diamonds,page.booking,page.jewelleryrepairs,page.jewelleryreplacement,page.appraisals,page.jewelleryremodelling' | split: ',' %}

  {% assign cc_template_key = template.name %}

  {% if template.suffix != blank %}
    {% assign cc_template_key = template.name | append: '.' | append: template.suffix %}
  {% endif %}

  {% if cc_json_templates contains cc_template_key %}

    <main
      class="page-content"
      id="main-content"
    >
      {% if template.name == 'index' %}
        <h1 class="sr-only">
          Jewellery Insurance Specialists in Melbourne and Sydney
        </h1>
      {% endif %}

      {{ content_for_layout }}
    </main>

  {% else %}

    {{ content_for_layout }}

  {% endif %}

  {% section 'footer' %}

  {% render 'pricing-modal' %}
  {% render 'cookie-consent' %}

  <script
    src="{{ 'theme.js' | asset_url }}"
    defer
  ></script>

  {% if settings.google_maps_api_key != blank %}
    <script
      src="https://maps.googleapis.com/maps/api/js?key={{ settings.google_maps_api_key }}&callback=initStyledMaps"
      defer
    ></script>
  {% endif %}
</body>
</html>
