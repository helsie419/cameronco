  {
    "name": "Paragraph",
    "settings": [
      {
        "type": "paragraph",
        "content": "Sets the default color and font for body copy site-wide (intro text, descriptions, quotes). Individual sections still have their own text color pickers where they exist — leave those blank to use the value set here, or pick a value there to override it just on that page. The footer and homepage hero have their own dedicated colors and are not affected by this panel."
      },
      { "type": "color", "id": "paragraph_color", "label": "Color", "default": "#171d29" },
      {
        "type": "select",
        "id": "paragraph_font",
        "label": "Font",
        "options": [
          { "value": "glacial", "label": "Glacial Indifference (default)" },
          { "value": "montserrat", "label": "Montserrat" },
          { "value": "inter", "label": "Inter" },
          { "value": "poppins", "label": "Poppins" }
        ],
        "default": "glacial"
      }
    ]
  },
  {
    "name": "Google Maps",
    "settings": [
      {
        "type": "paragraph",
        "content": "Powers the custom-styled office maps on the Contact page and office/services pages. Needs a Google Maps Platform API key with the Maps JavaScript API enabled. Leave blank and every map falls back to the plain embedded map (no custom styling, but still works)."
      },
      { "type": "text", "id": "google_maps_api_key", "label": "Maps JavaScript API key" }
    ]
  },
