<style>
@media (max-width: 900px) {
  #services-heading { color: {{ section.settings.heading_color_mobile }} !important; }
  .what-we-do-section .section-eyebrow { color: {{ section.settings.eyebrow_color_mobile }} !important; }
  {% if section.settings.item_title_color_mobile != blank %}.what-we-do-section .service-item h2 { color: {{ section.settings.item_title_color_mobile }} !important; }{% endif %}
}
</style>
<section aria-labelledby="services-heading" class="what-we-do-section" style="background:{{ section.settings.background_color }};">
  <div class="section-inner">
    <div class="section-eyebrow cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</div>
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="services-heading" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
    <div class="service-list">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a class="service-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% else %}
          <article class="service-item" {{ block.shopify_attributes }}>
        {% endif %}
          <h2 class="{% if section.settings.item_title_font != blank %}cc-font-heading-{{ section.settings.item_title_font }}{% endif %}" style="{% if section.settings.item_title_color != blank %}color:{{ section.settings.item_title_color }};{% endif %}">{{ block.settings.title }}</h2>
          <p class="cc-preserve-line-breaks">{{ block.settings.description }}</p>
        {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
      {% endfor %}
    </div>
    <div class="btn-row-center home-chat-button-row">
      <a class="home-button home-button-dark cc-button-{{ section.settings.button_style | default: 'primary' }}" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
    </div>
  </div>
  {% if section.settings.show_side_image %}
    {% if section.settings.rings_image %}
      <img alt="{{ section.settings.rings_image_alt | escape }}" class="what-we-do-rings" height="369" loading="lazy" src="{{ section.settings.rings_image | image_url: width: 236 }}" width="236">
    {% else %}
      <img alt="{{ section.settings.rings_image_alt | escape }}" class="what-we-do-rings" height="369" loading="lazy" src="{{ 'cameron-co-multicolour-gemstone-diamond-gold-ring.webp' | asset_url }}" width="236">
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Services list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we can do for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four ways we help" },
    { "type": "checkbox", "id": "show_side_image", "label": "Show side image", "default": false },
    { "type": "image_picker", "id": "rings_image", "label": "Side image" },
    { "type": "text", "id": "rings_image_alt", "label": "Side image alt text", "default": "Stack of gold and silver bezel-set gemstone rings" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Chat to us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }
    ], "default": "primary" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#BD9C42" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#171d29", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "item_title_color", "label": "Item title color", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "header", "content": "Colors — mobile only" },
    { "type": "color", "id": "eyebrow_color_mobile", "label": "Eyebrow color (mobile)", "default": "#BD9C42" },
    { "type": "color", "id": "heading_color_mobile", "label": "Heading color (mobile)", "default": "#171d29" },
    { "type": "color", "id": "item_title_color_mobile", "label": "Item title color (mobile)", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    },
    {
      "type": "select",
      "id": "item_title_font",
      "label": "Item title font",
      "info": "Leave unset to use the global Heading 3 font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank for no link" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
