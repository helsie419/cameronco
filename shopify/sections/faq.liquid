<section aria-labelledby="faq-heading">
  <div class="section-inner">
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="faq-heading" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
    {% if section.settings.intro != blank %}
      <p class="section-subtitle cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.answer_color }};">{{ section.settings.intro }}</p>
    {% endif %}
    <div class="faq-columns-cc">
      {% assign category_keys = "claim-process,repairs-care,credits-upgrades" | split: ',' %}
      {% for category_key in category_keys %}
        {% assign category_index = forloop.index0 %}
        {% case category_index %}
          {% when 0 %}{% assign category_label = section.settings.category_1_label %}
          {% when 1 %}{% assign category_label = section.settings.category_2_label %}
          {% when 2 %}{% assign category_label = section.settings.category_3_label %}
        {% endcase %}
        <div class="faq-column-cc">
          <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.category_color != blank %}color:{{ section.settings.category_color }};{% endif %}">
            {{ category_label }}
          </h2>
          <div class="faq-list">
            {% for block in section.blocks %}
              {% if block.settings.category == category_key %}
                <details {{ block.shopify_attributes }}>
                  <summary class="cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.question_color }};">{{ block.settings.question }}</summary>
                  <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.answer_color }};">{{ block.settings.answer }}</p>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    <!-- STILL HAVE QUESTIONS CTA -->
    <div class="cc-moved-style-007" style="background:{{ section.settings.cta_background_color }};">
      <h2 class="cc-moved-style-008{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.cta_heading_color != blank %}color:{{ section.settings.cta_heading_color }};{% endif %}">{{ section.settings.cta_heading }}</h2>
      <p class="cc-moved-style-009 cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.cta_text_color }};">{{ section.settings.cta_text }}</p>
      <div class="cc-moved-style-010">
        <a class="btn-book btn-outline-red btn-red cc-button-{{ section.settings.cta_button_1_style | default: 'outline' }} cc-moved-style-011 cc-font-body-{{ section.settings.body_font }}" href="{{ section.settings.cta_button_1_link | default: pages['contact'].url }}">{{ section.settings.cta_button_1_text }}</a>
        <a class="btn-book btn-red cc-button-{{ section.settings.cta_button_2_style | default: 'primary' }} cc-moved-style-012 cc-font-body-{{ section.settings.body_font }}" href="{{ section.settings.cta_button_2_link | default: pages['booking'].url }}">{{ section.settings.cta_button_2_text }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "intro", "label": "Intro text (optional)" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "intro_image", "label": "Image" },
    { "type": "text", "id": "intro_image_alt", "label": "Image alt text" },
    { "type": "text", "id": "intro_image_fallback", "label": "Image fallback filename", "info": "Asset filename used if no image is selected above." },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "category_1_label", "label": "Category 1 heading", "default": "Claim Process" },
    { "type": "text", "id": "category_2_label", "label": "Category 2 heading", "default": "Repairs & Care" },
    { "type": "text", "id": "category_3_label", "label": "Category 3 heading", "default": "Credits & Upgrades" },
    { "type": "header", "content": "Still have questions CTA" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Still Have Questions?" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Get in touch with our friendly consultants for any enquiries regarding claims, custom designs, or repairs." },
    { "type": "text", "id": "cta_button_1_text", "label": "First button text", "default": "Contact Us" },
    { "type": "url", "id": "cta_button_1_link", "label": "First button link (defaults to Contact page)" },
    { "type": "select", "id": "cta_button_1_style", "label": "First button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }
    ], "default": "outline" },
    { "type": "text", "id": "cta_button_2_text", "label": "Second button text", "default": "Book Appointment" },
    { "type": "url", "id": "cta_button_2_link", "label": "Second button link (defaults to Booking page)" },
    { "type": "select", "id": "cta_button_2_style", "label": "Second button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }
    ], "default": "primary" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "category_color", "label": "Category heading color", "default": "#19202c", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "color", "id": "question_color", "label": "Question text color", "default": "#19202c" },
    { "type": "color", "id": "answer_color", "label": "Answer text color", "default": "#2c2f33" },
    { "type": "color", "id": "cta_background_color", "label": "CTA background", "default": "#f7f5f3" },
    { "type": "color", "id": "cta_heading_color", "label": "CTA heading color", "default": "#19202c", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "cta_text_color", "label": "CTA text color", "default": "#6b7280" },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "claim-process", "label": "Claim Process" },
            { "value": "repairs-care", "label": "Repairs & Care" },
            { "value": "credits-upgrades", "label": "Credits & Upgrades" }
          ],
          "default": "claim-process"
        },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 40
}
{% endschema %}
