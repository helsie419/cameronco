      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Still Image" },
        { "value": "video", "label": "Background Video" }
      ],
      "default": "image",
      "info": "Switch between Still Image and Background Video to compare performance in your store."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (or Video Poster Fallback)"
