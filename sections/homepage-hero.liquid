      "id": "mobile_background_image",
      "label": "Mobile Background Image",
      "info": "Optional portrait crop for phones. Recommended size: 1080 x 1440 or 1080 x 1620."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Hosted Video",
