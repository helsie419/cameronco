<style>
/* =========================================================
   CAMERON & CO HERO — GLOBAL RESET & LAYOUT
   ========================================================= */

body.template-index main,
body.template-index #MainContent,
body.template-index .main-content,
body.template-index .content-for-layout,
body.template-index [role="main"] {
  margin-top: 0 !important;
  padding-top: 0 !important;
  gap: 0 !important;
  row-gap: 0 !important;
  column-gap: 0 !important;
}

.site-header,
.shopify-section-group-header-group,
#shopify-section-header,
header.site-header {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

body.template-index #shopify-section-{{ section.id }} {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

/* =========================================================
   HERO — DESKTOP
   ========================================================= */

.site-hero {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 600px;
  margin: 0 !important;
  padding: 0 !important;
  border-top: 0 !important;
}

.site-hero-photo {
  position: absolute;
  inset: 0 !important;
  width: 100%;
  height: 100%;
  background-repeat: no-repeat;
  background-position: center top;
  background-size: cover;
  overflow: hidden;
}

.site-hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 1;
}

.site-hero-inner {
  position: relative;
  z-index: 2;
  padding: 60px 40px;
  margin-left: 12vw;
  max-width: 650px;
}

.site-hero h1 {
  font-family: "EB Garamond", Georgia, serif;
  font-size: clamp(46px, 5.2vw, 72px);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin: 0;
}

.site-hero-eyebrow {
  font-family: "EB Garamond", Georgia, serif;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  margin-bottom: 30px;
  transform: translate(var(--el-x, 0px), var(--el-y, 0px));
}

.site-hero-line1 {
  display: block;
  font-family: "EB Garamond", Georgia, serif;
  font-weight: 400;
  font-style: normal;
  transform: translate(var(--el-x, 0px), var(--el-y, 0px));
}

.site-hero-line2 {
  display: block;
  font-family: "EB Garamond", Georgia, serif;
  font-weight: 400;
  font-style: italic;
  margin-top: 6px;
  transform: translate(var(--el-x, 0px), var(--el-y, 0px));
}

.site-hero-cta {
  font-weight: 500;
  height: 46px !important;
  width: 220px !important;
  justify-content: center !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  box-sizing: border-box !important;
  transform: translate(var(--el-x, 0px), var(--el-y, 0px)) !important;
}

@media (max-width: 768px) {
  .site-hero h1 {
    font-size: clamp(36px, 10vw, 52px);
  }

  .site-hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    margin-bottom: 18px;
  }
}

/* =========================================================
   HERO — MOBILE ADJUSTMENTS (<= 900px)
   ========================================================= */

@media (max-width: 900px) {
  /* Single full-bleed background photo, text overlaid on top.
     The image itself has plenty of blank fabric up top (where the
     text sits) and the box lower down — no separate white block. */
  .site-hero {
    min-height: 560px !important;
    height: 76svh !important;
    max-height: 700px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: {{ section.settings.text_v_position_mobile | default: 'flex-end' }} !important;
    align-items: center !important;
    background: #f8f6f2 !important;
  }

  .site-hero-photo {
    position: absolute !important;
    inset: 0 !important;
    {% if section.settings.mobile_background_image %}
      background-image: url('{{ section.settings.mobile_background_image | image_url: width: 1400 }}') !important;
    {% elsif section.settings.background_image %}
      background-image: url('{{ section.settings.background_image | image_url: width: 1400 }}') !important;
    {% else %}
      background-image: url('{{ 'cameron-co-mobile-engagement-ring-box-hero.webp' | asset_url }}') !important;
    {% endif %}
    background-position: center 52% !important;
    background-size: cover !important;
    background-repeat: no-repeat !important;
    transform: none !important;
  }

  .site-hero-video {
    object-position: center 58% !important;
  }

  .site-hero::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    pointer-events: none !important;
    background:
      linear-gradient(to bottom, rgba(255,255,255,.72) 0%, rgba(255,255,255,.36) 28%, rgba(255,255,255,.04) 58%, rgba(255,255,255,.18) 100%),
      radial-gradient(circle at 50% 38%, rgba(255,255,255,.76) 0%, rgba(255,255,255,.36) 28%, rgba(255,255,255,0) 58%) !important;
  }

  .site-hero::after {
    opacity: .55 !important;
  }

  .site-hero-inner {
    position: relative !important;
    z-index: 2 !important;
    padding: 34px 26px 44px !important;
    width: min(100%, 390px) !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    text-align: center !important;
    transform: translate(var(--hero-text-offset-x-mobile, 0px), var(--hero-text-offset-y-mobile, 0px)) !important;
  }

  .site-hero-eyebrow {
    font-size: 11px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase;
    margin-bottom: 12px !important;
    color: {{ section.settings.eyebrow_color_mobile }} !important;
    transform: translate(var(--el-x-m, 0px), var(--el-y-m, 0px)) !important;
  }

  .site-hero-line1 {
    font-size: 21px !important;
    line-height: 1.15 !important;
    color: {{ section.settings.line1_color_mobile }} !important;
    transform: translate(var(--el-x-m, 0px), var(--el-y-m, 0px)) !important;
  }

  .site-hero-line2 {
    font-size: 31px !important;
    line-height: 1.1 !important;
    margin-top: 2px !important;
    margin-bottom: 22px !important;
    color: {{ section.settings.line2_color_mobile }} !important;
    transform: translate(var(--el-x-m, 0px), var(--el-y-m, 0px)) !important;
  }

  .site-hero-line2 .accent {
    color: {{ section.settings.accent_color_mobile }} !important;
  }

  .site-hero-cta {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    width: min(100%, 250px) !important;
    height: 48px !important;
    padding: 0 22px !important;
    font-size: 13px !important;
    margin: 0 auto !important;
    border-radius: 999px !important;
    transform: translate(var(--el-x-m, 0px), var(--el-y-m, 0px)) !important;
  }
}

@media (max-width: 420px) {
  .site-hero {
    min-height: 585px !important;
    height: 78svh !important;
  }

  .site-hero-photo {
    background-position: center 52% !important;
  }

  .site-hero-inner {
    padding-inline: 22px !important;
  }

  .site-hero-eyebrow {
    margin-bottom: 12px !important;
  }
}
</style>

<section
  class="site-hero"
  aria-label="Cameron &amp; Co — jewellery insurance specialists"
  style="
    justify-content: {{ section.settings.text_h_position }};
    align-items: {{ section.settings.text_v_position }};
  "
>
  {% if section.settings.media_type == 'video' %}
    <div class="site-hero-photo">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'site-hero-video' }}
      {% elsif section.settings.video_mp4_url != blank %}
        <video autoplay loop muted playsinline class="site-hero-video"{% if section.settings.background_image %} poster="{{ section.settings.background_image | image_url: width: 2400 }}"{% else %} poster="{{ 'cameron-co-engagement-ring-box-satin-background-hero-v3.webp' | asset_url }}"{% endif %}>
          <source src="{{ section.settings.video_mp4_url }}" type="video/mp4">
        </video>
      {% elsif section.settings.background_image %}
        <div
          class="site-hero-photo"
          style="background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');"
        ></div>
      {% else %}
        <div
          class="site-hero-photo"
          style="background-image: url('{{ 'cameron-co-engagement-ring-box-satin-background-hero-v3.webp' | asset_url }}');"
        ></div>
      {% endif %}
    </div>
  {% else %}
    <div
      class="site-hero-photo"
      style="
        {% if section.settings.background_image %}
          background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
        {% else %}
          background-image: url('{{ 'cameron-co-engagement-ring-box-satin-background-hero-v3.webp' | asset_url }}');
        {% endif %}
      "
    ></div>
  {% endif %}

  <div
    class="site-hero-inner"
    style="
      --hero-text-offset-x-mobile: {{ section.settings.text_offset_x_mobile | default: 0 }}px;
      --hero-text-offset-y-mobile: {{ section.settings.text_offset_y_mobile | default: 0 }}px;
      {% if section.settings.text_offset_x != 0 or section.settings.text_offset_y != 0 %}
        transform: translate(
          {{ section.settings.text_offset_x }}px,
          {{ section.settings.text_offset_y }}px
        );
      {% endif %}
    "
  >
    <div
      class="site-hero-eyebrow cc-font-body-{{ section.settings.body_font }}"
      style="
        color: {{ section.settings.eyebrow_color }};
        --el-x: {{ section.settings.eyebrow_offset_x | default: 0 }}px;
        --el-y: {{ section.settings.eyebrow_offset_y | default: 0 }}px;
        --el-x-m: {{ section.settings.eyebrow_offset_x_mobile | default: 0 }}px;
        --el-y-m: {{ section.settings.eyebrow_offset_y_mobile | default: 0 }}px;
      "
    >
      {{ section.settings.eyebrow }}
    </div>

    <h1>
      <span
        class="site-hero-line1 cc-font-body-{{ section.settings.body_font }}"
        style="
          color: {{ section.settings.line1_color }};
          --el-x: {{ section.settings.line1_offset_x | default: 0 }}px;
          --el-y: {{ section.settings.line1_offset_y | default: 0 }}px;
          --el-x-m: {{ section.settings.line1_offset_x_mobile | default: 0 }}px;
          --el-y-m: {{ section.settings.line1_offset_y_mobile | default: 0 }}px;
        "
      >
        {{ section.settings.line1 }}
      </span>

      <span
        class="site-hero-line2 cc-font-heading-{{ section.settings.heading_font }}"
        style="
          color: {{ section.settings.line2_color }};
          --el-x: {{ section.settings.line2_offset_x | default: 0 }}px;
          --el-y: {{ section.settings.line2_offset_y | default: 0 }}px;
          --el-x-m: {{ section.settings.line2_offset_x_mobile | default: 0 }}px;
          --el-y-m: {{ section.settings.line2_offset_y_mobile | default: 0 }}px;
        "
      >
        {{ section.settings.line2 }}

        <span
          class="accent"
          style="color: {{ section.settings.accent_color }};"
        >
          {{ section.settings.line2_accent }}
        </span>
      </span>
    </h1>

    <a
      class="site-hero-cta"
      href="{{ section.settings.cta_link }}"
      style="
        background: {{ section.settings.button_color }} !important;
        border-color: {{ section.settings.button_color }} !important;
        --el-x: {{ section.settings.button_offset_x | default: 0 }}px;
        --el-y: {{ section.settings.button_offset_y | default: 0 }}px;
        --el-x-m: {{ section.settings.button_offset_x_mobile | default: 0 }}px;
        --el-y-m: {{ section.settings.button_offset_y_mobile | default: 0 }}px;
      "
    >
      {{ section.settings.cta_text }}

      <svg
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Media Options"
    },
    {
      "type": "select",
