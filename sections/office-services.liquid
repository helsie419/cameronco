<section aria-labelledby="office-heading-{{ section.id }}" style="background:{{ section.settings.office_section_background_color }};">
  <div class="section-inner">
    <div class="split-layout">
      <div class="split-text">
        <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="office-heading-{{ section.id }}" style="{% if section.settings.office_name_color != blank %}color:{{ section.settings.office_name_color }};{% endif %}">{{ section.settings.office_name }}</h2>
        <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.body_text_color }};">{{ section.settings.intro_text }}</p>
        <p class="cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.body_text_color }};">
          {{ section.settings.address }}<br>
          Phone <a href="tel:{{ section.settings.phone_href }}" style="color:{{ section.settings.link_color }};">{{ section.settings.phone_display }}</a>.<br>
          Email <a href="mailto:{{ section.settings.email }}" style="color:{{ section.settings.link_color }};">{{ section.settings.email }}</a>.
        </p>
        <div class="office-buttons cc-moved-style-015">
          <a class="btn-office" href="mailto:{{ section.settings.email }}" style="background:#D5B226 !important;border-color:#D5B226 !important;color:#ffffff !important;">{{ section.settings.contact_button_text }}</a>
          <a class="btn-office" href="{{ section.settings.book_button_link }}" style="background:#D5B226 !important;border-color:#D5B226 !important;color:#ffffff !important;">{{ section.settings.book_button_text }}</a>
        </div>
      </div>
      <div class="split-image">
        {% assign office_map_id = 'office-map-' | append: section.id %}
        {% render 'styled-map',
          map_id: office_map_id,
          address: section.settings.address,
          embed_url: section.settings.map_url,
          map_title: section.settings.map_title,
          aria_label: section.settings.map_aria_label
        %}
      </div>
    </div>
  </div>
</section>
<section aria-labelledby="services-heading-{{ section.id }}" style="background:{{ section.settings.services_section_background_color }};">
  <div class="section-inner cc-moved-style-032">
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="services-heading-{{ section.id }}" style="{% if section.settings.services_heading_color != blank %}color:{{ section.settings.services_heading_color }};{% endif %}text-align:left;margin-bottom:20px;">{{ section.settings.services_heading }}</h2>
    <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.services_intro_color }};margin-bottom:10px;">{{ section.settings.services_intro }}</p>
    <div class="service-list">
      {% for block in section.blocks %}
        <div class="service-list-item" {{ block.shopify_attributes }}>
          <div>
            <h2 class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.service_title_color != blank %}color:{{ section.settings.service_title_color }};{% endif %}">{{ block.settings.title }}</h2>
            <p class="cc-preserve-line-breaks" style="color:{{ section.settings.service_description_color }};margin-top:4px;font-size:14px;">{{ block.settings.description }}</p>
          </div>
          <a class="btn-book" href="{{ block.settings.booking_link }}" style="padding:10px 24px;height:auto;min-width:auto;flex-shrink:0;background:#D5B226 !important;border-color:#D5B226 !important;color:#ffffff !important;">{{ block.settings.button_text | default: 'Book Now' }}</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Office & Services",
  "settings": [
    { "type": "header", "content": "Office details" },
    { "type": "text", "id": "office_name", "label": "Office name", "default": "Melbourne Office" },
    { "type": "textarea", "id": "intro_text", "label": "Intro text", "default": "All appointments are obligation free. Select the service you are interested in and choose an available appointment time with the team." },
    { "type": "text", "id": "address", "label": "Address", "default": "73-75 Canterbury Road, Canterbury VIC 3126." },
    { "type": "text", "id": "phone_display", "label": "Phone (displayed)", "default": "(03) 9836 9922" },
    { "type": "text", "id": "phone_href", "label": "Phone (tel: link)", "default": "+61398369922" },
    { "type": "text", "id": "email", "label": "Email", "default": "vicsales@cameronco.com.au" },
    { "type": "text", "id": "contact_button_text", "label": "\"Contact us\" button text", "default": "Contact Us" },
    { "type": "text", "id": "book_button_text", "label": "\"Book services\" button text", "default": "Book Services" },
    { "type": "text", "id": "book_button_link", "label": "\"Book services\" button link", "default": "/pages/booking?office=melbourne" },
    { "type": "header", "content": "Map" },
    { "type": "text", "id": "map_url", "label": "Map embed URL", "info": "Google Maps embed src, e.g. https://maps.google.com/maps?q=...&output=embed", "default": "https://maps.google.com/maps?q=73-75+Canterbury+Road+Canterbury+VIC+3126&output=embed" },
    { "type": "text", "id": "map_title", "label": "Map title (accessibility)", "default": "Melbourne Office Map" },
    { "type": "text", "id": "map_aria_label", "label": "Map aria-label (accessibility, optional)" },
    { "type": "header", "content": "Services list" },
    { "type": "text", "id": "services_heading", "label": "Services heading", "default": "Services Available" },
    { "type": "textarea", "id": "services_intro", "label": "Services intro text", "default": "Select a service below to book your appointment with our team." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "office_section_background_color", "label": "Office section background", "default": "#ffffff" },
    { "type": "color", "id": "office_name_color", "label": "Office name color", "default": "#19202c", "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)." },
    { "type": "color", "id": "body_text_color", "label": "Body text color", "default": "#2c2f33" },
    { "type": "color", "id": "link_color", "label": "Phone/email link color", "default": "#D5B226" },
    { "type": "color", "id": "contact_button_color", "label": "\"Contact us\" / \"Book services\" button color", "default": "#D5B226" },
    { "type": "color", "id": "services_section_background_color", "label": "Services section background", "default": "#f7f5f3" },
    { "type": "color", "id": "services_heading_color", "label": "Services heading color", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "services_intro_color", "label": "Services intro text color", "default": "#6b7280" },
    { "type": "color", "id": "service_title_color", "label": "Service item title color", "default": "#19202c", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "color", "id": "service_description_color", "label": "Service item description color", "default": "#6b7280" },
    { "type": "color", "id": "book_button_color", "label": "\"Book now\" button color", "default": "#D5B226" },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description", "info": "Include duration in the text if relevant, e.g. \"(1 hr)\"" },
        { "type": "text", "id": "booking_link", "label": "Booking link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Book Now" }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
