<style>
@media (max-width: 900px) {
  #testimonials-heading { color: {{ section.settings.heading_color_mobile }} !important; }
  .home-testimonials-preview .section-eyebrow { color: {{ section.settings.eyebrow_color_mobile }} !important; }
  .home-testimonial-card h2 { color: {{ section.settings.name_color_mobile }} !important; }
  {% if section.settings.quote_color_mobile != blank %}.home-testimonial-card p { color: {{ section.settings.quote_color_mobile }} !important; }{% endif %}
}
</style>
<section aria-labelledby="testimonials-heading" class="home-testimonials-preview" style="background:{{ section.settings.background_color }};">
  <div class="section-inner">
    <div class="section-eyebrow cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</div>
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="testimonials-heading" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
    <div class="home-testimonials-list">
      {% for block in section.blocks %}
        <article class="home-testimonial-card" {{ block.shopify_attributes }}>
          <img alt="" aria-hidden="true" class="testimonial-diamond" src="{{ 'cameron-co-diamond-icon-small.webp' | asset_url }}" width="22" height="22">
          <h2 class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ block.settings.name }}</h2>
          <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.quote_color != blank %}color:{{ section.settings.quote_color }};{% endif %}">{{ block.settings.quote }}</p>
        </article>
      {% endfor %}
    </div>
    <div class="btn-row-center home-testimonials-button-row">
      <a class="home-button home-button-dark cc-button-{{ section.settings.button_style | default: 'primary' }}" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What others have to say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Client stories" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }
    ], "default": "primary" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#B09A6F" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#171d29", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "name_color", "label": "Customer name color", "default": "#B09A6F", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "color", "id": "quote_color", "label": "Quote text color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "header", "content": "Colors — mobile only" },
    { "type": "color", "id": "eyebrow_color_mobile", "label": "Eyebrow color (mobile)", "default": "#B09A6F" },
    { "type": "color", "id": "heading_color_mobile", "label": "Heading color (mobile)", "default": "#171d29" },
    { "type": "color", "id": "name_color_mobile", "label": "Customer name color (mobile)", "default": "#B09A6F" },
    { "type": "color", "id": "quote_color_mobile", "label": "Quote text color (mobile)", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
