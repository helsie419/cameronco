<style>
  #page-intro-{{ section.id }} {
    width: 100%;
    text-align: center;
  }

  #page-intro-{{ section.id }} .section-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  #page-intro-{{ section.id }} .section-eyebrow {
    margin-bottom: 12px;
  }

  #page-intro-{{ section.id }} .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  #page-intro-{{ section.id }} .page-intro-description {
    width: 100%;
    max-width: 1150px;
    margin-left: auto;
    margin-right: auto;
  }

  #page-intro-{{ section.id }} .page-intro-description p {
    width: 100%;
    max-width: none;
    margin-left: auto;
    margin-right: auto;
  }

  #page-intro-{{ section.id }} .page-intro-cta-wrap {
    margin-top: 28px;
    text-align: center;
  }

  #page-intro-{{ section.id }} .page-intro-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 28px;
    background: {{ section.settings.button_background | default: '#171d29' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    border: 1px solid {{ section.settings.button_background | default: '#171d29' }};
    border-radius: 0;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  #page-intro-{{ section.id }} .page-intro-cta:hover {
    background: {{ section.settings.button_hover_background | default: '#c79a3b' }};
    border-color: {{ section.settings.button_hover_background | default: '#c79a3b' }};
    color: {{ section.settings.button_hover_text_color | default: '#ffffff' }};
  }

  @media screen and (max-width: 749px) {
    #page-intro-{{ section.id }} .section-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    #page-intro-{{ section.id }} .page-intro-description {
      max-width: 100%;
    }

    #page-intro-{{ section.id }} .page-intro-cta-wrap {
      margin-top: 22px;
    }

    #page-intro-{{ section.id }} .page-intro-cta {
      padding: 12px 24px;
    }
  }
</style>

<section
  id="page-intro-{{ section.id }}"
  class="page-intro-section"
  aria-labelledby="page-intro-heading-{{ section.id }}"
>
  <div class="section-inner">

    {% if section.settings.eyebrow != blank %}
      <div class="section-eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2
        class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}"
        id="page-intro-heading-{{ section.id }}"
        style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div
        class="section-subtitle page-intro-description{% if section.settings.description_font != blank %} cc-font-body-{{ section.settings.description_font }}{% endif %}"
        style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}"
      >
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="page-intro-cta-wrap">
        <a
          class="page-intro-cta"
          href="{{ section.settings.button_link }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Jewellery remodelling",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REIMAGINE WHAT YOU ALREADY LOVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Jewellery Remodelling"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Give treasured jewellery a new life with a considered redesign. Whether you have an inherited piece, a ring that no longer suits your style, or stones you would like reset, we can transform your existing jewellery into something made to be worn and enjoyed again.</p>"
    },

    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a consultation",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#171d29"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#c79a3b"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)."
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        {
          "value": "cormorant",
          "label": "Cormorant Garamond"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "garamond",
          "label": "EB Garamond"
        },
        {
          "value": "baskerville",
          "label": "Libre Baskerville"
        }
      ]
    },

    {
      "type": "header",
      "content": "Description style"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)."
    },
    {
      "type": "select",
      "id": "description_font",
      "label": "Description font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        {
          "value": "glacial",
          "label": "Glacial Indifference"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Jewellery remodelling"
    }
  ]
}
{% endschema %}
