<style>
/* =========================================================
   CAMERON & CO HEADER — single source of truth

   This used to be spread across ~7 separate "final word" patches
   in theme.css.liquid (dated things like "2026-06 definitive
   correction patch", "FINAL QA CORRECTION PATCH", "2026-07 header
   relayout v2", "UNIFIED HEADER POSITIONING"), each re-declaring
   the same properties and only winning by a mix of !important,
   CSS specificity and source order. All of that has been
   consolidated into this one block, which reproduces the same
   final computed result. Edit here — nothing else in the theme
   should style .site-header, .site-logo, .menu-icon, .primary-nav,
   .dropdown or the header's .btn-book.

   Real breakpoint: the burger replaces the inline nav at 1200px
   (not 900px, despite what older comments elsewhere claimed).
   ========================================================= */

.site-header {
  position: relative;
  z-index: 1000;
  width: 100%;
  background: {{ section.settings.background_color | default: '#ffffff' }} !important;
  background-image: none !important;
  border: 0 !important;
  box-shadow: none !important;
  opacity: 1 !important;
  padding: 0 !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;

  /* Outer minimum height. Taller than .header-inner's own min-height
     below — that's intentional and matches the header's current
     live sizing, not a bug to "fix" here. */
  min-height: 84px;
}

@media (prefers-reduced-motion: no-preference) {
  @keyframes ccHeaderDrop {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .site-header {
    animation: ccHeaderDrop 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
}

.site-header::before,
.site-header::after {
  content: none !important;
  display: none !important;
  background: none !important;
  background-image: none !important;
  opacity: 1 !important;
}

.site-header .header-inner {
  display: grid;
  grid-template-columns: 56px 1fr 0;
  grid-template-rows: auto auto;
  column-gap: 28px;
  align-items: center;
  min-height: 42px;
  padding: 0 22px !important;
}

.site-logo {
  grid-column: 1;
  grid-row: 1 / 3;
  align-self: center;
  justify-self: start;
  /* Mobile offset by default; overridden by the desktop offset
     inside the desktop media query below. Neither needs !important
     — the desktop rule is later in source order, so it naturally
     wins at ≥1201px. */
  transform: translate(var(--logo-x-m, 0px), var(--logo-y-m, 0px));
}

.site-header .site-logo img {
  /* Controlled by the "Logo size — mobile" setting in the theme
     editor (Header section). Width scales proportionally — no
     max-width cap, it fights the height and forces a squish. */
  height: {{ section.settings.logo_size_mobile | default: 28 }}px !important;
  width: auto !important;
  max-width: none !important;
}

.site-header nav {
  grid-column: 2;
  grid-row: 2;
  align-self: end;
  justify-content: flex-end;
  min-width: 0;
  display: none;
}

.site-header .menu-icon {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  padding: 8px;
  border: 1px solid rgba(140, 106, 47, 0.32);
  border-radius: 50%;
  background: #ffffff;
  width: 46px;
  height: 46px;
  z-index: 210;
  grid-column: 3;
  grid-row: 1;
  justify-self: center;
  /* Breathing room from the right edge of the screen — the grid
     column it sits in is 0 width by design (see header-inner
     above), so without this it renders flush against the edge. */
  margin-right: 18px;
}

.site-header .menu-icon span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--color-brand-red);
  border-radius: 10px;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.site-header .menu-icon span:last-child {
  width: 16px;
}

.site-header .menu-icon.open span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.site-header .menu-icon.open span:nth-child(2) {
  opacity: 0;
}

.site-header .menu-icon.open span:nth-child(3) {
  width: 24px;
  transform: translateY(-7px) rotate(-45deg);
}

/* ---- Nav link appearance (shared by desktop + open mobile panel) ---- */

.site-header .primary-nav-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: {{ section.settings.nav_color | default: '#D5B226' }} !important;
  font-weight: 500;
  text-decoration: none !important;
  white-space: nowrap !important;
  background: transparent;
  border: 0;
}

.site-header .primary-nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -3px;
  width: 100%;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.2s ease;
}

.site-header .primary-nav-link:hover::after,
.site-header .primary-nav-link:focus-visible::after,
.site-header .primary-nav-link[aria-current="page"]::after {
  transform: scaleX(1);
}

.site-header .primary-nav > li > .nav-parent svg {
  width: 8px;
  height: 8px;
  fill: currentColor;
  flex-shrink: 0;
  margin-left: 4px;
}

/* ---- Desktop dropdown (submenu on nav items with children) ---- */

.site-header .dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #ffffff;
  box-shadow: 0 7px 18px rgba(0, 0, 0, 0.08);
  min-width: 210px;
  padding: 10px 0 16px;
  z-index: 300;
  list-style: none;
}

.site-header .primary-nav > li:hover .dropdown,
.site-header .primary-nav > li.dropdown-open .dropdown {
  display: block;
}

.site-header .dropdown a {
  display: block;
  font-family: "Montserrat", Arial, sans-serif;
  font-size: 13px;
  color: #171d29;
  background: #ffffff;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  padding: 14px 18px;
  min-height: auto;
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  transition: background 0.15s, color 0.15s;
}

.site-header .dropdown li:last-child a {
  border-bottom: none;
}

.site-header .dropdown a:hover {
  background: #f7f3ee;
  color: #D5B226;
}

@media (prefers-reduced-motion: no-preference) {
  .site-header .dropdown {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
  }
  .site-header .primary-nav > li:hover > .dropdown,
  .site-header .primary-nav > li:focus-within > .dropdown {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- Booking button (structural placement only — its color comes
   from the shared "UNIFIED PRIMARY BUTTON STYLE" rule in
   theme.css.liquid, same as every other primary CTA on the site) ---- */

.site-header .btn-book {
  display: none;
  flex: 0 0 auto;
  white-space: nowrap !important;
}

/* =========================================================
   DESKTOP — nav visible inline, burger hidden. 1200px is the
   theme's real threshold, not the 900/1250px older comments
   elsewhere assumed.
   ========================================================= */
@media (min-width: 1201px) {

  .site-header {
    min-height: 118px;
  }

  .site-header .header-inner {
    grid-template-columns: 260px minmax(0, 1fr) 240px;
    column-gap: 34px;
    min-height: 50px;
    max-width: 1540px;
    padding: 0 36px !important;
  }

  .site-logo {
    transform: translate(var(--logo-x, 0px), var(--logo-y, 0px));
  }

  .site-header .site-logo img {
    /* Controlled by the "Logo size" setting in the theme editor
       (Header section). Width scales proportionally. */
    height: {{ section.settings.logo_size | default: 40 }}px !important;
    width: auto !important;
    max-width: none !important;
  }

  .site-header nav {
    display: block;
    padding-top: 0;
  }

  .site-header .primary-nav {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    white-space: nowrap;
    justify-content: flex-end;
    gap: 18px;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .site-header .primary-nav > li {
    position: relative;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .site-header .primary-nav-link {
    font-size: 16px;
    line-height: 1.2;
    white-space: nowrap !important;
  }

  .site-header .menu-icon {
    display: none;
  }

  .site-header .btn-book {
    display: inline-flex;
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-self: end;

    /* Matches .site-hero-cta's height so the header button and the
       hero button read as the same size. Width is fixed 10px
       narrower than the hero button's fixed 220px. */
    min-height: 46px !important;
    width: auto !important;
    min-width: 230px !important;
    justify-content: center !important;
    padding: 0 30px !important;
    box-sizing: border-box !important;
    line-height: 1 !important;
  }
}

@media (min-width: 1201px) and (max-width: 1380px) {
  .site-header .header-inner {
    grid-template-columns: 230px minmax(0, 1fr) 220px;
    column-gap: 24px;
    padding: 0 28px !important;
  }

  .site-header .primary-nav {
    gap: 13px;
  }

  .site-header .primary-nav-link {
    font-size: 15px;
  }
}

/* =========================================================
   MOBILE / BURGER — 1200px and below
   ========================================================= */
@media (max-width: 1200px) {

  .site-header.mobile-open nav {
    display: block;
    position: absolute;
    top: 86px;
    left: 0;
    right: 0;
    grid-column: auto;
    grid-row: auto;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding: 18px 22px 26px;

    /* Rounded bottom corners and a touch of transparency so the
       panel doesn't read as a flat, harsh rectangle. */
    background: rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 0 0 16px 16px;
  }

  .site-header.mobile-open .primary-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .site-header.mobile-open .primary-nav > li {
    width: 100%;
  }

  .site-header.mobile-open .primary-nav > li > a,
  .site-header.mobile-open .primary-nav > li > span {
    padding: 12px 0;
    /* Slightly larger, easier-to-read menu item text. */
    font-size: 15px;
  }

  .site-header.mobile-open .dropdown {
    display: block;
    position: static;
    transform: none;
    box-shadow: none;
    padding-left: 18px;
    min-width: 0;
    border: 0;
  }
}

@media (max-width: 760px) {
  .site-header {
    min-height: 72px;
  }
  .site-header .header-inner {
    min-height: 72px;
  }
}

/* Override hardcoded h1 color to use CSS variable */
.brand-hero h1 {
  color: var(--color-text) !important;
}
</style>


<header
  class="site-header"
  role="banner"
  style="background: {{ section.settings.background_color }} !important;"
>
  <div class="container header-inner">

    <button
      aria-expanded="false"
      aria-label="Open menu"
      class="menu-icon"
      type="button"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a
      aria-label="Cameron &amp; Co home"
      class="site-logo"
      href="{{ routes.root_url }}"
      style="
        --logo-x: {{ section.settings.logo_offset_x | default: 0 }}px;
        --logo-y: {{ section.settings.logo_offset_y | default: 0 }}px;
        --logo-x-m: {{ section.settings.logo_offset_x_mobile | default: 0 }}px;
        --logo-y-m: {{ section.settings.logo_offset_y_mobile | default: 0 }}px;
      "
    >
      <img
        alt="Cameron &amp; Co Logo"
        height="486"
        src="{{ 'cameron-co-logo-cropped.webp' | asset_url }}"
        width="2000"
        style="object-fit: contain;"
      >
    </a>

    <nav
      aria-label="Main navigation"
      {% if section.settings.nav_offset_x != 0 or section.settings.nav_offset_y != 0 %}
        style="transform: translate({{ section.settings.nav_offset_x }}px, {{ section.settings.nav_offset_y }}px);"
      {% endif %}
    >
      <ul class="primary-nav">

        {% if section.settings.main_menu.links.size > 0 %}

          {% for link in section.settings.main_menu.links %}
            <li>
              <a
                href="{{ link.url }}"
                class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link{% if link.links.size > 0 %} nav-parent{% endif %}"
                {% if link.active %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
                {% if link.links.size > 0 %}
                  <svg aria-hidden="true" viewbox="0 0 8 5" xmlns="http://www.w3.org/2000/svg"><path d="M4 5L0 0h8z"></path></svg>
                {% endif %}
              </a>
              {% if link.links.size > 0 %}
                <ul aria-label="{{ link.title }} submenu" class="dropdown">
                  {% for child_link in link.links %}
                    <li>
                      <a href="{{ child_link.url }}"{% if child_link.active %} aria-current="page"{% endif %}>{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}

        {% else %}

          <li>
            <a
              href="{{ pages['sydneyoffice'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
              {% if request.page.template_suffix == "sydney-services" or request.page.template_suffix == "melbourne-services" %}
                aria-current="page"
              {% endif %}
            >
              Services
            </a>
          </li>

          <li>
            <a
              href="{{ pages['about'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
              {% if request.page.template_suffix == "about" %}
                aria-current="page"
              {% endif %}
            >
              About
            </a>
          </li>

          <li>
            <a
              href="{{ pages['testimonials'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
              {% if request.page.template_suffix == "testimonials" %}
                aria-current="page"
              {% endif %}
            >
              Testimonials
            </a>
          </li>

          <li>
            <a
              href="{{ pages['diamonds'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
            >
              Diamonds
            </a>
          </li>

          <li>
            <a
              href="{{ pages['ring-builder'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
            >
              Ring Builder
            </a>
          </li>

          <li>
            <a
              href="{{ pages['contact'].url }}"
              class="cc-font-heading-{{ section.settings.nav_font }} primary-nav-link"
              {% if request.page.template_suffix == "contact" %}
                aria-current="page"
              {% endif %}
            >
              Contact
            </a>
          </li>

        {% endif %}

      </ul>
    </nav>

    <a
      class="btn-book btn-red cc-font-body-{{ section.settings.button_font }}"
      href="{{ section.settings.button_link | default: pages['booking'].url }}"
      style="
        background: {{ section.settings.button_color }} !important;
        border-color: {{ section.settings.button_color }} !important;
        {% if section.settings.button_offset_x != 0 or section.settings.button_offset_y != 0 %}
          transform: translate(
            {{ section.settings.button_offset_x }}px,
            {{ section.settings.button_offset_y }}px
          );
        {% endif %}
      "
    >
      {{ section.settings.button_text }}
    </a>

  </div>
</header>


{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "info": "Manage links in Online Store → Navigation. Leave blank to use the default links."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Book an appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to use the Booking page"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_color",
      "label": "Nav link color",
      "default": "#D5B226"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background color",
      "default": "#8c6a2f"
    },
    {
      "type": "header",
      "content": "Colors — mobile only"
    },
    {
      "type": "color",
      "id": "nav_color_mobile",
      "label": "Nav link color (mobile menu)",
      "default": "#D5B226"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "select",
      "id": "nav_font",
      "label": "Nav link font",
      "options": [
        {
          "value": "cormorant",
          "label": "Cormorant Garamond (default)"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "garamond",
          "label": "EB Garamond"
        },
        {
          "value": "baskerville",
          "label": "Libre Baskerville"
        }
      ],
      "default": "cormorant"
    },
    {
      "type": "select",
      "id": "button_font",
      "label": "Button font",
      "options": [
        {
          "value": "glacial",
          "label": "Glacial Indifference (default)"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        }
      ],
      "default": "glacial"
    },
    {
      "type": "header",
      "content": "Logo — Desktop"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Height",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_offset_x",
      "label": "Move — horizontal",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_offset_y",
      "label": "Move — vertical",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo — Mobile"
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "label": "Height",
      "min": 16,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_offset_x_mobile",
      "label": "Move — horizontal",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_offset_y_mobile",
      "label": "Move — vertical",
      "min": -60,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Move navigation"
    },
    {
      "type": "range",
      "id": "nav_offset_x",
      "label": "Nav — horizontal",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "nav_offset_y",
      "label": "Nav — vertical",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Move button"
    },
    {
      "type": "range",
      "id": "button_offset_x",
      "label": "Button — horizontal",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_offset_y",
      "label": "Button — vertical",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
