<style>
  .home-services-shell .home-hero-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .home-services-shell .hero-left-col,
  .home-services-shell .hero-right-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .home-services-shell .hero-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    #bento-heading { color: {{ section.settings.heading_color_mobile }} !important; }
    .home-services-shell .section-eyebrow { color: {{ section.settings.eyebrow_color_mobile }} !important; }
    {% if section.settings.subheading_color_mobile != blank %}
      .home-services-shell .section-subtitle { color: {{ section.settings.subheading_color_mobile }} !important; }
    {% endif %}
  }

  @media (max-width: 768px) {
    .home-services-shell .home-hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section aria-labelledby="bento-heading" class="bento-grid-section home-services-shell" style="background:{{ section.settings.background_color }};">
  <div class="section-inner">
    <div class="section-eyebrow cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</div>
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="bento-heading" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
    <p class="section-subtitle cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.subheading_color != blank %}color:{{ section.settings.subheading_color }};{% endif %}">{{ section.settings.subheading }}</p>
    <div class="home-hero-grid">
      <div class="hero-left-col">
        {% if section.settings.link_1 != blank %}<a class="hero-card tall" href="{{ section.settings.link_1 }}">{% else %}<div class="hero-card tall">{% endif %}
          {% if section.settings.image_1 %}
            <img alt="{{ section.settings.image_1_alt | default: section.settings.label_1 | escape }}" height="500" loading="eager" src="{{ section.settings.image_1 | image_url: width: 1080 }}" width="1080">
          {% else %}
            <img alt="{{ section.settings.image_1_alt | escape }}" height="500" loading="eager" src="{{ 'cameron-co-jewellery-remodelling-workbench.webp' | asset_url }}" width="1080">
          {% endif %}
          <h3 class="hero-card-label{% if section.settings.card_heading_font != blank %} cc-font-heading-{{ section.settings.card_heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.label_1 }}</h3>
        {% if section.settings.link_1 != blank %}</a>{% else %}</div>{% endif %}
        {% if section.settings.link_2 != blank %}<a class="hero-card" href="{{ section.settings.link_2 }}">{% else %}<div class="hero-card">{% endif %}
          {% if section.settings.image_2 %}
            <img alt="{{ section.settings.image_2_alt | default: section.settings.label_2 | escape }}" height="500" loading="eager" src="{{ section.settings.image_2 | image_url: width: 1080 }}" width="1080">
          {% else %}
            <img alt="{{ section.settings.image_2_alt | escape }}" height="500" loading="eager" src="{{ 'cameron-co-repair-workshop-bench.webp' | asset_url }}" width="1080">
          {% endif %}
          <h3 class="hero-card-label{% if section.settings.card_heading_font != blank %} cc-font-heading-{{ section.settings.card_heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.label_2 }}</h3>
        {% if section.settings.link_2 != blank %}</a>{% else %}</div>{% endif %}
      </div>
      <div class="hero-right-col">
        {% if section.settings.link_3 != blank %}<a class="hero-card" href="{{ section.settings.link_3 }}">{% else %}<div class="hero-card">{% endif %}
          {% if section.settings.image_3 %}
            <img alt="{{ section.settings.image_3_alt | default: section.settings.label_3 | escape }}" height="500" loading="eager" src="{{ section.settings.image_3 | image_url: width: 1080 }}" width="1080">
          {% else %}
            <img alt="{{ section.settings.image_3_alt | escape }}" height="500" loading="eager" src="{{ 'cameron-co-appraisal-consultation.webp' | asset_url }}" width="1080">
          {% endif %}
          <h3 class="hero-card-label{% if section.settings.card_heading_font != blank %} cc-font-heading-{{ section.settings.card_heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.label_3 }}</h3>
        {% if section.settings.link_3 != blank %}</a>{% else %}</div>{% endif %}
        {% if section.settings.link_4 != blank %}<a class="hero-card tall" href="{{ section.settings.link_4 }}">{% else %}<div class="hero-card tall">{% endif %}
          {% if section.settings.image_4 %}
            <img alt="{{ section.settings.image_4_alt | default: section.settings.label_4 | escape }}" height="500" loading="eager" src="{{ section.settings.image_4 | image_url: width: 1080 }}" width="1080">
          {% else %}
            <img alt="{{ section.settings.image_4_alt | escape }}" height="500" loading="eager" src="{{ 'cameron-co-replacement-ring-selection.webp' | asset_url }}" width="1080">
          {% endif %}
          <h3 class="hero-card-label{% if section.settings.card_heading_font != blank %} cc-font-heading-{{ section.settings.card_heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.label_4 }}</h3>
        {% if section.settings.link_4 != blank %}</a>{% else %}</div>{% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we can do for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Remodelling, repairs & replacement" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Working with Australia's major insurers and loss adjusters for over 25 years — current appraisals, trusted replacement, and bespoke remaking, all under one roof." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#D5B226" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#171d29", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "color", "id": "card_heading_color", "label": "Card label color", "info": "The 4 card labels below (Jewellery Remodelling, Repairs, etc). Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "header", "content": "Colors — mobile only" },
    { "type": "color", "id": "eyebrow_color_mobile", "label": "Eyebrow color (mobile)", "default": "#D5B226" },
    { "type": "color", "id": "heading_color_mobile", "label": "Heading color (mobile)", "default": "#171d29" },
    { "type": "color", "id": "subheading_color_mobile", "label": "Subheading color (mobile)", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "card_heading_font",
      "label": "Card label font",
      "info": "The 4 card labels below. Leave unset to use the global Heading 3 font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    },
    { "type": "header", "content": "Card 1 (tall, left column)" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "label_1", "label": "Label", "default": "Jewellery Remodelling" },
    { "type": "text", "id": "image_1_alt", "label": "Image alt text", "default": "Jeweller reshaping a ring at the workbench during a remodelling project" },
    { "type": "url", "id": "link_1", "label": "Card link", "info": "Leave blank for no link" },
    { "type": "header", "content": "Card 2 (left column)" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "label_2", "label": "Label", "default": "Repairs" },
    { "type": "text", "id": "image_2_alt", "label": "Image alt text", "default": "Laser welding repair on a broken gold chain link" },
    { "type": "url", "id": "link_2", "label": "Card link", "info": "Leave blank for no link" },
    { "type": "header", "content": "Card 3 (right column)" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "label_3", "label": "Label", "default": "Appraisals" },
    { "type": "text", "id": "image_3_alt", "label": "Image alt text", "default": "Jeweller inspecting a diamond ring under magnification during an appraisal" },
    { "type": "url", "id": "link_3", "label": "Card link", "info": "Leave blank for no link" },
    { "type": "header", "content": "Card 4 (tall, right column)" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "label_4", "label": "Label", "default": "Jewellery Replacement" },
    { "type": "text", "id": "image_4_alt", "label": "Image alt text", "default": "New diamond ring boxed ready as an insurance replacement piece" },
    { "type": "url", "id": "link_4", "label": "Card link", "info": "Leave blank for no link" }
  ]
}
{% endschema %}
