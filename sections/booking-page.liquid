<div class="booking-live-page">
  <section class="brand-hero section-inner">
    <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
    <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.subheading_color != blank %}color:{{ section.settings.subheading_color }};{% endif %}">{{ section.settings.subheading }}</p>
  </section>

  <section class="app-grid section-inner" aria-label="Appointment Booking System">
    <section class="booking-card booking-picker" aria-label="Select a date and time">
      <div class="booking-picker-controls">
        <label for="booking-office">Office
          <select id="booking-office" name="office" required aria-required="true">
            <option value="melbourne">Melbourne Office</option>
            <option value="sydney">Sydney Office</option>
          </select>
        </label>

        <label for="booking-service">Appointment type
          <select id="booking-service" name="service" required aria-required="true">
            <option>Virtual Enquiry</option>
            <option>Engagement Ring Enquiry</option>
            <option>Wedding Ring Enquiry</option>
            <option>Jewellery Repairs</option>
            <option>Remake or Custom Item</option>
          </select>
        </label>
      </div>

      <p class="booking-timezone">
        <strong>Times shown in <span id="timezone-label">Sydney time</span></strong>
        <span aria-hidden="true">•</span>
        <span>Current time there: <span id="timezone-now"></span> &mdash; <button class="timezone-toggle" id="timezone-toggle" type="button">Show in your local time</button></span>
      </p>

      <div class="booking-scheduler">
        <div class="booking-calendar-panel">
          <h3>Select a Date &amp; Time</h3>
          <div class="calendar-month-row">
            <button class="calendar-nav" id="calendar-prev" type="button" aria-label="Previous month">‹</button>
            <strong id="calendar-month-label">Loading</strong>
            <button class="calendar-nav" id="calendar-next" type="button" aria-label="Next month">›</button>
          </div>
          <div class="calendar-weekdays" aria-hidden="true">
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span>Sat</span>
            <span>Sun</span>
          </div>
          <div class="calendar-days" id="calendar-days"></div>
        </div>

        <section class="result-panel" aria-label="Available appointment timeslots">
          <h3 id="selected-date-heading">Select a date</h3>
          <div aria-live="polite" class="slot-grid" id="slot-grid"></div>
        </section>
      </div>
    </section>

    <form class="booking-card booking-form booking-details-form" id="booking-form" novalidate>
      <div class="form-row-3">
        <label for="booking-name">Name *
          <input id="booking-name" autocomplete="name" name="name" required aria-required="true" type="text" placeholder="Your full name" />
        </label>

        <label for="booking-email">Email *
          <input id="booking-email" autocomplete="email" name="email" required aria-required="true" type="email" placeholder="your@email.com" />
        </label>

        <label for="booking-phone">Mobile
          <input id="booking-phone" autocomplete="tel" name="phone" placeholder="+61 400 000 000" type="tel" />
        </label>
      </div>

      <label for="booking-notes">Notes
        <textarea id="booking-notes" name="notes" placeholder="Tell us briefly what you would like to discuss."></textarea>
      </label>

      <input id="selected-slot" name="slot" required type="hidden" />

      <div class="button-row">
        <button class="btn-black-center btn-dark" type="submit">Confirm appointment</button>
        <button class="btn-black-center secondary" id="refresh-slots" type="button">Refresh available times</button>
      </div>

      <p class="status-line" id="booking-status" aria-live="polite">Select an available time from the schedule.</p>
    </form>
  </section>

  <section class="booking-card section-inner" hidden id="manage-booking" style="margin-top: 30px;">
    <h3>Manage Appointment</h3>
    <p id="manage-summary"></p>
    <div class="button-row">
      <button class="btn-black-center secondary" id="manage-reschedule" type="button">Reschedule to selected time</button>
      <button class="btn-black-center btn-dark" id="manage-cancel" type="button">Cancel appointment</button>
    </div>
  </section>
</div>

<script>
  window.CAMERON_CO_BOOKING_API = {{ section.settings.api_endpoint | json }};
</script>

<script>
(function () {
  var API_BASE = window.CAMERON_CO_BOOKING_API || "https://us-central1-cameronco-booking.cloudfunctions.net/api";
  var params = new URLSearchParams(window.location.search);
  var form = document.getElementById("booking-form");
  var office = document.getElementById("booking-office");
  var serviceSelect = document.getElementById("booking-service");
  var slotInput = document.getElementById("selected-slot");
  var slotGrid = document.getElementById("slot-grid");
  var status = document.getElementById("booking-status");
  var refreshButton = document.getElementById("refresh-slots");
  var managePanel = document.getElementById("manage-booking");
  var manageSummary = document.getElementById("manage-summary");
  var calendarDays = document.getElementById("calendar-days");
  var calendarMonthLabel = document.getElementById("calendar-month-label");
  var selectedDateHeading = document.getElementById("selected-date-heading");
  var timezoneNow = document.getElementById("timezone-now");
  var timezoneLabel = document.getElementById("timezone-label");
  var timezoneToggle = document.getElementById("timezone-toggle");
  var calendarPrev = document.getElementById("calendar-prev");
  var calendarNext = document.getElementById("calendar-next");
  var activeToken = params.get("booking");
  var availableSlots = [];
  var slotsByDate = {};
  var selectedDateKey = "";
  var calendarYear = new Date().getFullYear();
  var calendarMonth = new Date().getMonth();

  var OFFICE_TZ = "Australia/Sydney";
  var LOCAL_TZ = OFFICE_TZ;
  try {
    LOCAL_TZ = Intl.DateTimeFormat().resolvedOptions().timeZone || OFFICE_TZ;
  } catch (e) {
    LOCAL_TZ = OFFICE_TZ;
  }
  var DISPLAY_TZ = OFFICE_TZ;

  if (params.get("office") && office) office.value = params.get("office");
  if (serviceSelect) {
    if (params.get("service")) {
      serviceSelect.value = params.get("service");
    } else if (params.get("diamondId") || params.get("diamond")) {
      serviceSelect.value = "Engagement Ring Enquiry";
    }
  }

  var notesField = form ? form.querySelector("[name='notes']") : null;
  if (notesField) {
    var diamondId = params.get("diamondId") || params.get("diamond");
    var carat = params.get("carat");
    var shape = params.get("shape");
    var price = params.get("price");
    var settingName = params.get("settingName");
    var settingPrice = params.get("settingPrice");
    var settingMetal = params.get("settingMetal");

    if (settingName) {
      var detailsText = "I would like to enquire about this custom ring configuration:\n\n";
      detailsText += "Setting Selected:\n- Design: " + settingName + "\n- Metal: " + settingMetal + "\n";
      if (settingPrice) detailsText += "- Price: $" + parseFloat(settingPrice).toLocaleString() + " AUD\n\n";
      if (diamondId) {
        detailsText += "Diamond Selected:\n";
        if (carat && shape) detailsText += "- " + carat + " ct " + shape.charAt(0).toUpperCase() + shape.slice(1).toLowerCase() + "\n";
        if (price) detailsText += "- Price: $" + parseFloat(price).toLocaleString() + " AUD\n";
        detailsText += "- Sourcing ID: " + diamondId + "\n";
      }
      notesField.value = detailsText;
    } else if (diamondId) {
      var detailsText = "I am interested in viewing this diamond:\n";
      if (carat && shape) detailsText += "- " + carat + " ct " + shape.charAt(0).toUpperCase() + shape.slice(1).toLowerCase() + "\n";
      if (price) detailsText += "- Retail Price: $" + parseFloat(price).toLocaleString() + " AUD\n";
      detailsText += "- Sourcing ID: " + diamondId;
      notesField.value = detailsText;
    }
  }

  function fmt(value) {
    return new Intl.DateTimeFormat("en-AU", {
      weekday: "short",
      day: "numeric",
      month: "short",
      hour: "numeric",
      minute: "2-digit",
      timeZone: DISPLAY_TZ
    }).format(new Date(value));
  }

  function dateParts(value) {
    var parts = new Intl.DateTimeFormat("en-AU", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: DISPLAY_TZ
    }).formatToParts(new Date(value));
    return parts.reduce(function (memo, part) {
      if (part.type !== "literal") memo[part.type] = part.value;
      return memo;
    }, {});
  }

  function slotDateKey(value) {
    var parts = new Intl.DateTimeFormat("en-AU", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      timeZone: DISPLAY_TZ
    }).formatToParts(new Date(value)).reduce(function (memo, part) {
      if (part.type !== "literal") memo[part.type] = part.value;
      return memo;
    }, {});
    return parts.year + "-" + parts.month + "-" + parts.day;
  }

  function slotTime(value) {
    return new Intl.DateTimeFormat("en-AU", {
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
      timeZone: DISPLAY_TZ
    }).format(new Date(value)).replace(" ", "").toLowerCase();
  }

  function readableDateFromKey(key) {
    var slot = slotsByDate[key] && slotsByDate[key][0];
    if (slot) {
      var parts = dateParts(slot.start);
      return parts.weekday + ", " + parts.month + " " + Number(parts.day);
    }
    var bits = key.split("-");
    return new Intl.DateTimeFormat("en-AU", {
      weekday: "long",
      month: "long",
      day: "numeric"
    }).format(new Date(Number(bits[0]), Number(bits[1]) - 1, Number(bits[2])));
  }

  function updateTimezoneClock() {
    if (!timezoneNow) return;
    timezoneNow.textContent = new Intl.DateTimeFormat("en-AU", {
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
      timeZone: DISPLAY_TZ
    }).format(new Date()).replace(" ", "").toLowerCase();
  }

  // Office time is the default (unchanged behaviour for the vast majority of
  // customers, who are already in Sydney/Melbourne time). Rarely, a customer
  // browsing from elsewhere wants times in their own timezone instead --
  // this toggle switches every displayed time (calendar, slot grid, clock)
  // without changing what actually gets submitted, since slot values are
  // always the raw ISO instant regardless of how they're displayed.
  function applyTimezone(tz) {
    DISPLAY_TZ = tz;
    if (timezoneLabel) {
      timezoneLabel.textContent = tz === OFFICE_TZ ? "Sydney time" : "your local time (" + tz.replace(/_/g, " ").split("/").pop() + ")";
    }
    if (timezoneToggle) {
      timezoneToggle.textContent = tz === OFFICE_TZ ? "Show in your local time" : "Show in Sydney time";
    }
    updateTimezoneClock();
    if (availableSlots.length) setSlots(availableSlots);
  }

  function setStatus(msg) {
    if (status) status.textContent = msg;
  }

  function loadSlots() {
    setStatus("Loading available times...");
    if (slotGrid) slotGrid.innerHTML = "";
    if (slotInput) slotInput.value = "";
    fetch(API_BASE + "/api/booking/availability?office=" + encodeURIComponent(office.value))
      .then(function (res) {
        if (!res.ok) throw new Error("Availability failed");
        return res.json();
      })
      .then(function (json) {
        setSlots(json.slots || []);
        setStatus("Select an available time.");
      })
      .catch(function () {
        setSlots(sampleSlots());
        setStatus("Showing sample local times because live calendar backend is reconnecting.");
      });
  }

  function sampleSlots() {
    var slots = [];
    var day = new Date();
    day.setDate(day.getDate() + 1);
    day.setHours(10, 0, 0, 0);
    while (slots.length < 10) {
      if (day.getDay() !== 0 && day.getDay() !== 6) {
        slots.push({ start: day.toISOString(), end: new Date(day.getTime() + 45 * 60000).toISOString() });
      }
      day = new Date(day.getTime() + 90 * 60000);
    }
    return slots;
  }

  function setSlots(slots) {
    availableSlots = slots.slice().sort(function (a, b) {
      return new Date(a.start) - new Date(b.start);
    });
    slotsByDate = availableSlots.reduce(function (memo, slot) {
      var key = slotDateKey(slot.start);
      if (!memo[key]) memo[key] = [];
      memo[key].push(slot);
      return memo;
    }, {});

    var firstSlot = availableSlots[0];
    if (firstSlot) {
      selectedDateKey = slotDateKey(firstSlot.start);
      var firstKeyParts = selectedDateKey.split("-");
      calendarYear = Number(firstKeyParts[0]);
      calendarMonth = Number(firstKeyParts[1]) - 1;
    } else {
      selectedDateKey = "";
    }
    renderCalendar();
    renderSlotsForDate(selectedDateKey);
  }

  function renderCalendar() {
    if (!calendarDays || !calendarMonthLabel) return;
    calendarDays.innerHTML = "";
    calendarMonthLabel.textContent = new Intl.DateTimeFormat("en-AU", {
      month: "long",
      year: "numeric"
    }).format(new Date(calendarYear, calendarMonth, 1));

    var firstDay = new Date(calendarYear, calendarMonth, 1);
    var daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
    var leadingBlanks = (firstDay.getDay() + 6) % 7;

    for (var blank = 0; blank < leadingBlanks; blank += 1) {
      var spacer = document.createElement("span");
      spacer.className = "calendar-day-spacer";
      calendarDays.appendChild(spacer);
    }

    for (var day = 1; day <= daysInMonth; day += 1) {
      var key = calendarYear + "-" + String(calendarMonth + 1).padStart(2, "0") + "-" + String(day).padStart(2, "0");
      var button = document.createElement("button");
      button.type = "button";
      button.className = "calendar-day";
      button.textContent = day;
      button.disabled = !slotsByDate[key];
      if (key === selectedDateKey) button.classList.add("selected");
      if (slotsByDate[key]) button.classList.add("available");
      button.addEventListener("click", function (event) {
        selectedDateKey = event.currentTarget.getAttribute("data-date");
        if (slotInput) slotInput.value = "";
        renderCalendar();
        renderSlotsForDate(selectedDateKey);
      });
      button.setAttribute("data-date", key);
      calendarDays.appendChild(button);
    }
  }

  function renderSlotsForDate(dateKey) {
    if (!slotGrid) return;
    slotGrid.innerHTML = "";
    if (selectedDateHeading) {
      selectedDateHeading.textContent = dateKey ? readableDateFromKey(dateKey) : "Select a date";
    }
    var slots = slotsByDate[dateKey] || [];
    if (availableSlots.length === 0) {
      slotGrid.innerHTML = "<p>No open slots for this date range. Please select another office or contact us directly.</p>";
      return;
    }
    if (slots.length === 0) {
      slotGrid.innerHTML = "<p>Select a highlighted date to view available times.</p>";
      return;
    }
    slots.forEach(function (slot) {
      var button = document.createElement("button");
      button.type = "button";
      button.className = "slot-button";
      button.textContent = slotTime(slot.start);
      button.addEventListener("click", function () {
        slotGrid.querySelectorAll(".slot-button").forEach(function (item) {
          item.classList.remove("selected");
        });
        button.classList.add("selected");
        if (slotInput) slotInput.value = slot.start;
      });
      slotGrid.appendChild(button);
    });
  }

  function formPayload() {
    var data = new FormData(form);
    return {
      office: office ? office.value : data.get("office"),
      service: serviceSelect ? serviceSelect.value : data.get("service"),
      name: data.get("name"),
      email: data.get("email"),
      phone: data.get("phone"),
      notes: data.get("notes"),
      slot: data.get("slot"),
      diamondId: params.get("diamondId") || params.get("diamond") || ""
    };
  }

  if (calendarPrev) {
    calendarPrev.addEventListener("click", function () {
      calendarMonth -= 1;
      if (calendarMonth < 0) {
        calendarMonth = 11;
        calendarYear -= 1;
      }
      renderCalendar();
      renderSlotsForDate(selectedDateKey);
    });
  }

  if (calendarNext) {
    calendarNext.addEventListener("click", function () {
      calendarMonth += 1;
      if (calendarMonth > 11) {
        calendarMonth = 0;
        calendarYear += 1;
      }
      renderCalendar();
      renderSlotsForDate(selectedDateKey);
    });
  }

  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (!slotInput || !slotInput.value) {
        setStatus("Please select an appointment time from the grid first.");
        return;
      }
      setStatus("Creating your appointment with Google Calendar...");
      fetch(API_BASE + "/api/booking", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formPayload())
      })
        .then(function (res) {
          if (!res.ok) throw new Error("Booking failed");
          return res.json();
        })
        .then(function (json) {
          activeToken = json.manageToken;
          setStatus("Appointment confirmed! Confirmation and calendar invite queued.");
          showManage(json.booking);
        })
        .catch(function () {
          setStatus("Unable to reach the live booking server. Please call (02) 9699 2266 or email info@cameronco.com.au.");
        });
    });
  }

  function showManage(booking) {
    if (!booking || !managePanel) return;
    managePanel.hidden = false;
    if (manageSummary) {
      manageSummary.textContent = booking.service + " at " + fmt(booking.start) + " (" + booking.office.toUpperCase() + " Office).";
    }
  }

  function loadManagedBooking() {
    if (!activeToken) return;
    fetch(API_BASE + "/api/booking/" + encodeURIComponent(activeToken))
      .then(function (res) {
        if (!res.ok) throw new Error("Not found");
        return res.json();
      })
      .then(function (json) {
        showManage(json.booking);
        setStatus("Select a new time if you need to reschedule.");
      })
      .catch(function () {
        setStatus("We could not load that appointment. Please contact the office.");
      });
  }

  var manageCancelButton = document.getElementById("manage-cancel");
  var manageRescheduleButton = document.getElementById("manage-reschedule");

  if (manageCancelButton) {
    manageCancelButton.addEventListener("click", function () {
      if (!activeToken) return;
      fetch(API_BASE + "/api/booking/" + encodeURIComponent(activeToken) + "/cancel", { method: "POST" })
        .then(function (res) {
          if (!res.ok) throw new Error("Cancel failed");
          return res.json();
        })
        .then(function () {
          if (managePanel) managePanel.hidden = true;
          setStatus("Appointment cancelled. A cancellation email has been queued.");
        })
        .catch(function () {
          setStatus("Unable to cancel online. Please contact the office.");
        });
    });
  }

  if (manageRescheduleButton) {
    manageRescheduleButton.addEventListener("click", function () {
      if (!activeToken || !slotInput || !slotInput.value) {
        setStatus("Select a new time first.");
        return;
      }
      fetch(API_BASE + "/api/booking/" + encodeURIComponent(activeToken) + "/reschedule", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slot: slotInput.value })
      })
        .then(function (res) {
          if (!res.ok) throw new Error("Reschedule failed");
          return res.json();
        })
        .then(function (json) {
          showManage(json.booking);
          setStatus("Appointment rescheduled. Updated confirmation and reminders are queued.");
        })
        .catch(function () {
          setStatus("Unable to reschedule online. Please contact the office.");
        });
    });
  }

  if (office) office.addEventListener("change", loadSlots);
  if (refreshButton) refreshButton.addEventListener("click", loadSlots);
  if (timezoneToggle) {
    if (LOCAL_TZ === OFFICE_TZ) {
      // Customer's own timezone already matches the office -- nothing to offer.
      timezoneToggle.hidden = true;
    } else {
      timezoneToggle.addEventListener("click", function () {
        applyTimezone(DISPLAY_TZ === OFFICE_TZ ? LOCAL_TZ : OFFICE_TZ);
      });
    }
  }
  applyTimezone(OFFICE_TZ);
  window.setInterval(updateTimezoneClock, 60000);
  loadSlots();
  loadManagedBooking();
})();
</script>

{% schema %}
{
  "name": "Booking Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book an Appointment"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a Sydney or Melbourne appointment time. Each office syncs directly with live Google Calendar availability."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "intro_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "intro_image_fallback",
      "label": "Image fallback filename",
      "info": "Asset filename used if no image is selected above."
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Booking API URL",
      "default": "https://us-central1-cameronco-booking.cloudfunctions.net/api",
      "info": "The Firebase Functions backend URL connecting to Google Calendar for Sydney & Melbourne."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#171d29"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6b7280"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ],
      "default": "cormorant"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ],
      "default": "glacial"
    }
  ],
  "presets": [
    { "name": "Booking Page" }
  ]
}
{% endschema %}
