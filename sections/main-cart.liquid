<style>
  #cart-{{ section.id }} {
    width: 100%;
    padding: 60px 0 90px;
  }

  #cart-{{ section.id }} .cart-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 40px;
    margin: 0 0 36px;
  }

  #cart-{{ section.id }} .cart-empty {
    text-align: center;
    padding: 60px 20px;
  }

  #cart-{{ section.id }} .cart-empty p {
    font-family: 'Montserrat', Arial, sans-serif;
    color: #4a4a4a;
    margin-bottom: 24px;
  }

  #cart-{{ section.id }} .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    align-items: start;
  }

  #cart-{{ section.id }} .cart-items {
    border-top: 1px solid #e5e1da;
  }

  #cart-{{ section.id }} .cart-line-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid #e5e1da;
  }

  #cart-{{ section.id }} .cart-line-image {
    width: 96px;
    height: 96px;
    background: #f7f5f3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #cart-{{ section.id }} .cart-line-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #cart-{{ section.id }} .cart-line-title {
    font-family: 'Montserrat', Arial, sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #171d29;
    text-decoration: none;
    display: block;
    margin-bottom: 4px;
  }

  #cart-{{ section.id }} .cart-line-variant {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    color: #6b6b6b;
    margin: 0 0 2px;
  }

  #cart-{{ section.id }} .cart-line-price {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    color: #6b6b6b;
  }

  #cart-{{ section.id }} .cart-line-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  #cart-{{ section.id }} .cart-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid #d9d3c7;
  }

  #cart-{{ section.id }} .cart-qty input {
    width: 44px;
    border: 0;
    text-align: center;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 14px;
    padding: 8px 0;
  }

  #cart-{{ section.id }} .cart-qty button {
    background: transparent;
    border: 0;
    width: 32px;
    height: 36px;
    font-size: 16px;
    cursor: pointer;
    color: #171d29;
  }

  #cart-{{ section.id }} .cart-line-remove {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 12px;
    color: #6b6b6b;
    text-decoration: underline;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  #cart-{{ section.id }} .cart-line-total {
    font-family: 'Montserrat', Arial, sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #171d29;
  }

  #cart-{{ section.id }} .cart-summary {
    border: 1px solid #e5e1da;
    padding: 28px;
    background: #f7f5f3;
  }

  #cart-{{ section.id }} .cart-summary-row {
    display: flex;
    justify-content: space-between;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 15px;
    margin-bottom: 16px;
  }

  #cart-{{ section.id }} .cart-summary-row.subtotal {
    font-weight: 600;
    font-size: 18px;
    border-top: 1px solid #d9d3c7;
    padding-top: 16px;
  }

  #cart-{{ section.id }} .cart-summary-note {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 12px;
    color: #6b6b6b;
    margin: 0 0 20px;
  }

  #cart-{{ section.id }} .cart-checkout-btn {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: 0;
    cursor: pointer;
  }

  #cart-{{ section.id }} .cart-continue-link {
    display: block;
    text-align: center;
    margin-top: 16px;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    color: #171d29;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    #cart-{{ section.id }} .cart-layout {
      grid-template-columns: 1fr;
    }

    #cart-{{ section.id }} .cart-line-item {
      grid-template-columns: 72px minmax(0, 1fr);
      grid-template-areas:
        "image title"
        "image controls";
    }

    #cart-{{ section.id }} .cart-line-image {
      grid-area: image;
      width: 72px;
      height: 72px;
    }

    #cart-{{ section.id }} .cart-line-info {
      grid-area: title;
    }

    #cart-{{ section.id }} .cart-line-controls {
      grid-area: controls;
      align-items: flex-start;
      margin-top: 12px;
    }
  }
</style>

<div id="cart-{{ section.id }}" class="page-content-section">
  <div class="container">
    <h1 class="cart-title">{{ section.settings.heading | default: 'Your Cart' }}</h1>

    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>Your cart is currently empty.</p>
        <a href="{{ section.settings.empty_cart_link | default: routes.all_products_collection_url }}" class="btn-red">
          {{ section.settings.empty_cart_button_text | default: 'Continue shopping' }}
        </a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-layout">
          <div class="cart-items">
            {% for item in cart.items %}
              <div class="cart-line-item" data-cart-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="cart-line-image">
                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 200 }}"
                      alt="{{ item.image.alt | default: item.title | escape }}"
                      loading="lazy"
                      width="96"
                      height="96"
                    >
                  {% endif %}
                </a>

                <div class="cart-line-info">
                  <a href="{{ item.url }}" class="cart-line-title">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}
                    <p class="cart-line-variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="cart-line-price">{{ item.original_price | money }}</p>
                </div>

                <div class="cart-line-controls">
                  <p class="cart-line-total">{{ item.final_line_price | money }}</p>
                  <div class="cart-qty">
                    <button type="button" class="cart-qty-decrease" aria-label="Decrease quantity">&minus;</button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >
                    <button type="button" class="cart-qty-increase" aria-label="Increase quantity">&plus;</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart-line-remove">Remove</a>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary">
            <div class="cart-summary-row subtotal">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-summary-note">Taxes and shipping calculated at checkout.</p>
            <button type="submit" name="checkout" class="cart-checkout-btn btn-red">
              Checkout
            </button>
            <a href="{{ section.settings.empty_cart_link | default: routes.all_products_collection_url }}" class="cart-continue-link">
              Continue shopping
            </a>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('cart-{{ section.id }}');
    if (!root) return;

    root.addEventListener('click', function (event) {
      var decrease = event.target.closest('.cart-qty-decrease');
      var increase = event.target.closest('.cart-qty-increase');
      if (!decrease && !increase) return;

      var input = event.target.closest('.cart-qty').querySelector('input[name="updates[]"]');
      var value = parseInt(input.value, 10) || 0;

      if (decrease) value = Math.max(0, value - 1);
      if (increase) value = value + 1;

      input.value = value;
    });
  })();
</script>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Cart"
    },
    {
      "type": "url",
      "id": "empty_cart_link",
      "label": "Continue shopping link",
      "info": "Leave blank to use the default shop-all collection"
    },
    {
      "type": "text",
      "id": "empty_cart_button_text",
      "label": "Empty cart button text",
      "default": "Continue shopping"
    }
  ]
}
{% endschema %}
