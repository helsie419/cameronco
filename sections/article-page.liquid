            style="background:{{ section.settings.callout_bg_color }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >

          {% if block.settings.heading != blank %}
            <h2
              class="cc-font-heading-{{ section.settings.heading_font | default: 'cormorant' }}"
              style="{% if section.settings.section_heading_color != blank %}color:{{ section.settings.section_heading_color }};{% endif %}"
            >
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.body != blank %}
            <div
              class="cc-font-body-{{ section.settings.body_font }}"
              style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}"
            >
              {{ block.settings.body }}
            </div>
          {% endif %}

          {% if block.settings.list_heading != blank %}
            <h2
              class="cc-font-heading-{{ section.settings.heading_font | default: 'cormorant' }}"
              style="{% if section.settings.subheading_color != blank %}color:{{ section.settings.subheading_color }};{% endif %}"
            >
              {{ block.settings.list_heading }}
            </h2>
          {% endif %}

          {% if block.settings.list_items != blank %}

            {% assign list_lines = block.settings.list_items | newline_to_br | split: '<br />' %}

            {% if block.settings.list_style == 'numbered' %}

              <ol
                class="cc-font-body-{{ section.settings.body_font }}"
                style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}"
              >
                {% for item in list_lines %}
                  {% assign item_trim = item | strip %}
                  {% if item_trim != blank %}
                    <li>{{ item_trim }}</li>
                  {% endif %}
                {% endfor %}
              </ol>

            {% else %}

              <ul
                class="cc-font-body-{{ section.settings.body_font }}"
