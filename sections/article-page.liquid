<section class="live-article-hero" aria-labelledby="article-hero-title-{{ section.id }}">
  <div>
    <h1 id="article-hero-title-{{ section.id }}" class="sr-only">{{ section.settings.hero_title }}</h1>
    {% if section.settings.hero_tagline != blank %}
      <p class="tagline live-article-tagline cc-font-heading-{{ section.settings.heading_font | default: 'cormorant' }}" style="color:{{ section.settings.hero_heading_color | default: 'var(--heading-1-color)' }};">{{ section.settings.hero_tagline }}</p>
    {% endif %}
    {% if section.settings.hero_intro != blank %}
      <div class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}">{{ section.settings.hero_intro }}</div>
    {% endif %}
  </div>
  {% if section.settings.hero_image %}
    <img alt="{{ section.settings.hero_image_alt | escape }}" src="{{ section.settings.hero_image | image_url: width: 1120 }}" width="560" height="360" loading="eager">
  {% elsif section.settings.hero_image_fallback != blank %}
    <img alt="{{ section.settings.hero_image_alt | escape }}" src="{{ section.settings.hero_image_fallback | asset_url }}" width="560" height="360" loading="eager">
  {% endif %}
</section>
<div class="live-article-body">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'content_block' %}
        <section class="live-article-section{% if block.settings.callout %} article-callout{% endif %}"{% if block.settings.callout %} style="background:{{ section.settings.callout_bg_color }};"{% endif %} {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.section_heading_color != blank %}color:{{ section.settings.section_heading_color }};{% endif %}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}">{{ block.settings.body }}</div>
          {% endif %}
          {% if block.settings.list_heading != blank %}
            <h4 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.subheading_color != blank %}color:{{ section.settings.subheading_color }};{% endif %}">{{ block.settings.list_heading }}</h4>
          {% endif %}
          {% if block.settings.list_items != blank %}
            {% assign list_lines = block.settings.list_items | newline_to_br | split: '<br />' %}
            {% if block.settings.list_style == 'numbered' %}
              <ol class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}">
                {% for item in list_lines %}
                  {% assign item_trim = item | strip %}
                  {% if item_trim != blank %}<li>{{ item_trim }}</li>{% endif %}
                {% endfor %}
              </ol>
            {% else %}
              <ul class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}">
                {% for item in list_lines %}
                  {% assign item_trim = item | strip %}
                  {% if item_trim != blank %}<li>{{ item_trim }}</li>{% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          {% endif %}
          {% if block.settings.image_1_fallback == 'diamond-colour-grades-chart.webp' %}
            {% render 'diamond-colour-scale' %}
          {% elsif block.settings.image_1_fallback == 'anatomy-of-a-diamond-chart.webp' %}
            {% render 'diamond-anatomy-diagram' %}
          {% elsif block.settings.image_1 and block.settings.image_2 %}
            <div class="live-image-row">
              <img class="article-image" alt="{{ block.settings.image_1_alt | escape }}" src="{{ block.settings.image_1 | image_url: width: 900 }}" width="{{ block.settings.image_1.width }}" height="{{ block.settings.image_1.height }}">
              <img class="article-image" alt="{{ block.settings.image_2_alt | escape }}" src="{{ block.settings.image_2 | image_url: width: 900 }}" width="{{ block.settings.image_2.width }}" height="{{ block.settings.image_2.height }}">
            </div>
          {% elsif block.settings.image_1 %}
            <img class="article-image" alt="{{ block.settings.image_1_alt | escape }}" src="{{ block.settings.image_1 | image_url: width: 900 }}" width="{{ block.settings.image_1.width }}" height="{{ block.settings.image_1.height }}">
          {% elsif block.settings.image_1_fallback != blank and block.settings.image_2_fallback != blank %}
            {% assign fb1_w = 900 %}{% assign fb1_h = 600 %}
            {% case block.settings.image_1_fallback %}
              {% when 'cameron-co-jewellery-repair-components.webp' %}{% assign fb1_w = 418 %}{% assign fb1_h = 182 %}
              {% when 'cameron-co-coloured-gemstone-bezel-rings.webp' %}{% assign fb1_w = 236 %}{% assign fb1_h = 371 %}
              {% when 'cameron-co-diamond-brilliant-cut-illustration.webp' %}{% assign fb1_w = 675 %}{% assign fb1_h = 675 %}
              {% when 'silver-ring-care.webp' %}{% assign fb1_w = 1310 %}{% assign fb1_h = 540 %}
              {% when 'single-diamond-ring-box.webp' %}{% assign fb1_w = 1024 %}{% assign fb1_h = 692 %}
              {% when 'cameron-co-jewellery-collection.webp' %}{% assign fb1_w = 1080 %}{% assign fb1_h = 486 %}
              {% when 'cameron-co-loose-green-sapphire-gemstones.webp' %}{% assign fb1_w = 802 %}{% assign fb1_h = 249 %}
              {% when 'cameron-co-teal-sapphire-diamond-halo-rings.webp' %}{% assign fb1_w = 802 %}{% assign fb1_h = 394 %}
              {% when 'inspecting-diamonds-magnification.webp' %}{% assign fb1_w = 1002 %}{% assign fb1_h = 582 %}
              {% when 'diamond-colour-grades-chart.webp' %}{% assign fb1_w = 540 %}{% assign fb1_h = 654 %}
              {% when 'diamond-shapes-chart.webp' %}{% assign fb1_w = 1022 %}{% assign fb1_h = 545 %}
              {% when 'anatomy-of-a-diamond-chart.webp' %}{% assign fb1_w = 800 %}{% assign fb1_h = 798 %}
              {% when 'cameron-co-jewellery-remodelling-workbench.webp' %}{% assign fb1_w = 1408 %}{% assign fb1_h = 768 %}
              {% when 'cameron-co-repair-workshop-bench.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-replacement-ring-selection.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-appraisal-consultation.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-jewellery-repair-laser-welding.webp' %}{% assign fb1_w = 1537 %}{% assign fb1_h = 1023 %}
            {% endcase %}
            {% assign fb2_w = 900 %}{% assign fb2_h = 600 %}
            {% case block.settings.image_2_fallback %}
              {% when 'cameron-co-jewellery-repair-components.webp' %}{% assign fb2_w = 418 %}{% assign fb2_h = 182 %}
              {% when 'cameron-co-coloured-gemstone-bezel-rings.webp' %}{% assign fb2_w = 236 %}{% assign fb2_h = 371 %}
              {% when 'cameron-co-diamond-brilliant-cut-illustration.webp' %}{% assign fb2_w = 675 %}{% assign fb2_h = 675 %}
              {% when 'silver-ring-care.webp' %}{% assign fb2_w = 1310 %}{% assign fb2_h = 540 %}
              {% when 'single-diamond-ring-box.webp' %}{% assign fb2_w = 1024 %}{% assign fb2_h = 692 %}
              {% when 'cameron-co-jewellery-collection.webp' %}{% assign fb2_w = 1080 %}{% assign fb2_h = 486 %}
              {% when 'cameron-co-loose-green-sapphire-gemstones.webp' %}{% assign fb2_w = 802 %}{% assign fb2_h = 249 %}
              {% when 'cameron-co-teal-sapphire-diamond-halo-rings.webp' %}{% assign fb2_w = 802 %}{% assign fb2_h = 394 %}
              {% when 'inspecting-diamonds-magnification.webp' %}{% assign fb2_w = 1002 %}{% assign fb2_h = 582 %}
              {% when 'diamond-colour-grades-chart.webp' %}{% assign fb2_w = 540 %}{% assign fb2_h = 654 %}
              {% when 'diamond-shapes-chart.webp' %}{% assign fb2_w = 1022 %}{% assign fb2_h = 545 %}
              {% when 'anatomy-of-a-diamond-chart.webp' %}{% assign fb2_w = 800 %}{% assign fb2_h = 798 %}
              {% when 'cameron-co-jewellery-remodelling-workbench.webp' %}{% assign fb2_w = 1408 %}{% assign fb2_h = 768 %}
              {% when 'cameron-co-repair-workshop-bench.webp' %}{% assign fb2_w = 1200 %}{% assign fb2_h = 800 %}
              {% when 'cameron-co-replacement-ring-selection.webp' %}{% assign fb2_w = 1200 %}{% assign fb2_h = 800 %}
              {% when 'cameron-co-appraisal-consultation.webp' %}{% assign fb2_w = 1200 %}{% assign fb2_h = 800 %}
              {% when 'cameron-co-jewellery-repair-laser-welding.webp' %}{% assign fb2_w = 1537 %}{% assign fb2_h = 1023 %}
            {% endcase %}
            <div class="live-image-row">
              <img class="article-image" alt="{{ block.settings.image_1_alt | escape }}" src="{{ block.settings.image_1_fallback | asset_url }}" width="{{ fb1_w }}" height="{{ fb1_h }}">
              <img class="article-image" alt="{{ block.settings.image_2_alt | escape }}" src="{{ block.settings.image_2_fallback | asset_url }}" width="{{ fb2_w }}" height="{{ fb2_h }}">
            </div>
          {% elsif block.settings.image_1_fallback != blank %}
            {% assign fb1_w = 900 %}{% assign fb1_h = 600 %}
            {% case block.settings.image_1_fallback %}
              {% when 'cameron-co-jewellery-repair-components.webp' %}{% assign fb1_w = 418 %}{% assign fb1_h = 182 %}
              {% when 'cameron-co-coloured-gemstone-bezel-rings.webp' %}{% assign fb1_w = 236 %}{% assign fb1_h = 371 %}
              {% when 'cameron-co-diamond-brilliant-cut-illustration.webp' %}{% assign fb1_w = 675 %}{% assign fb1_h = 675 %}
              {% when 'silver-ring-care.webp' %}{% assign fb1_w = 1310 %}{% assign fb1_h = 540 %}
              {% when 'single-diamond-ring-box.webp' %}{% assign fb1_w = 1024 %}{% assign fb1_h = 692 %}
              {% when 'cameron-co-jewellery-collection.webp' %}{% assign fb1_w = 1080 %}{% assign fb1_h = 486 %}
              {% when 'cameron-co-loose-green-sapphire-gemstones.webp' %}{% assign fb1_w = 802 %}{% assign fb1_h = 249 %}
              {% when 'cameron-co-teal-sapphire-diamond-halo-rings.webp' %}{% assign fb1_w = 802 %}{% assign fb1_h = 394 %}
              {% when 'inspecting-diamonds-magnification.webp' %}{% assign fb1_w = 1002 %}{% assign fb1_h = 582 %}
              {% when 'diamond-colour-grades-chart.webp' %}{% assign fb1_w = 540 %}{% assign fb1_h = 654 %}
              {% when 'diamond-shapes-chart.webp' %}{% assign fb1_w = 1022 %}{% assign fb1_h = 545 %}
              {% when 'anatomy-of-a-diamond-chart.webp' %}{% assign fb1_w = 800 %}{% assign fb1_h = 798 %}
              {% when 'cameron-co-jewellery-remodelling-workbench.webp' %}{% assign fb1_w = 1408 %}{% assign fb1_h = 768 %}
              {% when 'cameron-co-repair-workshop-bench.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-replacement-ring-selection.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-appraisal-consultation.webp' %}{% assign fb1_w = 1200 %}{% assign fb1_h = 800 %}
              {% when 'cameron-co-jewellery-repair-laser-welding.webp' %}{% assign fb1_w = 1537 %}{% assign fb1_h = 1023 %}
            {% endcase %}
            <img class="article-image" alt="{{ block.settings.image_1_alt | escape }}" src="{{ block.settings.image_1_fallback | asset_url }}" width="{{ fb1_w }}" height="{{ fb1_h }}">
          {% endif %}
          {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
            <a class="btn-black-center btn-dark cc-font-body-{{ section.settings.body_font }}" href="{{ block.settings.cta_link }}" style="background:{{ section.settings.button_bg_color }} !important;border-color:{{ section.settings.button_bg_color }} !important;color:{{ section.settings.button_text_color }} !important;">{{ block.settings.cta_text }}</a>
          {% endif %}
        </section>
    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Article page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "Essential Jewellery Care Tips" },
    { "type": "text", "id": "hero_tagline", "label": "Tagline", "default": "Keeping your precious pieces sparkling" },
    { "type": "richtext", "id": "hero_intro", "label": "Intro copy", "default": "<p>Jewellery is more than just an accessory; it is an investment in beauty and often holds sentimental value. Proper care is essential to maintain its beauty and value over time.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Leave blank to use the default image" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "Jewellery care and cleaning components" },
    { "type": "text", "id": "hero_image_fallback", "label": "Hero image fallback filename", "info": "Asset filename used if no hero image is selected above. Do not change unless you know the exact filename in the Files/assets library.", "default": "cameron-co-jewellery-repair-components.webp" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "hero_heading_color", "label": "Hero title color", "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)." },
    { "type": "color", "id": "hero_tagline_color", "label": "Hero tagline color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "color", "id": "section_heading_color", "label": "Section heading color", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "subheading_color", "label": "Subheading / list lead-in color", "info": "Leave blank to use the global Heading 4 color (Theme settings → Headings)." },
    { "type": "color", "id": "body_text_color", "label": "Body text color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "color", "id": "callout_bg_color", "label": "Callout background color", "default": "#f7f5f3" },
    { "type": "color", "id": "button_bg_color", "label": "Button background color", "default": "#171d29" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content block",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body copy", "info": "Use Bold formatting for inline sub-labels (e.g. \"Gold Jewellery:\")." },
        { "type": "checkbox", "id": "callout", "label": "Shaded callout background", "default": false },
        { "type": "header", "content": "List (optional)" },
        { "type": "text", "id": "list_heading", "label": "List lead-in heading" },
        { "type": "textarea", "id": "list_items", "label": "List items", "info": "One item per line. Basic HTML tags such as <strong>Label:</strong> are supported for bold lead-ins." },
        {
          "type": "select",
          "id": "list_style",
          "label": "List style",
          "options": [
            { "value": "bullet", "label": "Bulleted" },
            { "value": "numbered", "label": "Numbered" }
          ],
          "default": "bullet"
        },
        { "type": "header", "content": "Image 1" },
        { "type": "image_picker", "id": "image_1", "label": "Image" },
        { "type": "text", "id": "image_1_alt", "label": "Image alt text" },
        { "type": "text", "id": "image_1_fallback", "label": "Image 1 fallback filename", "info": "Asset filename used if no image is selected above." },
        { "type": "header", "content": "Image 2 (optional, side-by-side)" },
        { "type": "image_picker", "id": "image_2", "label": "Image" },
        { "type": "text", "id": "image_2_alt", "label": "Image alt text" },
        { "type": "text", "id": "image_2_fallback", "label": "Image 2 fallback filename", "info": "Asset filename used if no image is selected above." },
        { "type": "header", "content": "Call to action (optional)" },
        { "type": "text", "id": "cta_text", "label": "Button text" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ]
}
{% endschema %}

