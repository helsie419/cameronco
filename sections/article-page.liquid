            <a
              class="btn-black-center btn-dark cc-font-body-{{ section.settings.body_font }}"
              href="{{ block.settings.cta_link }}"
              style="
                background:{{ section.settings.button_bg_color }} !important;
                border-color:{{ section.settings.button_bg_color }} !important;
                color:{{ section.settings.button_text_color }} !important;
              "
            >
              {{ block.settings.cta_text }}
            </a>

          {% endif %}

        </section>

    {% endcase %}

  {% endfor %}

</div>

