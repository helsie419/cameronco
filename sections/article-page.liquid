<style>
  /* ==================================================
     ARTICLE PAGE LAYOUT FIXES
     ================================================== */

  .live-article-hero,
  .live-article-body,
  .live-article-section,
  .live-article-section h1,
  .live-article-section h2,
  .live-article-section h3,
  .live-article-section h4,
  .live-article-section p,
  .live-article-section ul,
  .live-article-section ol,
  .live-article-section li,
  .live-article-tagline {
    text-align: left !important;
  }

  .live-article-hero {
    align-items: start;
  }

  .live-article-section .article-image {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    margin: 24px 0 0 0 !important;
    object-fit: contain;
  }

  .live-image-row {
    display: flex;
    justify-content: flex-start !important;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .live-image-row .article-image {
    flex: 0 1 360px;
    max-width: 360px;
    margin: 0 !important;
  }

  .article-image-diagram {
    max-width: 520px !important;
  }

  @media (max-width: 749px) {
    .live-article-section .article-image,
    .live-image-row .article-image {
      max-width: 300px;
    }

    .live-image-row {
      display: block;
    }

    .live-image-row .article-image + .article-image {
      margin-top: 16px !important;
    }

    .article-image-diagram {
      max-width: 100% !important;
    }
  }
</style>

{% assign hero_image_fallback = section.settings.hero_image_fallback %}
{% assign hero_image_alt = section.settings.hero_image_alt %}

{% if hero_image_fallback == 'inspecting-diamonds-magnification.webp' %}
  {% assign hero_image_fallback = 'cameron-co-square-diamond-pendant.png' %}
  {% assign hero_image_alt = 'Square diamond pendant on satin introducing diamond education' %}
{% endif %}

<section class="live-article-hero" aria-labelledby="article-hero-title-{{ section.id }}">
  <div>
    <h1 id="article-hero-title-{{ section.id }}" class="sr-only">
      {{ section.settings.hero_title }}
    </h1>

    {% if section.settings.hero_tagline != blank %}
      <p
        class="tagline live-article-tagline cc-font-heading-{{ section.settings.heading_font | default: 'cormorant' }}"
        style="color:{{ section.settings.hero_heading_color | default: 'var(--heading-1-color)' }};"
      >
        {{ section.settings.hero_tagline }}
      </p>
    {% endif %}

    {% if section.settings.hero_intro != blank %}
      <div
        class="cc-font-body-{{ section.settings.body_font }}"
        style="{% if section.settings.body_text_color != blank %}color:{{ section.settings.body_text_color }};{% endif %}"
      >
        {{ section.settings.hero_intro }}
      </div>
    {% endif %}
  </div>

  {% if section.settings.hero_image %}
    <img
      onerror="this.remove();"
      alt="{{ hero_image_alt | escape }}"
      src="{{ section.settings.hero_image | image_url: width: 1120 }}"
      width="560"
      height="360"
      loading="eager"
    >
  {% elsif hero_image_fallback != blank %}
    <img
      onerror="this.remove();"
      alt="{{ hero_image_alt | escape }}"
      src="{{ hero_image_fallback | asset_url }}"
      width="560"
      height="360"
      loading="eager"
    >
  {% endif %}
</section>

