<style>
  .home-gallery-shell .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 8px;
  }

  .home-gallery-shell .gallery-item {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
  }

  .home-gallery-shell .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .home-gallery-shell .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .home-gallery-shell .gallery-grid {
      gap: 12px;
    }
  }
</style>

<section aria-labelledby="gallery-heading-{{ section.id }}" class="home-gallery-shell section-inner" style="background:{{ section.settings.background_color }};">
  <div class="section-eyebrow cc-font-body-{{ section.settings.body_font }}" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</div>
  <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="gallery-heading-{{ section.id }}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
  {% if section.settings.subheading != blank %}
    <p class="section-subtitle cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.subheading_color != blank %}color:{{ section.settings.subheading_color }};{% endif %}">{{ section.settings.subheading }}</p>
  {% endif %}
  <div class="gallery-grid">
    {% for block in section.blocks %}
      {% if block.type == 'gallery_item' %}
        <figure class="gallery-item" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img alt="{{ block.settings.image_alt | escape }}" height="500" loading="lazy" src="{{ block.settings.image | image_url: width: 600 }}" width="500">
          {% elsif block.settings.image_fallback != blank %}
            <img alt="{{ block.settings.image_alt | escape }}" height="500" loading="lazy" src="{{ block.settings.image_fallback | asset_url }}" width="500">
          {% endif %}
        </figure>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Homepage gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Craftsmanship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Glimpse of Our Jewellery" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#d5b226" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Alt text" },
        { "type": "text", "id": "image_fallback", "label": "Fallback filename", "info": "Asset filename used if no image is selected above." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Homepage gallery",
      "blocks": [
        { "type": "gallery_item", "settings": { "image_alt": "Pink sapphire pear-cut halo bridal ring set in yellow gold", "image_fallback": "cameron-co-pink-sapphire-pear-bridal-set.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Blue sapphire emerald-cut wide band ring in yellow gold", "image_fallback": "cameron-co-blue-sapphire-wide-band-ring.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Amethyst emerald-cut solitaire ring in yellow gold", "image_fallback": "cameron-co-amethyst-emerald-cut-ring.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Tanzanite and diamond three-stone ring in white gold", "image_fallback": "cameron-co-tanzanite-three-stone-ring.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Opal inlay men's wedding band in yellow gold", "image_fallback": "cameron-co-opal-inlay-mens-wedding-band.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Art Deco style filigree band ring in white gold", "image_fallback": "cameron-co-art-deco-filigree-band-ring.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Heart-cut diamond solitaire ring in yellow gold", "image_fallback": "cameron-co-heart-cut-diamond-solitaire-ring.webp" } },
        { "type": "gallery_item", "settings": { "image_alt": "Rectangular diamond cluster statement ring in white gold", "image_fallback": "cameron-co-rectangular-diamond-cluster-ring.webp" } }
      ]
    }
  ]
}
{% endschema %}
