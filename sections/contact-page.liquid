<section aria-labelledby="contact-heading-{{ section.id }}" style="background:{{ section.settings.background_color }};">
  <div class="section-inner">
    <h1 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="contact-heading-{{ section.id }}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h1>
    <p class="cc-moved-style-004 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.intro_color != blank %}color:{{ section.settings.intro_color }};{% endif %}">{{ section.settings.intro_text }}</p>
    <div class="offices-row">
      <div class="office-card">
        <iframe allowfullscreen class="office-map" src="{{ section.settings.office1_map_embed_url }}" title="{{ section.settings.office1_name }} location map"{% if section.settings.office1_map_aria_label != blank %} aria-label="{{ section.settings.office1_map_aria_label }}"{% endif %}></iframe>
        <h3 class="cc-moved-style-005{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.office_name_color != blank %}color:{{ section.settings.office_name_color }};{% endif %}">{{ section.settings.office1_name }}</h3>
        <div class="office-details cc-font-body-{{ section.settings.body_font }}">
          <p>{{ section.settings.office1_address_line1 }}</p>
          <p>{{ section.settings.office1_address_line2 }}</p>
          <a href="mailto:{{ section.settings.office1_email }}">{{ section.settings.office1_email }}</a>
          <p>Phone: <a href="tel:{{ section.settings.office1_phone_href }}">{{ section.settings.office1_phone_display }}</a></p>
        </div>
        <div class="office-buttons">
          <a class="btn-office btn-outline-red" href="mailto:{{ section.settings.office1_email }}">{{ section.settings.contact_button_text }}</a>
          <a class="btn-office btn-outline-red" href="{{ section.settings.office1_book_link | default: pages['sydneyoffice'].url }}">{{ section.settings.book_button_text }}</a>
        </div>
      </div>
      <div class="office-card">
        <iframe allowfullscreen class="office-map" src="{{ section.settings.office2_map_embed_url }}" title="{{ section.settings.office2_name }} location map"{% if section.settings.office2_map_aria_label != blank %} aria-label="{{ section.settings.office2_map_aria_label }}"{% endif %}></iframe>
        <h3 class="cc-moved-style-005{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.office_name_color != blank %}color:{{ section.settings.office_name_color }};{% endif %}">{{ section.settings.office2_name }}</h3>
        <div class="office-details cc-font-body-{{ section.settings.body_font }}">
          <p>{{ section.settings.office2_address_line1 }}</p>
          <p>{{ section.settings.office2_address_line2 }}</p>
          <a href="mailto:{{ section.settings.office2_email }}">{{ section.settings.office2_email }}</a>
          <p>Phone: <a href="tel:{{ section.settings.office2_phone_href }}">{{ section.settings.office2_phone_display }}</a></p>
        </div>
        <div class="office-buttons">
          <a class="btn-office btn-outline-red" href="mailto:{{ section.settings.office2_email }}">{{ section.settings.contact_button_text }}</a>
          <a class="btn-office btn-outline-red" href="{{ section.settings.office2_book_link | default: pages['melbourneoffice'].url }}">{{ section.settings.book_button_text }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": {{ section.settings.heading | json }},
  "description": {{ section.settings.intro_text | strip_html | strip | json }},
  "url": {{ canonical_url | json }},
  "mainEntity": [
    {
      "@type": "JewelryStore",
      "name": {{ section.settings.office1_name | append: ' - Cameron & Co' | json }},
      "telephone": {{ section.settings.office1_phone_href | json }},
      "email": {{ section.settings.office1_email | json }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ section.settings.office1_address_line1 | append: ', ' | append: section.settings.office1_address_line2 | json }},
        "addressCountry": "AU"
      }
    },
    {
      "@type": "JewelryStore",
      "name": {{ section.settings.office2_name | append: ' - Cameron & Co' | json }},
      "telephone": {{ section.settings.office2_phone_href | json }},
      "email": {{ section.settings.office2_email | json }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ section.settings.office2_address_line1 | append: ', ' | append: section.settings.office2_address_line2 | json }},
        "addressCountry": "AU"
      }
    }
  ]
}
</script>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "intro_text", "label": "Intro text", "default": "Reach out to our Sydney or Melbourne office — all appointments are obligation free." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "contact_button_text", "label": "\"Contact us\" button text", "default": "Contact Us" },
    { "type": "text", "id": "book_button_text", "label": "\"Book services\" button text", "default": "Book Services" },
    { "type": "header", "content": "Sydney office" },
    { "type": "text", "id": "office1_name", "label": "Office name", "default": "Sydney Office" },
    { "type": "text", "id": "office1_address_line1", "label": "Address line 1", "default": "Suite 2, Level 7, 37 York Street" },
    { "type": "text", "id": "office1_address_line2", "label": "Address line 2", "default": "Sydney NSW 2000" },
    { "type": "text", "id": "office1_email", "label": "Email", "default": "nswsales@cameronco.com.au" },
    { "type": "text", "id": "office1_phone_display", "label": "Phone (displayed)", "default": "(02) 9699 2266" },
    { "type": "text", "id": "office1_phone_href", "label": "Phone (tel: link)", "default": "+61296992266" },
    { "type": "url", "id": "office1_book_link", "label": "\"Book services\" link", "info": "Leave blank to use the Sydney Services page" },
    { "type": "text", "id": "office1_map_embed_url", "label": "Map embed URL", "info": "Google Maps embed src, e.g. https://maps.google.com/maps?q=...&output=embed", "default": "https://maps.google.com/maps?q=Suite+2+Level+7+37+York+Street+Sydney+NSW+2000&output=embed" },
    { "type": "text", "id": "office1_map_aria_label", "label": "Map aria-label (accessibility)", "default": "Map showing Sydney Office at 37 York Street" },
    { "type": "header", "content": "Melbourne office" },
    { "type": "text", "id": "office2_name", "label": "Office name", "default": "Melbourne Office" },
    { "type": "text", "id": "office2_address_line1", "label": "Address line 1", "default": "73-75 Canterbury Road" },
    { "type": "text", "id": "office2_address_line2", "label": "Address line 2", "default": "Canterbury VIC 3126" },
    { "type": "text", "id": "office2_email", "label": "Email", "default": "vicsales@cameronco.com.au" },
    { "type": "text", "id": "office2_phone_display", "label": "Phone (displayed)", "default": "(03) 9836 9922" },
    { "type": "text", "id": "office2_phone_href", "label": "Phone (tel: link)", "default": "+61398369922" },
    { "type": "url", "id": "office2_book_link", "label": "\"Book services\" link", "info": "Leave blank to use the Melbourne Services page" },
    { "type": "text", "id": "office2_map_embed_url", "label": "Map embed URL", "info": "Google Maps embed src, e.g. https://maps.google.com/maps?q=...&output=embed", "default": "https://maps.google.com/maps?q=73-75+Canterbury+Road+Canterbury+VIC+3126&output=embed" },
    { "type": "text", "id": "office2_map_aria_label", "label": "Map aria-label (accessibility)", "default": "Map showing Melbourne Office at 73-75 Canterbury Road" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)." },
    { "type": "color", "id": "intro_color", "label": "Intro text color", "default": "#6b7280", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "color", "id": "office_name_color", "label": "Office name color", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "presets": [
    { "name": "Contact page" }
  ]
}
{% endschema %}
