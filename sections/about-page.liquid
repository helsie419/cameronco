<div class="about-live-page">
<section aria-labelledby="about-expertise-title-{{ section.id }}" class="about-expertise section-inner">
  <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="about-expertise-title-{{ section.id }}" style="{% if section.settings.expertise_heading_color != blank %}color:{{ section.settings.expertise_heading_color }};{% endif %}">{{ section.settings.expertise_heading }}</h2>
  <figure class="about-storefront-frame">
    {% if section.settings.storefront_image %}
      <img alt="{{ section.settings.storefront_image_alt | escape }}" height="1140" loading="eager" src="{{ section.settings.storefront_image | image_url: width: 1803 }}" width="1803">
    {% else %}
      <img alt="{{ section.settings.storefront_image_alt | escape }}" height="1140" loading="eager" src="{{ 'cameron-co-brand-book-showroom.webp' | asset_url }}" width="1803">
    {% endif %}
  </figure>
</section>
<section aria-labelledby="about-page-title-{{ section.id }}" class="about-title-band section-inner">
  <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" id="about-page-title-{{ section.id }}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
</section>
<section aria-labelledby="about-intro-title-{{ section.id }}" class="about-intro section-inner">
  <div class="about-intro-copy cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.intro_text_color != blank %}color:{{ section.settings.intro_text_color }};{% endif %}">
    <p class="cc-preserve-line-breaks" id="about-intro-title-{{ section.id }}">{{ section.settings.intro_paragraph_1 }}</p>
    <p class="cc-preserve-line-breaks">{{ section.settings.intro_paragraph_2 }}</p>
    <p class="cc-preserve-line-breaks">{{ section.settings.intro_paragraph_3 }}</p>
    <p class="cc-preserve-line-breaks">{{ section.settings.intro_paragraph_4 }}</p>
    <p class="cc-preserve-line-breaks">{{ section.settings.intro_paragraph_5 }}</p>
  </div>
</section>
<section aria-label="Mission, vision and core values" class="about-mission-grid section-inner">
  <article class="about-text-card about-mission">
    <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.mission_heading }}</h2>
    <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.card_text_color != blank %}color:{{ section.settings.card_text_color }};{% endif %}">{{ section.settings.mission_text }}</p>
  </article>
  <article class="about-text-card about-vision">
    <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.vision_heading }}</h2>
    <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.card_text_color != blank %}color:{{ section.settings.card_text_color }};{% endif %}">{{ section.settings.vision_text }}</p>
  </article>
  <article class="about-values-card">
    <h2 class="{% if section.settings.heading_font != blank %}cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.card_heading_color != blank %}color:{{ section.settings.card_heading_color }};{% endif %}">{{ section.settings.values_heading }}</h2>
    <p class="cc-preserve-line-breaks cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.card_text_color != blank %}color:{{ section.settings.card_text_color }};{% endif %}"><strong>{{ section.settings.values_intro_label }}:</strong> {{ section.settings.values_intro_text }}</p>
    <ul class="cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.card_text_color != blank %}color:{{ section.settings.card_text_color }};{% endif %}">
      {% for block in section.blocks %}
        {% if block.type == 'value_item' %}
          <li class="cc-preserve-line-breaks" {{ block.shopify_attributes }}><strong>{{ block.settings.label }}:</strong> {{ block.settings.text }}</li>
        {% endif %}
      {% endfor %}
    </ul>
  </article>
</section>
<section aria-label="Our craftsmanship" class="about-image-row section-inner">
  <figure class="about-image-row-item">
    <img alt="Pink tourmaline round halo ring in rose gold" height="500" loading="lazy" src="{{ 'cameron-co-pink-tourmaline-halo-ring.webp' | asset_url }}" width="500">
  </figure>
  <figure class="about-image-row-item">
    <img alt="Aquamarine vintage-style halo ring in white gold" height="500" loading="lazy" src="{{ 'cameron-co-aquamarine-vintage-halo-ring.webp' | asset_url }}" width="500">
  </figure>
  <figure class="about-image-row-item">
    <img alt="Princess-cut diamond bridal ring set in rose gold" height="500" loading="lazy" src="{{ 'cameron-co-princess-diamond-bridal-set-rose-gold.webp' | asset_url }}" width="500">
  </figure>
  <figure class="about-image-row-item">
    <img alt="Black sapphire bezel ring in yellow gold" height="500" loading="lazy" src="{{ 'cameron-co-black-sapphire-bezel-ring.webp' | asset_url }}" width="500">
  </figure>
</section>
</div>

{% schema %}
{
  "name": "About page",
  "settings": [
    { "type": "header", "content": "Expertise section" },
    { "type": "text", "id": "expertise_heading", "label": "Heading", "default": "Expertise. Excellence. Experience." },
    { "type": "image_picker", "id": "storefront_image", "label": "Storefront image" },
    { "type": "text", "id": "storefront_image_alt", "label": "Storefront image alt text", "default": "Cameron & Co head office in Melbourne" },
    { "type": "header", "content": "Page heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Us" },
    { "type": "header", "content": "Intro copy" },
    { "type": "textarea", "id": "intro_paragraph_1", "label": "Paragraph 1", "default": "Cameron & Co is a trusted family-owned business with over 25 years of expertise in jewellery and watches." },
    { "type": "textarea", "id": "intro_paragraph_2", "label": "Paragraph 2", "default": "We pride ourselves in our Quality craftsmanship, our team works with our clients to design items to your requirements in sterling silver, yellow gold, rose gold, white gold, platinum and set with diamonds, precious gems and semi-precious gems. We deal with reputable diamond and precious gem suppliers and trusted certifiers, such as GIA." },
    { "type": "textarea", "id": "intro_paragraph_3", "label": "Paragraph 3", "default": "Since our inception, we have and continue to work with major insurance companies to support their clients with their jewellery and watch claims. Our showrooms, and commitment to personalised service distinguish us as reliable insurance specialists and craftsmen. Cameron & Co are renowned for our deep industry knowledge, we are trusted partners with major insurance companies, providing current appraisals, replacement pieces, and exceptional service." },
    { "type": "textarea", "id": "intro_paragraph_4", "label": "Paragraph 4", "default": "At Cameron & Co, our ethos is rooted in a family legacy of craftsmanship, reliability, and genuine care. We pride ourselves on being a beacon of trust and expertise, fostering enduring relationships with clients and insurance partners alike." },
    { "type": "textarea", "id": "intro_paragraph_5", "label": "Paragraph 5", "default": "We believe in the artistry of jewellery making, combining traditional craftsmanship with modern design to create timeless pieces." },
    { "type": "header", "content": "Mission" },
    { "type": "text", "id": "mission_heading", "label": "Heading", "default": "Mission" },
    { "type": "textarea", "id": "mission_text", "label": "Text", "default": "Cameron & Co expertly guide and supports clients through the intricate journey of jewellery and watch insurance claims, offering unparalleled craftsmanship, personalised service, and a trusted partnership built on over 25 years of family-owned excellence." },
    { "type": "header", "content": "Vision" },
    { "type": "text", "id": "vision_heading", "label": "Heading", "default": "Vision" },
    { "type": "textarea", "id": "vision_text", "label": "Text", "default": "Cameron & Co aspire to be the foremost authority in jewellery insurance claims, recognised for our unwavering commitment to integrity, precision, and seamless restoration of cherished pieces, setting the standard for industry expertise and customer satisfaction." },
    { "type": "header", "content": "Core values" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "Core Values" },
    { "type": "text", "id": "values_intro_label", "label": "Intro label (bold)", "default": "Expertise" },
    { "type": "textarea", "id": "values_intro_text", "label": "Intro text", "default": "We leverage over 25 years of experience to provide unmatched knowledge in the appraisal, replacement, and repair of jewellery and watches." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "expertise_heading_color", "label": "Expertise heading color", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "color", "id": "heading_color", "label": "Page heading (H1) color", "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)." },
    { "type": "color", "id": "intro_text_color", "label": "Intro copy text color", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "color", "id": "card_heading_color", "label": "Card heading color", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#19202c", "info": "Leave blank to use the global Paragraph color (Theme settings → Paragraph)." },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Core value",
      "settings": [
        { "type": "text", "id": "label", "label": "Label (bold)" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "About page",
      "blocks": [
        { "type": "value_item", "settings": { "label": "Integrity", "text": "We operate with transparency, honesty, and respect in every interaction, ensuring the highest ethical standards are upheld." } },
        { "type": "value_item", "settings": { "label": "Craftsmanship", "text": "Our on-site workshops, manned by skilled artisans, produce quality handcrafted and CAD-designed items tailored to our clients' unique preferences." } },
        { "type": "value_item", "settings": { "label": "Personalised Service", "text": "We offer a personalised, client-focused approach, understanding the emotional significance of each piece and navigating the insurance claims process with care." } },
        { "type": "value_item", "settings": { "label": "Industry Leadership", "text": "We strive to be at the forefront of the industry, continuously updating our knowledge and collaborating with reputable suppliers and certifiers such as GIA." } }
      ]
    }
  ]
}
{% endschema %}
