<style>
@media (max-width: 900px) {
  .logos-strip .brands-title { color: {{ section.settings.heading_color_mobile }} !important; }
}
</style>
<section aria-label="Partner brands" class="logos-strip" style="background-color:{{ section.settings.background_color }};">
  <h2 class="section-title brands-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
  <div class="logos-track-wrap">
    <div aria-hidden="true" class="logos-track">
      {% if section.settings.logo_1 %}{% assign logo_1_src = section.settings.logo_1 | image_url: width: 300 %}{% else %}{% assign logo_1_src = 'ikecho-pearls-jewellery-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_2 %}{% assign logo_2_src = section.settings.logo_2 | image_url: width: 300 %}{% else %}{% assign logo_2_src = 'ice-watch-brand-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_3 %}{% assign logo_3_src = section.settings.logo_3 | image_url: width: 300 %}{% else %}{% assign logo_3_src = 'citizen-watches-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_4 %}{% assign logo_4_src = section.settings.logo_4 | image_url: width: 300 %}{% else %}{% assign logo_4_src = 'classique-jewellery-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_5 %}{% assign logo_5_src = section.settings.logo_5 | image_url: width: 300 %}{% else %}{% assign logo_5_src = 'burberry-brand-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_6 %}{% assign logo_6_src = section.settings.logo_6 | image_url: width: 300 %}{% else %}{% assign logo_6_src = 'fossil-brand-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_7 %}{% assign logo_7_src = section.settings.logo_7 | image_url: width: 300 %}{% else %}{% assign logo_7_src = 'dora-international-jewellery-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_8 %}{% assign logo_8_src = section.settings.logo_8 | image_url: width: 300 %}{% else %}{% assign logo_8_src = 'georgini-jewellery-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_9 %}{% assign logo_9_src = section.settings.logo_9 | image_url: width: 300 %}{% else %}{% assign logo_9_src = 'thomas-sabo-brand-logo.webp' | asset_url %}{% endif %}
      {% if section.settings.logo_10 %}{% assign logo_10_src = section.settings.logo_10 | image_url: width: 300 %}{% else %}{% assign logo_10_src = 'peter-w-beck-jewellery-logo.webp' | asset_url %}{% endif %}
      <img alt="{{ section.settings.logo_1_alt }}" class="logo-img-item" src="{{ logo_1_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_2_alt }}" class="logo-img-item" src="{{ logo_2_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_3_alt }}" class="logo-img-item" src="{{ logo_3_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_4_alt }}" class="logo-img-item" src="{{ logo_4_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_5_alt }}" class="logo-img-item" src="{{ logo_5_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_6_alt }}" class="logo-img-item" src="{{ logo_6_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_7_alt }}" class="logo-img-item" src="{{ logo_7_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_8_alt }}" class="logo-img-item" src="{{ logo_8_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_9_alt }}" class="logo-img-item" src="{{ logo_9_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_10_alt }}" class="logo-img-item" src="{{ logo_10_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_1_alt }}" class="logo-img-item" src="{{ logo_1_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_2_alt }}" class="logo-img-item" src="{{ logo_2_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_3_alt }}" class="logo-img-item" src="{{ logo_3_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_4_alt }}" class="logo-img-item" src="{{ logo_4_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_5_alt }}" class="logo-img-item" src="{{ logo_5_src }}" width="110" height="44">
      <img alt="{{ section.settings.logo_6_alt }}" class="logo-img-item" src="{{ logo_6_src }}" width="110" height="44">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand logos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Brands" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#dcdcdc" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#171d29", "info": "Leave blank to use the global Heading 2 color (Theme settings → Headings)." },
    { "type": "header", "content": "Colors — mobile only" },
    { "type": "color", "id": "heading_color_mobile", "label": "Heading color (mobile)", "default": "#171d29" },
    { "type": "header", "content": "Font" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    { "type": "header", "content": "Logos" },
    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "text", "id": "logo_1_alt", "label": "Logo 1 alt text", "default": "Ikecho Pearls" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "text", "id": "logo_2_alt", "label": "Logo 2 alt text", "default": "Ice Watch" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "text", "id": "logo_3_alt", "label": "Logo 3 alt text", "default": "Citizen Watches" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
    { "type": "text", "id": "logo_4_alt", "label": "Logo 4 alt text", "default": "Classique Jewellery" },
    { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
    { "type": "text", "id": "logo_5_alt", "label": "Logo 5 alt text", "default": "Burberry" },
    { "type": "image_picker", "id": "logo_6", "label": "Logo 6" },
    { "type": "text", "id": "logo_6_alt", "label": "Logo 6 alt text", "default": "Fossil" },
    { "type": "image_picker", "id": "logo_7", "label": "Logo 7" },
    { "type": "text", "id": "logo_7_alt", "label": "Logo 7 alt text", "default": "Dora International" },
    { "type": "image_picker", "id": "logo_8", "label": "Logo 8" },
    { "type": "text", "id": "logo_8_alt", "label": "Logo 8 alt text", "default": "Georgini Jewellery" },
    { "type": "image_picker", "id": "logo_9", "label": "Logo 9" },
    { "type": "text", "id": "logo_9_alt", "label": "Logo 9 alt text", "default": "Thomas Sabo" },
    { "type": "image_picker", "id": "logo_10", "label": "Logo 10" },
    { "type": "text", "id": "logo_10_alt", "label": "Logo 10 alt text", "default": "Peter W Beck" }
  ]
}
{% endschema %}
