<div class="section-inner testimonials-page-shell" style="background:{{ section.settings.background_color }};">
  <h2 class="section-title{% if section.settings.heading_font != blank %} cc-font-heading-{{ section.settings.heading_font }}{% endif %}" style="{% if section.settings.heading_color != blank %}color:{{ section.settings.heading_color }};{% endif %}">{{ section.settings.heading }}</h2>
  <!-- ALTERNATING IMAGE / TESTIMONIAL CARD GRID -->
  <div class="testimonial-grid cc-moved-style-039" role="list">
    {% assign feature_count = 0 %}
    {% assign testimonial_count = 0 %}
    {% assign skip_next = false %}
    {% comment %} On mobile only every 3rd testimonial keeps its image, giving a "two testimonials, one image" rhythm. {% endcomment %}
    {% assign mobile_counter = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'testimonial' %}
        {% if skip_next %}
          {% assign skip_next = false %}
        {% else %}
          {% assign fallback_image = fallback_images[forloop.index0] %}
          {% if testimonial_count == 0 %}
            {% assign first_block = block %}
            {% assign first_fallback_image = fallback_image %}
            {% assign testimonial_count = testimonial_count | plus: 1 %}
          {% elsif testimonial_count == 1 %}
            <div class="testimonial-entry testimonial-row-centered" role="listitem" {{ block.shopify_attributes }}>
              <article class="testimonial-card-cc">
                <h2 class="cc-moved-style-040 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ first_block.settings.name }}</h2>
                <p class="cc-moved-style-041 cc-preserve-line-breaks" style="color:{{ section.settings.quote_color }};">&quot;{{ first_block.settings.quote }}&quot;</p>
              </article>
              <div class="testimonial-row-images">
                {% if first_block.settings.image %}
                  <img alt="{{ first_block.settings.image_alt | default: first_block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ first_block.settings.image | image_url: width: 480 }}" width="480">
                {% elsif first_fallback_image %}
                  <img alt="{{ first_block.settings.image_alt | default: first_block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ first_fallback_image | asset_url }}" width="480">
                {% endif %}
              </div>
              <article class="testimonial-card-cc testimonial-card-cc--right">
                <h2 class="cc-moved-style-040 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ block.settings.name }}</h2>
                <p class="cc-moved-style-041 cc-preserve-line-breaks" style="color:{{ section.settings.quote_color }};">&quot;{{ block.settings.quote }}&quot;</p>
              </article>
            </div>
            {% assign testimonial_count = testimonial_count | plus: 1 %}
            {% assign mobile_counter = 2 %}
          {% elsif block.settings.layout == 'pair_start' %}
            {% assign partner_index = forloop.index0 | plus: 1 %}
            {% assign partner_block = section.blocks[partner_index] %}
            {% assign partner_fallback_image = fallback_images[partner_index] %}
            {% assign mobile_remainder = mobile_counter | modulo: 3 %}
            {% assign mobile_show_class = '' %}
            {% if mobile_remainder == 2 %}
              {% assign mobile_show_class = ' testimonial-entry-media--mobile-show' %}
            {% endif %}
            {% assign mobile_counter = mobile_counter | plus: 1 %}
            {% assign partner_mobile_remainder = mobile_counter | modulo: 3 %}
            {% assign partner_mobile_show_class = '' %}
            {% if partner_mobile_remainder == 2 %}
              {% assign partner_mobile_show_class = ' testimonial-entry-media--mobile-show' %}
            {% endif %}
            {% assign mobile_counter = mobile_counter | plus: 1 %}
            <div class="testimonial-entry testimonial-entry--paired-row" role="listitem" {{ block.shopify_attributes }}>
              <div class="testimonial-entry-media{{ mobile_show_class }}">
                {% if block.settings.image %}
                  <img alt="{{ block.settings.image_alt | default: block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ block.settings.image | image_url: width: 480 }}" width="480">
                {% elsif fallback_image %}
                  <img alt="{{ block.settings.image_alt | default: block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ fallback_image | asset_url }}" width="480">
                {% endif %}
              </div>
              <article class="testimonial-card-cc">
                <h2 class="cc-moved-style-040 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ block.settings.name }}</h2>
                <p class="cc-moved-style-041 cc-preserve-line-breaks" style="color:{{ section.settings.quote_color }};">&quot;{{ block.settings.quote }}&quot;</p>
              </article>
              {% if partner_block %}
                <div class="testimonial-entry-media{{ partner_mobile_show_class }}">
                  {% if partner_block.settings.image %}
                    <img alt="{{ partner_block.settings.image_alt | default: partner_block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ partner_block.settings.image | image_url: width: 480 }}" width="480">
                  {% elsif partner_fallback_image %}
                    <img alt="{{ partner_block.settings.image_alt | default: partner_block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ partner_fallback_image | asset_url }}" width="480">
                  {% endif %}
                </div>
                <article class="testimonial-card-cc">
                  <h2 class="cc-moved-style-040 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ partner_block.settings.name }}</h2>
                  <p class="cc-moved-style-041 cc-preserve-line-breaks" style="color:{{ section.settings.quote_color }};">&quot;{{ partner_block.settings.quote }}&quot;</p>
                </article>
                {% assign skip_next = true %}
              {% endif %}
            </div>
          {% else %}
            {% assign quote_size = block.settings.quote | size %}
            {% assign is_feature = false %}
            {% assign is_large = false %}
            {% assign feature_position = feature_count | modulo: 2 %}
            {% if block.settings.layout == 'large' %}
              {% assign is_feature = true %}
              {% assign is_large = true %}
            {% elsif quote_size > 420 %}
              {% assign is_feature = true %}
            {% endif %}
            {% assign mobile_remainder = mobile_counter | modulo: 3 %}
            {% assign mobile_show_class = '' %}
            {% if mobile_remainder == 2 %}
              {% assign mobile_show_class = ' testimonial-entry-media--mobile-show' %}
            {% endif %}
            {% assign mobile_counter = mobile_counter | plus: 1 %}
            <div class="testimonial-entry{% if is_feature %} testimonial-entry--feature{% if feature_position == 1 %} testimonial-entry--media-right{% endif %}{% endif %}{% if is_large %} testimonial-entry--large{% endif %}" role="listitem" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="testimonial-entry-media{{ mobile_show_class }}">
                  <img alt="{{ block.settings.image_alt | default: block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ block.settings.image | image_url: width: 720 }}" width="720">
                </div>
              {% elsif fallback_image %}
                <div class="testimonial-entry-media{{ mobile_show_class }}">
                  <img alt="{{ block.settings.image_alt | default: block.settings.name | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ fallback_image | asset_url }}" width="720">
                </div>
              {% endif %}
              <article class="testimonial-card-cc">
                <h2 class="cc-moved-style-040 cc-font-body-{{ section.settings.body_font }}" style="{% if section.settings.name_color != blank %}color:{{ section.settings.name_color }};{% endif %}">{{ block.settings.name }}</h2>
                <p class="cc-moved-style-041 cc-preserve-line-breaks" style="color:{{ section.settings.quote_color }};">&quot;{{ block.settings.quote }}&quot;</p>
              </article>
            </div>
            {% if is_feature %}
              {% assign feature_count = feature_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if section.settings.closing_image %}
      <div class="testimonial-entry testimonial-entry--closing">
        <img alt="{{ section.settings.closing_image_alt | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ section.settings.closing_image | image_url: width: 400 }}" width="400">
      </div>
    {% else %}
      <div class="testimonial-entry testimonial-entry--closing">
        <img alt="{{ section.settings.closing_image_alt | escape }}" class="testimonial-img-cc image-fade" height="280" loading="lazy" src="{{ closing_fallback_image | asset_url }}" width="400">
      </div>
    {% endif %}
  </div>
  <div class="btn-row-center cc-moved-style-042">
    <a class="btn-black-center btn-dark" href="{{ section.settings.cta_link | default: pages['contact'].url }}">{{ section.settings.cta_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials page",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials from Valued Customers" },
    { "type": "header", "content": "Closing image" },
    { "type": "image_picker", "id": "closing_image", "label": "Closing image", "info": "The final decorative image shown after the last testimonial" },
    { "type": "text", "id": "closing_image_alt", "label": "Closing image alt text", "default": "Illustrated diamond icon for Cameron and Co testimonials" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Book an appointment" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to use the Contact page" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the global Heading 1 color (Theme settings → Headings)." },
    { "type": "color", "id": "name_color", "label": "Customer name color", "default": "#19202c", "info": "Leave blank to use the global Heading 3 color (Theme settings → Headings)." },
    { "type": "color", "id": "quote_color", "label": "Quote text color", "default": "#2c2f33" },
    { "type": "header", "content": "Fonts" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Leave unset to use the global Headings font (Theme settings → Headings).",
      "options": [
        { "value": "cormorant", "label": "Cormorant Garamond" },
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "garamond", "label": "EB Garamond" },
        { "value": "baskerville", "label": "Libre Baskerville" }
      ]
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "info": "Leave unset to use the global Paragraph font (Theme settings → Paragraph).",
      "options": [
        { "value": "glacial", "label": "Glacial Indifference" },
        { "value": "montserrat", "label": "Montserrat" },
        { "value": "inter", "label": "Inter" },
        { "value": "poppins", "label": "Poppins" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "info": "Large: full-width row with an enlarged image. Paired: shares a four-column row with the next testimonial, each keeping its own image.",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "large", "label": "Large (enlarged image)" },
            { "value": "pair_start", "label": "Paired with next testimonial" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials page",
      "blocks": [
        { "type": "testimonial", "settings": { "image_alt": "Loose green sapphire gemstones held with tweezers during jewellery appraisal", "name": "Elizabeth Young", "quote": "Very happy with the service and excellent craftsmanship, highly recommended. A big shout out to Mark who is lovely to deal with, very kind and considerate." } },
        { "type": "testimonial", "settings": { "image_alt": "Teal sapphire and diamond halo ring collection by Cameron & Co", "name": "Will Sutherland", "quote": "We had great service from TJ (Tejjas). He walked us through the process to get wedding rings, quoted really good prices and we ended up with rings we're really happy with. Would definitely recommend booking an appointment with Cameron & Co." } },
        { "type": "testimonial", "settings": { "image_alt": "Hands holding a custom jewellery ring design sketch by Cameron & Co", "name": "Kellie Harris", "quote": "Such a lovely experience. Having lost my treasured watch, Cameron & Co helped with a replacement swiftly and easily. Customer service was exceptional. Thank you." } },
        { "type": "testimonial", "settings": { "image_alt": "Stack of coloured gemstone rings in gold and silver bezel settings", "name": "Graham Phy", "quote": "Extremely good jewellery business, gives great advice. Trusted them with my mother's engagement ring that needed repairing and resizing and they did an excellent job." } }
      ]
    }
  ]
}
{% endschema %}