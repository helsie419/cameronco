DATABASE_URL=postgres://user:password@host:5432/dbname
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Xero OAuth. Keep every value below out of source control. Generate the two
# random secrets with: openssl rand -base64 32
XERO_MODE=stub
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:8891/api/xero/auth/callback
XERO_CONNECT_SECRET=generate-a-separate-random-secret
XERO_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Set only if the authorising Xero user can access more than one organisation.
XERO_TENANT_ID=

# SiteGround IMAP read-only customer email test
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@yourdomain.com
IMAP_PASSWORD=mailbox-password
IMAP_MAILBOXES=INBOX,Sent,Sent Items,INBOX.Sent
IMAP_SCAN_LIMIT=100

# Outgoing mail for "Email quote" on the Quotes & Jobs pipeline.
# Defaults to stub mode (logs instead of sending) — no account needed until
# you're ready to go live. Set EMAIL_SEND_MODE=live once these are filled in.
# The SiteGround mailbox above will usually also do outgoing SMTP.
EMAIL_SEND_MODE=stub
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=mailbox-password
SMTP_FROM=you@yourdomain.com
