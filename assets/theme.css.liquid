/* ============================================================
   Cameron & Co — Main Stylesheet
   Fonts: Cormorant Garamond (Google) + Glacial Indifference (legacy CDN)
   The Google Fonts stylesheet is linked directly in layout/theme.liquid's
   document head instead of @import'd here, so the browser fetches it in parallel
   with this file rather than only discovering it after this file loads.
   ============================================================ */


/* Section-level font picker settings (heading_font / body_font selects
   in each section's schema) resolve to one of these classes, applied
   directly on the element alongside its normal class — this is the
   single place that maps a picker's stored key to an actual font
   stack. !important because these sit early in the file (fonts need
   to load before anything else) but must still beat the base element
   rules for site-hero-line2 etc. that are declared much further down. */
.cc-font-heading-cormorant { font-family: 'Cormorant Garamond', Georgia, serif !important; }
.cc-font-heading-playfair { font-family: 'Playfair Display', Georgia, serif !important; }
.cc-font-heading-garamond { font-family: 'EB Garamond', Georgia, serif !important; }
.cc-font-heading-baskerville { font-family: 'Libre Baskerville', Georgia, serif !important; }
.cc-font-body-glacial { font-family: 'Montserrat', Arial, sans-serif !important; }
.cc-font-body-montserrat { font-family: 'Montserrat', Arial, sans-serif !important; }
.cc-font-body-inter { font-family: 'Inter', Arial, sans-serif !important; }
.cc-font-body-poppins { font-family: 'Poppins', Arial, sans-serif !important; }

/* ---- Design Tokens ---- */
:root {
  --color-white: #ffffff;
  --color-dark: #19202c;
  --color-brand-red: #8c6a2f;
  --color-brand-red-light: #b89a5f;
  --color-grey-light: #f7f5f3;
  --color-border: rgba(0, 0, 0, 0.08);

  --color-base: #C5CBD6;
  --color-surface: #D7D3CF;
  --color-surface-glass: rgba(255, 255, 255, 0.95);
  --color-text: #2C2F33;
  --color-text-muted: #6B7280;
  --color-accent: #94371F;
  --color-accent-hover: #AD5038;

  --font-heading: 'Cormorant Garamond', Georgia, serif;
  --font-body: 'Montserrat', Arial, sans-serif;

  --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
  --text-sm: clamp(0.875rem, 0.8rem + 0.38vw, 1rem);
  --text-base: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
  --text-lg: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem);
  --text-xl: clamp(1.5rem, 1.3rem + 1vw, 2rem);
  --text-2xl: clamp(2rem, 1.5rem + 2.5vw, 3rem);
  --text-3xl: clamp(2.5rem, 2rem + 4vw, 4.5rem);

  --space-xs: clamp(0.5rem, 0.4rem + 0.5vw, 0.75rem);
  --space-sm: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  --space-md: clamp(2rem, 1.5rem + 2.5vw, 3rem);
  --space-lg: clamp(4rem, 3rem + 5vw, 6rem);
  --space-xl: clamp(6rem, 5rem + 7.5vw, 10rem);

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.08);
  --border-glass: 1px solid rgba(215, 211, 207, 0.6);

  --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---- Reset ---- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

[hidden] { display: none !important; }

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  color: var(--color-dark);
  background-color: var(--color-white);
  line-height: 1.6;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-smooth);
}

@view-transition {
  navigation: auto;
  types: OutIn;
}

/* ---- Layout ---- */
.container {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 48px;
}

/* ============================================================
   SITE HEADER
   ============================================================ */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 200;
  background: var(--color-white);
  border-bottom: 1px solid var(--color-border);
  padding: 16px 0;
  transition: all var(--transition-smooth);
}

.header-inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-rows: auto auto;
  align-items: center;
}

.site-logo {
  grid-row: 1;
  grid-column: 1;
  display: flex;
  align-items: center;
}

.site-logo img {
  width: 143px;
  height: auto;
}

nav {
  grid-row: 2;
  grid-column: 2 / 4;
  display: flex;
  justify-content: flex-end;
  padding-top: 4px;
}

.primary-nav {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 0;
}

.primary-nav > li {
  position: relative;
}

.primary-nav > li > a,
.primary-nav > li > span {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 18px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--color-dark);
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.3s;
}

.primary-nav > li > a:hover,
.primary-nav > li > span:hover {
  color: #D5B226;
}

.primary-nav > li > a[aria-current="page"],
.primary-nav > li > a[aria-current="true"] {
  color: #D5B226;
  text-decoration: underline;
}

.primary-nav > li > span svg {
  width: 8px;
  height: 8px;
  fill: currentColor;
  flex-shrink: 0;
}

/* Dropdown */
.dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: var(--color-white);
  border-top: 2px solid var(--color-brand-red);
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  min-width: 200px;
  z-index: 300;
  list-style: none;
}

.primary-nav > li:hover .dropdown,
.primary-nav > li.dropdown-open .dropdown {
  display: block;
}

.dropdown li a {
  display: block;
  padding: 12px 20px;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--color-dark);
  border-bottom: 1px solid rgba(0,0,0,0.04);
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}

.dropdown li:last-child a {
  border-bottom: none;
}

.dropdown li a:hover {
  background: var(--color-grey-light);
  color: #D5B226;
}

/* ---- Book Button ---- */
.btn-book {
  grid-row: 1;
  grid-column: 3;
  align-self: start;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  height: 38px;
  min-width: 165px;
  background: var(--color-brand-red);
  color: var(--color-white);
  border: 1px solid var(--color-brand-red);
  border-radius: 5px;
  font-family: var(--font-body);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.4s ease;
  text-align: center;
  text-decoration: none;
}

.btn-book:hover {
  background: var(--color-white);
  color: #D5B226;
  border-color: var(--color-brand-red);
}

/* ---- Hamburger ---- */
.menu-icon {
  display: none;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  padding: 8px;
  border: 1px solid rgba(140, 106, 47,0.32);
  border-radius: 50%;
  background: var(--color-white);
  grid-row: 1;
  grid-column: 1;
  width: 46px;
  height: 46px;
  z-index: 210;
}

.menu-icon span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--color-brand-red);
  border-radius: 10px;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.menu-icon span:last-child {
  width: 16px;
}

.menu-icon.open span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.menu-icon.open span:nth-child(2) {
  opacity: 0;
}

.menu-icon.open span:nth-child(3) {
  width: 24px;
  transform: translateY(-7px) rotate(-45deg);
}

/* ---- Page Content Offset ---- */
.page-content {
  padding-top: 136px;
  min-height: calc(100vh - 136px);
}

/* ============================================================
   SECTIONS
   ============================================================ */
.cc-section {
  width: 100%;
  padding: 60px 0;
}

.section-inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 24px;
}

.section-title {
  font-family: var(--font-heading);
  font-size: clamp(32px, 3.5vw, 48px);
  font-weight: 700;
  text-align: center;
  margin-bottom: 24px;
  color: #D5B226;
}

.section-subtitle {
  font-family: var(--font-body);
  font-size: 16px;
  text-align: center;
  margin-bottom: 40px;
  color: var(--color-dark);
}

/* ============================================================
   HOMEPAGE HERO BENTO GRID
   ============================================================ */
.home-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 20px;
  margin-bottom: 40px;
}

.hero-left-col {
  display: flex;
}

.hero-right-col {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 20px;
}

.hero-card {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  background: var(--color-grey-light);
  min-height: 220px;
  display: flex;
  align-items: flex-end;
}

.hero-card.tall {
  min-height: 460px;
}

.hero-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.hero-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(25, 32, 44, 0.1) 0%, rgba(25, 32, 44, 0.4) 100%);
  z-index: 2;
}

.hero-card-title {
  position: absolute;
  top: 30px;
  left: 30px;
  z-index: 3;
  color: var(--color-dark);
  font-family: var(--font-heading);
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 400;
  text-shadow: 0 1px 12px rgba(255,255,255,0.8);
}

/* ============================================================
   ABOUT PAGE — STOREFRONT + STAGGERED ROWS
   ============================================================ */
.storefront-img {
  width: 100%;
  height: clamp(300px, 45vh, 550px);
  object-fit: cover;
  filter: grayscale(100%) contrast(1.1);
  border-radius: var(--radius-md);
  margin-bottom: 30px;
  box-shadow: var(--shadow-glass);
}

.staggered-section {
  display: grid;
  gap: 60px;
  margin-top: 40px;
}

.staggered-row {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 40px;
  align-items: center;
}

.staggered-row.reverse {
  grid-template-columns: 1fr 1.2fr;
}

.staggered-content h3 {
  font-family: var(--font-heading);
  font-size: 28px;
  color: #D5B226;
  margin-bottom: 15px;
  font-weight: 400;
}

.staggered-content p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
}

.staggered-image img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: var(--radius-md);
  box-shadow: 0 8px 24px rgba(0,0,0,0.05);
}

/* ============================================================
   TESTIMONIALS PAGE — ALTERNATING GRID
   ============================================================ */
.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.testimonial-card-cc {
  background: var(--color-white);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: var(--radius-sm);
  padding: 36px 28px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 280px;
}

.testimonial-card-cc .diamond-icon {
  margin-bottom: 16px;
  width: 24px;
  height: auto;
  opacity: 0.7;
}

.testimonial-card-cc p {
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--color-text);
  margin-bottom: 20px;
}

.testimonial-card-cc h4 {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: bold;
  color: var(--color-dark);
}

.testimonial-img-cc {
  width: 100%;
  height: 280px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 15px rgba(0,0,0,0.03);
}

/* ============================================================
   HOMEPAGE TESTIMONIALS PREVIEW — COPY GRID / COPY CARD
   ============================================================ */
.copy-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.copy-card {
  background: var(--color-white);
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: var(--radius-sm);
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.copy-card h3 {
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: bold;
  color: var(--color-dark);
}

.copy-card .diamond-icon {
  width: 24px;
  height: auto;
  margin-bottom: 12px;
  opacity: 0.7;
}

.copy-card p {
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--color-text);
  margin-top: 10px;
  font-style: italic;
}

/* ============================================================
   FAQ PAGE — STACKED CATEGORY SECTIONS
   Each category is a full-width band; its questions flow in two
   columns on wider screens so no single category towers over the
   others the way three uneven side-by-side columns used to.
   ============================================================ */
.faq-columns-cc {
  display: flex;
  flex-direction: column;
  gap: 48px;
  margin-top: 40px;
}

.faq-column-cc h3 {
  font-family: var(--font-heading);
  font-size: 26px;
  color: var(--color-dark);
  font-weight: 400;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 1.5px solid var(--color-brand-red);
  padding-bottom: 8px;
}

.faq-column-cc h3 img {
  width: 22px;
  height: auto;
}

.faq-column-cc .faq-list {
  column-count: 2;
  column-gap: 40px;
}

.faq-list details {
  break-inside: avoid;
}

/* Details / Summary Accordion */
.faq-list details {
  border-bottom: 1px solid var(--color-border);
}

.faq-list details:first-child {
  border-top: 1px solid var(--color-border);
}

.faq-list summary {
  padding: 14px 0;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 13.5px;
  color: var(--color-dark);
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  user-select: none;
  transition: color 0.2s;
}

.faq-list summary:hover {
  color: #D5B226;
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary::after {
  content: '+';
  font-size: 20px;
  color: #D5B226;
  flex-shrink: 0;
  line-height: 1;
  transition: transform 0.2s;
}

.faq-list details[open] > summary::after {
  transform: rotate(45deg);
}

.faq-list details p {
  padding: 0 0 16px;
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--color-text);
}

/* ============================================================
   OFFICE / SERVICE PAGES — SERVICE LIST
   ============================================================ */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 30px;
  border-top: 1px solid var(--color-border);
}

.service-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 0;
  border-bottom: 1px solid var(--color-border);
}

.service-list-item h3 {
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: normal;
  color: var(--color-dark);
}

/* ============================================================
   BRAND LOGOS STRIP
   ============================================================ */
.logos-strip {
  background-color: #dcdcdc;
  padding: 30px 48px;
  overflow: hidden;
}

.logos-track-wrap {
  overflow: hidden;
  position: relative;
}

.logos-track {
  display: flex;
  align-items: center;
  gap: 40px;
  animation: logos-scroll 30s linear infinite;
  width: max-content;
}

.logos-track:hover {
  animation-play-state: paused;
}

@keyframes logos-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.logo-img-item {
  height: 44px;
  width: auto;
  max-width: 110px;
  object-fit: contain;
  filter: grayscale(80%);
  opacity: 0.65;
  flex-shrink: 0;
  mix-blend-mode: multiply;
  transition: opacity 0.2s, filter 0.2s;
}

.logo-img-item:hover {
  opacity: 1;
  filter: grayscale(0%);
}

/* fallback text logos */
.logo-item {
  font-family: var(--font-body);
  font-size: clamp(14px, 2vw, 20px);
  color: #4b5563;
  letter-spacing: 0.18em;
  font-weight: bold;
  text-transform: uppercase;
  flex-shrink: 0;
}

/* ============================================================
   DIAMOND OUTLINE DECORATION
   ============================================================ */
.cc-diamond-decor {
  display: block;
  margin: 0 auto 12px;
  width: 32px;
  height: auto;
  opacity: 0.8;
}

/* ============================================================
   CARE PAGE — RED CARDS
   ============================================================ */
.red-care-card {
  background: #a85454;
  color: var(--color-white);
  border-radius: var(--radius-md);
  padding: 40px;
  box-shadow: 0 8px 24px rgba(168, 84, 84, 0.15);
}

.red-care-card h3 {
  font-family: var(--font-heading);
  font-size: 26px;
  margin-bottom: 16px;
  color: var(--color-white);
}

.red-care-card p {
  color: rgba(255, 255, 255, 0.9);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn-black-center {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 32px;
  height: 48px;
  background: var(--color-dark);
  color: var(--color-white);
  border: 1px solid var(--color-dark);
  border-radius: 5px;
  font-family: var(--font-body);
  font-size: 15px;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  margin: 30px auto 0;
}

.btn-black-center:hover {
  background: var(--color-white);
  color: var(--color-dark);
}

.btn-row-center {
  display: flex;
  justify-content: center;
  width: 100%;
}

/* ============================================================
   SITE FOOTER
   ============================================================ */
.site-footer {
  background: var(--cc-footer);
  position: relative;
  overflow: hidden;
  color: var(--color-white);
}

.site-footer::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url({{ 'cameron-co-luxury-jewellery-background-texture.webp' | asset_url }}) center/cover no-repeat;
  opacity: 0.14;
  pointer-events: none;
}

.footer-inner {
  position: relative;
  max-width: 1220px;
  margin: 0 auto;
  padding: 72px 48px 38px;
  z-index: 5;
}

.footer-top {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: start;
  gap: 42px;
  margin-bottom: 80px;
}

.footer-offices {
  display: contents;
}

.footer-offices h2 {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--color-white);
  margin-bottom: 8px;
  margin-top: 20px;
}

.footer-offices h2:first-child {
  margin-top: 0;
}

.footer-offices p,
.footer-offices a {
  font-family: var(--font-heading);
  font-size: 13px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.footer-nav-col h3,
.footer-col h3 {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--color-white);
  margin-bottom: 12px;
}

.footer-nav-col ul,
.footer-col ul {
  list-style: none;
  margin-bottom: 0;
}

.footer-nav-col ul li a,
.footer-col ul li a {
  font-family: var(--font-body);
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  line-height: 1.9;
  display: block;
  transition: color 0.2s;
}

.footer-nav-col ul li a:hover,
.footer-col ul li a:hover {
  color: var(--color-white);
}

.footer-office,
.footer-col,
.footer-right-col {
  min-width: 0;
  grid-column: auto;
}

.footer-right-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
  justify-self: start;
  margin: 0;
}

.footer-social {
  display: flex;
  gap: 14px;
}

.footer-social a {
  display: inline-flex;
  width: 30px;
  height: 30px;
  padding: 0;
}

.footer-social a img {
  width: 30px;
  height: 30px;
  object-fit: cover;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-copyright,
.footer-credit {
  font-family: var(--font-body);
  font-size: 11px;
  color: rgba(255, 255, 255, 0.7);
}

.footer-credit a {
  text-decoration: underline;
  color: var(--color-white);
}

.footer-links-row {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.footer-links-row a {
  font-family: var(--font-body);
  font-size: 11px;
  color: rgba(255, 255, 255, 0.7);
}

.footer-links-row a:hover {
  color: var(--color-white);
}

/* ============================================================
   PRICING MODAL
   ============================================================ */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(25, 32, 44, 0.65);
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-overlay.open {
  display: flex;
}

.modal-card {
  background: var(--color-white);
  border-radius: 12px;
  width: 100%;
  max-width: 620px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 48px 52px 44px;
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,0.15);
}

.modal-close {
  position: absolute;
  top: 20px;
  right: 24px;
  background: none;
  border: none;
  font-size: 24px;
  color: #D5B226;
  cursor: pointer;
  line-height: 1;
}

.pricing-form .form-group {
  margin-bottom: 24px;
}

.pricing-form label {
  display: block;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--color-dark);
  margin-bottom: 8px;
}

.pricing-form input[type="text"],
.pricing-form input[type="email"] {
  width: 100%;
  background: #f5f5f5;
  border: none;
  border-bottom: 1.5px solid var(--color-brand-red);
  padding: 10px 12px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--color-dark);
  outline: none;
  border-radius: 4px 4px 0 0;
}

.pricing-form input:focus {
  background: #ededed;
}

.rte-wrap {
  border: 1px solid #d4d4d4;
  border-radius: 6px;
  overflow: hidden;
}

.rte-toolbar {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 8px 10px;
  border-bottom: 1px solid #d4d4d4;
  background: #fcfcfc;
  flex-wrap: wrap;
}

.rte-toolbar button {
  background: none;
  border: none;
  padding: 4px 7px;
  cursor: pointer;
  font-size: 14px;
  color: var(--color-dark);
  border-radius: 3px;
  line-height: 1;
}

.rte-toolbar button:hover {
  background: #eee;
}

.rte-toolbar select {
  border: none;
  background: none;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--color-dark);
  cursor: pointer;
  padding: 4px;
  outline: none;
}

.rte-sep {
  width: 1px;
  height: 18px;
  background: #d4d4d4;
  margin: 0 4px;
}

.rte-content {
  min-height: 200px;
  padding: 14px 12px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--color-dark);
  line-height: 1.6;
  outline: none;
  background: var(--color-white);
}

.btn-submit {
  display: block;
  margin: 32px auto 0;
  padding: 0 40px;
  height: 50px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-family: var(--font-body);
  font-size: 16px;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-submit:hover {
  background: #222;
}

.form-success {
  text-align: center;
  padding: 20px 0;
  font-family: var(--font-heading);
  font-size: 22px;
  color: var(--color-dark);
}

/* ============================================================
   COOKIE BANNER
   ============================================================ */
.cookie-banner {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 150;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 48px;
  padding: 12px 24px;
  background: var(--color-brand-red-light);
  color: var(--color-white);
}

.cookie-banner p {
  font-size: 13px;
  margin: 0;
}

.cookie-banner a {
  text-decoration: underline;
}

.cookie-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-shrink: 0;
}

.cookie-actions button {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: var(--color-white);
  padding: 6px 12px;
  border-radius: 4px;
  font-family: var(--font-body);
  font-size: 12px;
  cursor: pointer;
  transition: background 0.2s;
}

.cookie-actions button:hover {
  background: rgba(255, 255, 255, 0.3);
}

.cookie-actions button.accept {
  background: var(--color-white);
  color: #D5B226;
  font-weight: bold;
}

.cookie-actions button.accept:hover {
  background: rgba(255, 255, 255, 0.9);
}

.cookie-settings-panel {
  position: fixed;
  right: 24px;
  bottom: 80px;
  z-index: 160;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24px;
  width: 320px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.cookie-settings-panel h2 {
  font-family: var(--font-heading);
  font-size: 20px;
  margin-bottom: 8px;
  color: #D5B226;
}

.cookie-settings-panel p {
  font-size: 13px;
  color: var(--color-text-muted);
  margin-bottom: 16px;
}

.cookie-settings-panel label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  margin-bottom: 18px;
}

.cookie-settings-panel button {
  width: 100%;
  height: 38px;
  background: var(--color-brand-red);
  color: var(--color-white);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 13px;
}

/* ============================================================
   APP PAGES (Diamonds, Booking) — kept for compatibility
   ============================================================ */
.page-shell {
  min-height: 100vh;
  padding: 148px 24px 64px;
  background: linear-gradient(180deg, #fff 0%, #f7f5f3 100%);
}

.brand-page {
  width: min(1120px, 100%);
  margin: 0 auto;
}

.brand-hero {
  display: grid;
  gap: 14px;
  margin-bottom: 32px;
}

.brand-hero h1 {
  margin: 0;
  color: #4D493F;
  font-family: var(--font-heading);
  font-size: clamp(34px, 5vw, 62px);
  font-weight: 700;
  line-height: 1.1;
}

.brand-hero p {
  max-width: 720px;
  margin: 0;
  font-size: 16px;
  color: var(--color-text-muted);
}

.app-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  align-items: start;
}

.booking-card {
  max-width: 760px;
}

.form-row-2,
.form-row-3 {
  display: grid;
  gap: 14px;
}

.form-row-2 {
  grid-template-columns: repeat(2, 1fr);
}

.form-row-3 {
  grid-template-columns: repeat(3, 1fr);
}

@media (max-width: 640px) {
  .form-row-2,
  .form-row-3 {
    grid-template-columns: 1fr;
  }
}

.app-panel,
.result-panel,
.booking-card {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-white);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.03);
}

.app-panel,
.booking-card {
  padding: 22px;
}

.result-panel {
  min-height: 360px;
  padding: 18px;
}

.filter-form,
.booking-form {
  display: grid;
  gap: 14px;
}

.filter-form label,
.booking-form label {
  display: grid;
  gap: 6px;
  font-size: 12px;
  color: var(--color-dark);
}

.filter-form input,
.filter-form select,
.booking-form input,
.booking-form select,
.booking-form textarea {
  width: 100%;
  min-height: 42px;
  border: 1px solid #c9ced4;
  border-radius: 4px;
  padding: 10px 11px;
  color: var(--color-dark);
  background: var(--color-white);
  font-family: var(--font-body);
  font-size: 14px;
}

.booking-form textarea {
  min-height: 86px;
  resize: vertical;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 18px;
  border: 1px solid var(--color-brand-red);
  border-radius: 5px;
  color: var(--color-white);
  background: var(--color-brand-red);
  font-family: var(--font-body);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s;
}

.brand-button:hover {
  background: var(--color-white);
  color: #D5B226;
}

.brand-button.secondary {
  color: #D5B226;
  background: var(--color-white);
}

.brand-button.secondary:hover {
  background: var(--color-brand-red);
  color: var(--color-white);
}

.diamond-grid,
.slot-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 14px;
}

.diamond-card,
.slot-button {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-white);
}

.diamond-card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.diamond-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  background: #f0eeec;
}

.diamond-card .diamond-body {
  display: grid;
  gap: 6px;
  padding: 14px;
  flex-grow: 1;
}

.diamond-card h3 {
  margin: 0;
  color: #D5B226;
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 700;
}

.slot-button {
  min-height: 58px;
  padding: 12px;
  color: var(--color-dark);
  text-align: left;
  cursor: pointer;
  font-family: var(--font-body);
}

.slot-button:hover,
.slot-button.selected {
  border-color: var(--color-brand-red);
  color: #D5B226;
}

.status-line {
  margin-top: 14px;
  color: #4b5563;
  font-size: 13px;
}

.toast {
  position: fixed;
  right: 20px;
  bottom: 68px;
  z-index: 90;
  padding: 12px 16px;
  border-radius: 4px;
  background: #151c27;
  color: #fff;
  font-family: var(--font-body);
  font-size: 13px;
  box-shadow: 0 10px 28px rgba(0,0,0,0.22);
}

/* ============================================================
   LUXURY HERO (FAQ, Office, Diamonds, Care pages)
   ============================================================ */
.luxury-hero {
  position: relative;
  height: clamp(320px, 45vh, 480px);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 136px;
}

.luxury-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.luxury-hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(25, 32, 44, 0.52);
  z-index: 1;
}

.luxury-hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: var(--color-white);
  padding: 0 24px;
  max-width: 720px;
}

.luxury-hero-content h1 {
  font-family: var(--font-heading);
  font-size: clamp(30px, 5vw, 58px);
  font-weight: 400;
  color: var(--color-white);
  margin-bottom: 14px;
  line-height: 1.1;
}

.luxury-hero-content .tagline {
  font-size: 15px;
  opacity: 0.88;
  margin-bottom: 24px;
  font-family: var(--font-body);
}

.btn-hero {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28px;
  height: 42px;
  background: transparent;
  color: var(--color-white);
  border: 1px solid rgba(255,255,255,0.75);
  border-radius: 5px;
  font-family: var(--font-body);
  font-size: 13px;
  text-decoration: none;
  transition: all 0.3s;
}

.btn-hero:hover {
  background: var(--color-white);
  color: var(--color-dark);
}

/* ============================================================
   SPLIT TWO-COLUMN LAYOUT (Office, Care, Diamond pages)
   ============================================================ */
.split-layout {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 48px;
  align-items: center;
}

/* Reverse: image left, text right */
.split-layout.reverse {
  grid-template-columns: 1fr 1.15fr;
}

.split-layout.reverse .split-image {
  order: -1;
}

.split-text {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.split-text h1,
.split-text h2 {
  font-family: var(--font-heading);
  font-size: clamp(24px, 3vw, 38px);
  font-weight: 400;
  color: var(--color-dark);
  margin-bottom: 4px;
}

.split-text p {
  font-size: 15px;
  line-height: 1.75;
  color: var(--color-text);
}

.split-text a {
  color: #D5B226;
}

.split-image img,
.split-image iframe {
  width: 100%;
  height: 360px;
  object-fit: cover;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-glass);
  display: block;
  border: none;
}

/* Office/Service buttons */
.btn-office {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22px;
  height: 40px;
  background: var(--color-dark);
  color: var(--color-white);
  border: 1px solid var(--color-dark);
  border-radius: 5px;
  font-family: var(--font-body);
  font-size: 13px;
  text-decoration: none;
  transition: all 0.3s;
}

.btn-office:hover {
  background: var(--color-white);
  color: var(--color-dark);
}

.office-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}

/* ============================================================
   CONTACT PAGE — OFFICES ROW
   ============================================================ */
.offices-row {
  display: flex;
  justify-content: center;
  gap: 48px;
  flex-wrap: wrap;
  margin-top: 40px;
}

.office-card {
  flex: 1;
  max-width: 425px;
  min-width: 280px;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 36px;
  box-shadow: var(--shadow-glass);
}

.office-card h4 {
  font-family: var(--font-heading);
  font-size: 24px;
  font-weight: 700;
  color: #D5B226;
  margin-bottom: 16px;
}

.office-map {
  width: 100%;
  height: 260px;
  border: none;
  border-radius: var(--radius-md);
  display: block;
  margin-bottom: 24px;
}

.office-details {
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text);
}

.office-details a {
  color: #D5B226;
  transition: opacity 0.2s;
}

.office-details a:hover {
  opacity: 0.8;
}

/* ============================================================
   FOCUS STATES (accessibility)
   ============================================================ */
a:focus-visible,
button:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--color-brand-red);
  outline-offset: 3px;
  border-radius: 2px;
}

summary:focus-visible {
  outline: 2px solid var(--color-brand-red);
  outline-offset: 2px;
}

/* ============================================================
   RESPONSIVE — TABLET & MOBILE (max 860px)
   ============================================================ */
@media (max-width: 1200px) {

  /* Header */
  .menu-icon { display: flex; }

  .site-header {
    min-height: 76px;
    padding: 12px 0;
  }

  .site-header .container {
    padding: 0 24px;
  }

  .site-header .header-inner {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
  }

  .btn-book { display: none; }

  .site-logo {
    grid-column: 2;
    justify-content: flex-end;
    margin-left: auto;
  }

  nav { display: none; }

  .site-header.mobile-open nav {
    display: block;
    grid-row: 2;
    grid-column: 1 / 3;
    width: 100%;
    padding: 16px 0 8px;
  }

  .site-header.mobile-open .primary-nav {
    display: grid;
    gap: 4px;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-white);
    box-shadow: 0 14px 34px rgba(0,0,0,0.08);
  }

  .site-header.mobile-open .primary-nav > li > a,
  .site-header.mobile-open .primary-nav > li > span {
    justify-content: space-between;
    padding: 12px;
    font-size: 15px;
  }

  .site-header.mobile-open .dropdown {
    position: static;
    display: block;
    min-width: 0;
    border-top: 1px solid rgba(140, 106, 47,0.15);
    box-shadow: none;
    padding-left: 12px;
  }

  /* Page content */
  .page-content { padding-top: 104px; }

  .luxury-hero {
    padding-top: 104px;
    height: clamp(280px, 50vw, 360px);
  }

  /* Layouts */
  .split-layout,
  .split-layout.reverse {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .split-layout.reverse .split-image {
    order: 0;
  }

  .split-image img,
  .split-image iframe { height: 240px; }

  .home-hero-grid { grid-template-columns: 1fr; }

  .hero-card.tall { min-height: 300px; }

  .staggered-row,
  .staggered-row.reverse {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .staggered-image img { height: 240px; }

  .testimonial-grid { grid-template-columns: 1fr; }

  .copy-grid { grid-template-columns: 1fr; }

  .faq-column-cc .faq-list { column-count: 1; }

  /* Footer */
  .footer-inner { padding: 40px 24px 32px; }

  .footer-top {
    grid-template-columns: 1fr 1fr;
    text-align: left;
    gap: 32px;
  }

  .footer-top > :first-child { grid-column: 1 / -1; }

  .footer-right-col {
    grid-column: 1 / -1;
    align-items: flex-start;
  }

  /* Misc */
  .app-grid { grid-template-columns: 1fr; }

  .offices-row {
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .office-card {
    width: 100%;
    max-width: 425px;
  }

  .logos-strip { padding: 24px; }

  .cookie-banner {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 16px;
  }

  .cookie-actions {
    flex-wrap: wrap;
  }

  .service-list-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 0;
  }
}

@media (max-width: 480px) {
  .container { padding: 0 16px; }
  .section-inner { padding: 0 16px; }
  .modal-card { padding: 32px 24px 28px; }
}


/* ============================================================
   2026-06 correction pass: Cameron & Co live-site fidelity
   Purpose: restore a closer legacy-style visual treatment while preserving
   uploaded page structure and the approved footer component.
   ============================================================ */
:root{
  --cc-red:#8c6a2f;
  --cc-black:#19202c;
  --cc-muted:#767676;
  --cc-cream:#f7f5f3;
  --cc-footer:#1a202b;
}
body{
  background:#fff;
  color:var(--cc-black);
  font-family:var(--font-body), Arial, sans-serif;
  font-size:14px;
  letter-spacing:.01em;
}
.site-header{
  background:#fff;
  min-height:118px;
  padding:18px 0 12px;
  border-bottom:0;
  box-shadow:none;
}
.header-inner{
  max-width:1180px;
  margin:0 auto;
  padding:0 42px;
  display:grid;
  grid-template-columns:190px 1fr 174px;
  grid-template-rows:58px 34px;
  column-gap:28px;
  align-items:center;
}
.site-logo{grid-column:1;grid-row:1 / 3;align-self:center;justify-self:start;}
.site-logo img{width:150px;height:auto;display:block;}
.site-header nav{grid-column:2;grid-row:2;justify-content:flex-end;padding:0;}
.primary-nav{gap:0;justify-content:flex-end;}
.primary-nav>li>a,.primary-nav>li>span{
  font-size:14px;
  line-height:1.2;
  color:#202733;
  padding:7px 16px;
  font-weight:400;
  letter-spacing:0;
}
.primary-nav>li>a:hover,.primary-nav>li>span:hover,.primary-nav>li>a[aria-current="page"]{
  color:#D5B226;
  text-decoration:none;
}
.dropdown{
  border-top:0;
  box-shadow:0 7px 18px rgba(0,0,0,.08);
  min-width:210px;
  padding:10px 0 16px;
}
.dropdown li a{font-size:13px;padding:11px 18px;background:#fff;}
.btn-book{
  grid-column:3;grid-row:1;
  justify-self:end;align-self:center;
  height:38px;min-width:160px;
  border-radius:5px;background:var(--cc-red);border-color:var(--cc-red);
  font-size:14px;color:#fff;
}
.btn-book:hover{background:#fff;color:#D5B226;}
.page-content{padding-top:118px;}
.cc-section{padding:48px 0;}
.section-inner{max-width:980px;padding:0 22px;}
.section-title,h1.section-title,h2.section-title{
  color:#D5B226;
  font-family:var(--font-heading), Georgia, serif;
  font-weight:700;
  font-size:clamp(34px,4vw,56px);
  line-height:1.04;
  margin:0 0 24px;
