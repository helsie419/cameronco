  border-color: var(--color-brand-red) !important;
  background: rgba(140, 106, 47, 0.03) !important;
  box-shadow: 0 0 0 1.5px var(--color-brand-red) !important;
  color: #D5B226 !important;
}

/* Swatch container centering */
.swatch-grid {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 12px !important;
}

.swatch-grid .filter-btn {
  justify-content: space-between !important;
}

/* Karat circle styling */
.swatch-color {
  width: 38px !important;
  height: 38px !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-family: "Montserrat", Arial, sans-serif !important;
  font-size: 10px !important;
  font-weight: 400 !important;
  color: #171d29 !important;
  border: 1px solid rgba(0, 0, 0, 0.12) !important;
  margin: 0 auto !important;
}

.swatch-color.rose-gold {
  background: #E5BCA7 !important; /* Premium rose gold tone from image */
}

.swatch-color.white-gold {
  background: #E6E6E6 !important; /* Silver gray white gold */
}

.swatch-color.yellow-gold {
  background: #EED097 !important; /* Yellow gold */
}

.swatch-color.platinum {
  background: #D9D9D9 !important; /* Platinum grey */
}

/* Collapsible expansion panels */
.extra-filters-wrapper {
  display: none;
  flex-wrap: wrap !important;
  gap: 12px !important;
}

/* More Toggle style matching image link */
.btn-more-toggle {
  background: transparent !important;
  border: none !important;
  color: #6b6661 !important;
  font-family: "Montserrat", Arial, sans-serif !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  cursor: pointer !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  padding: 6px 0 !important;
  margin-top: 10px !important;
  outline: none !important;
  align-self: flex-start !important;
}

.btn-more-toggle:hover {
  color: #171d29 !important;
}

.btn-more-toggle .more-icon {
  font-size: 10px !important;
  display: inline-block !important;
}

/* Visually hidden screen reader class for SEO and accessibility */
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* Footer bottom bar: divider, then copyright / links / credit centered on one
   line below it. Rules are unconditional (not media-gated) and use !important
   throughout so they consistently win over the older, conflicting declarations
   above, regardless of viewport width. Only genuinely small screens fall back
   to a stacked layout. */
.footer-copyright,
.footer-credit,
.footer-links-row a {
  color: rgba(255, 255, 255, 0.85) !important;
}

.footer-bottom {
  position: relative !important;
  display: flex !important;
  flex-wrap: nowrap !important;
  justify-content: center !important;
  align-items: center !important;
  row-gap: 12px !important;
  column-gap: 24px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  border-top: 0 !important;
  padding-top: 28px !important;
}

.footer-bottom::before {
  content: '' !important;
  position: absolute !important;
  top: 0 !important;
  left: 50% !important;
  width: 100vw !important;
  transform: translateX(-50%) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
}

.footer-links-row {
  display: flex !important;
  flex-wrap: nowrap !important;
  justify-content: center !important;
  gap: 16px !important;
}

@media (max-width: 640px) {
  .footer-bottom {
    flex-wrap: wrap !important;
  }
  .footer-links-row {
    flex-wrap: wrap !important;
  }
}

.footer-copyright,
.footer-credit,
.footer-links-row a {
  white-space: nowrap !important;
  font-size: 12px !important;
}

@media (max-width: 600px) {
  .footer-copyright,
  .footer-credit,
  .footer-links-row a {
    white-space: normal !important;
  }
}

/* ============================================================
   2026-07 homepage hero redesign
   Adds a full-bleed photographic hero above the existing bento
   grid, restyles the (previously unstyled) bento card labels,
   brands strip and testimonials grid, corrects the type scale
   (display headlines were too large relative to body copy), and
   swaps the site's accent from red to a brass/gold, site-wide.
   ============================================================ */
:root {
  --cc-gold: #8c6a2f;
  --cc-gold-deep: #6e5324;
  --cc-ivory: #f7f5f3;
  --cc-ink: #3a362f;
}

/* ---- nav link type scale: an earlier pass set these to 22px Cormorant
   Garamond, wide enough to overflow the header grid and push "Book
   Appointment" off-screen at normal desktop widths. Back to a sane nav size. ---- */
.site-header .primary-nav > li > a,
.site-header .primary-nav > li > .nav-parent {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
}
/* grid items default to a content-based min-width, so a nav this long could
   still force the "Book Appointment" column past the header's own max-width
   even at the smaller font size above — let it shrink/wrap instead of pushing out */
.header-inner nav {
  min-width: 0;
}
.header-inner .primary-nav {
  flex-wrap: wrap;
  row-gap: 4px;
  justify-content: flex-end;
}

/* ---- accent swap, site-wide: red -> brass/gold ---- */
/* matches the specificity (and !important) of an earlier correction-pass rule
   that hardcodes .site-header .primary-nav > li > a to red, or this loses too */
.site-header .primary-nav > li > a,
.site-header .primary-nav > li > .nav-parent {
  color: #D5B226 !important;
}
.site-header .primary-nav > li > a:hover,
.site-header .primary-nav > li > .nav-parent:hover,
.site-header .primary-nav > li > a[aria-current="page"] {
  color: #D5B226 !important;
}
.site-header .dropdown a:hover {
  background: #f7f3ee;
  color: #D5B226;
}
.site-header .dropdown a:hover {
  background: #f7f3ee;
  color: #D5B226;
}
.btn-book,
.btn-red,
.page-button-red,
.brand-button.btn-red,
.btn-hero {
  background: var(--cc-gold) !important;
  border-color: var(--cc-gold) !important;
  color: #ffffff !important;
}
.btn-book:hover,
.btn-red:hover,
.page-button-red:hover,
.brand-button.btn-red:hover,
.btn-hero:hover {
  background: var(--cc-gold-deep) !important;
  border-color: var(--cc-gold-deep) !important;
  color: #ffffff !important;
}
/* The file has several earlier "correction pass" layers that re-declare
   .site-header .btn-book directly (a more specific compound selector than
   plain .btn-book above), so the color swap above loses to them despite
   being later in the file — specificity beats source order. Match their
   specificity exactly so this genuinely is the final word. */
.site-header .btn-book,
.site-header .btn-book:visited {
  background: var(--cc-gold) !important;
  border-color: var(--cc-gold) !important;
  color: #ffffff !important;
}
.site-header .btn-book:hover,
.site-header .btn-book:focus {
  background: var(--cc-gold-deep) !important;
  border-color: var(--cc-gold-deep) !important;
  color: #ffffff !important;
}
.section-title, h1.section-title, h2.section-title {
  color: #D5B226;
}

/* ---- type scale correction: smaller display headlines, larger legible body copy ---- */
.section-title, h1.section-title, h2.section-title {
  font-size: clamp(28px, 3vw, 40px);
  line-height: 1.1;
}
.section-subtitle {
  font-size: 17px;
  line-height: 1.6;
}
body, p {
  font-size: 16px;
  line-height: 1.7;
}

/* ============================================================
   HERO — photo, headline, CTA (sits above the bento grid, right
   below the fixed header; page-content's existing padding-top
   already clears the header, so no extra offset math needed)
   ============================================================ */
.site-hero {
  position: relative;
  min-height: 620px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: #141210;
  margin-bottom: 8px;
}
.site-hero-photo {
  position: absolute;
  inset: 0;
  background-image: url('{{ "cameron-co-engagement-ring-box-satin-background-hero.webp" | asset_url }}');
  background-size: cover;
  background-position: 72% 78%;
  background-repeat: no-repeat;
  transform: scale(1.6);
  transform-origin: 72% 78%;
}
.site-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(247, 245, 243, .4) 0%, transparent 20%, transparent 68%, rgba(247, 245, 243, .55) 88%, rgba(247, 245, 243, .85) 100%);
}
.site-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 900px;
  padding: 0 64px 64px 76px;
}
@media (min-width: 1280px) {
  .site-hero-eyebrow,
  .site-hero-line2 {
    white-space: nowrap;
  }
}
.site-hero-eyebrow {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 16px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--cc-ink);
  margin-bottom: 16px;
}
.site-hero-line1 {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: clamp(20px, 2vw, 24px);
  color: var(--cc-ink);
  line-height: 1.25;
}
.site-hero-line2 {
  font-family: var(--font-heading);
  font-style: italic;
  font-weight: 700;
  font-size: clamp(38px, 4.6vw, 58px);
  color: var(--cc-ink);
  line-height: 1.05;
  margin: 2px 0 0 0;
}
.site-hero-line2 .accent {
  color: #D5B226;
}
.site-hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 28px 0 0 0;
  background: var(--cc-gold);
  color: #ffffff;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 14px;
  padding: 16px 32px;
  border-radius: 999px;
  border: 1px solid var(--cc-gold);
  text-decoration: none;
  transition: background .35s cubic-bezier(.16, 1, .3, 1), transform .35s cubic-bezier(.16, 1, .3, 1);
}
.site-hero-cta:hover {
  background: var(--cc-gold-deep);
  border-color: var(--cc-gold-deep);
  transform: translateY(-2px);
}
.site-hero-cta svg {
  width: 13px;
  height: 13px;
  transition: transform .35s cubic-bezier(.16, 1, .3, 1);
}
.site-hero-cta:hover svg {
  transform: translateX(3px);
}

/* NOTE: .hero-card / .hero-card-label styling lives in assets/index.css (the
   homepage-only stylesheet, loaded after this file) — it fully owns this
   already, including rounded corners and the pill label. A duplicate rule
   used to live here from before that file's existence was known about; it's
   been removed since having both set conflicting position offsets (top vs
   bottom) was stretching the label into a large oval instead of a pill. */

/* ---- insurance copy: contained width for readability ---- */
.insurance-copy {
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

/* ---- brands strip: full-bleed background, gutter-contained content ---- */
.logos-strip {
  padding: 56px 0;
}
.logos-strip .brands-title {
  max-width: 1360px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 64px;
}
.logos-track-wrap {
  max-width: 1360px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 64px;
}

/* ---- testimonials: 3-up card grid (previously unstyled) ---- */
.home-testimonials-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 8px;
}
.home-testimonial-card {
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, .06);
  border-radius: 20px;
  padding: 28px 26px 24px;
  text-align: left;
  box-shadow: 0 14px 34px rgba(20, 20, 20, .06);
}
.home-testimonial-card .testimonial-diamond {
  width: 22px;
  height: 22px;
  margin-bottom: 14px;
  display: block;
}
.home-testimonial-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 19px;
  color: #D5B226;
  margin-bottom: 10px;
}
.home-testimonial-card p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--cc-ink);
}

/* ---- .home-button had no CSS anywhere on the site: "Book an appointment",
   "Chat to us" and "Read more" were all rendering as plain unstyled text ---- */
.home-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px 32px;
  border-radius: 999px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  border: 1px solid transparent;
  transition: background .3s cubic-bezier(.16, 1, .3, 1), transform .3s cubic-bezier(.16, 1, .3, 1), color .3s;
}
.home-button:hover {
  transform: translateY(-2px);
}
.home-button-red {
  background: var(--cc-gold);
  border-color: var(--cc-gold);
  color: #ffffff;
}
.home-button-red:hover {
  background: var(--cc-gold-deep);
  border-color: var(--cc-gold-deep);
}
.home-button-dark {
  background: transparent;
  border-color: var(--cc-black, #19202c);
  color: var(--cc-black, #19202c);
}
.home-button-dark:hover {
  background: var(--cc-black, #19202c);
  color: #ffffff;
}

/* Mobile hero: text overlaid on the photo again (matching the
   reference mockup) rather than stacked as separate blocks — the
   text stays left-aligned in the softer/blurred left portion of the
   crop so it doesn't cross the hands or ring. */
@media (max-width: 900px) {
  .site-hero { min-height: 520px; align-items: flex-start !important; }
  .site-hero-inner { padding: 56px 24px 40px; max-width: 100%; transform: none !important; }
  .site-hero-eyebrow { font-size: 11px; letter-spacing: .08em; white-space: normal; }
  .site-hero-line2 { font-size: clamp(32px, 9vw, 48px); margin-left: 0; white-space: normal; }
  .site-hero-cta { margin-left: 0; max-width: 100%; box-sizing: border-box; white-space: normal; text-align: center; }
  .home-testimonials-list { grid-template-columns: 1fr; }
  .logos-strip .brands-title, .logos-track-wrap { padding: 0 24px; }
}

@media (max-width: 480px) {
  .site-hero { min-height: 460px; }
  .site-hero-line1 { font-size: 18px; }
  .site-hero-line2 { font-size: clamp(28px, 11vw, 40px); }
  .site-hero-cta { padding: 13px 24px; font-size: 13px; }
}

/* Brand logos strip: crystal-facet background texture (longhand so it
   doesn't get reset by the earlier shorthand `background:` declarations
   for .logos-strip above). */
.logos-strip {
  background-image: linear-gradient(rgba(220, 220, 220, 0.88), rgba(220, 220, 220, 0.88)), url('{{ "cameron-co-crystal-facet-background-texture.webp" | asset_url }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* Ring Builder / Diamonds pages: intro header + Nivoda app-block slot. */
.page-intro-section {
  padding: 0 0 40px;
}
.page-intro-section .section-inner {
  max-width: 760px;
}
.page-intro-description {
  font-family: var(--font-body);
  font-size: 17px;
  line-height: 1.6;
  color: var(--cc-black, #171d29);
  text-align: center;
}
.page-intro-description p {
  margin: 0;
}
.app-embed-slot {
  padding: 0 0 80px;
}
.app-embed-placeholder {
  max-width: 640px;
  margin: 0 auto;
  padding: 48px 32px;
  border: 1px dashed rgba(23, 29, 41, 0.25);
  border-radius: 12px;
  background: var(--cc-cream, #f7f5f3);
  text-align: center;
}
.app-embed-placeholder p {
  margin: 0;
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.6;
  color: var(--cc-black, #171d29);
}

/* NOTE: this used to also set a frosted-glass backdrop-filter blur, but
   that blur applies uniformly across the header's full height — including
   the bottom portion that header.liquid's inline gradient fades to fully
   transparent — so it created a hard "blur cutoff" line exactly at the
   header's bottom edge instead of a soft blend into the hero image below.
   Removed so the fade is genuinely seamless. */

/* Nav-wrap fix: the primary nav needs ~1250px to fit on one line without
   wrapping, but the hamburger only used to kick in at 900px, leaving a
   ~350px dead zone of broken two-line nav. The hamburger breakpoint was
   moved up to 1280px above; this final override matches the specificity
   and !important of the earlier unguarded ".site-header .site-logo" /
   ".site-header .site-logo img" rules (which apply at ALL widths and were
   forcing the logo into the hamburger's grid column) so the logo actually
   lands in its own centered column within the new mobile range.
   2026-07: pulled the hamburger threshold in to 1200px so the full nav
   stays visible on more "normal" laptop-width screens instead of
   dropping to the hamburger so early. That's below the ~1250px the nav
   ideally wants, so between 1200-1250px it can rely on the
   `.header-inner .primary-nav { flex-wrap: wrap; row-gap: 4px; }` safety
   net to soft-wrap onto a second line rather than overflow. */
@media (max-width: 1200px) {
  .site-header .site-logo {
    grid-column: 2 !important;
    grid-row: 1 !important;
    justify-self: center !important;
    align-self: center !important;
  }
  .site-header .site-logo img {
    width: 142px !important;
    max-width: 142px !important;
  }
}
@media (max-width: 760px) {
  .site-header .site-logo img {
    width: 120px !important;
    max-width: 120px !important;
  }
}

/* ============================================================
   2026-07 header relayout v2: logo back on the left, vertically
   centered across the full header height, sized up substantially so
   it reads at the same visual weight as the nav + book button.
   Hamburger stays on the right on mobile.
   ============================================================ */
@media (min-width: 1201px) {
  .site-header {
    min-height: 136px !important;
  }
  .site-header .header-inner {
    grid-template-columns: auto 1fr auto !important;
    column-gap: 14px !important;
    min-height: 136px !important;
  }
  .site-header .site-logo {
    grid-column: 1 !important;
    grid-row: 1 / 3 !important;
    justify-self: start !important;
    align-self: center !important;
  }
  .site-header .site-logo img {
    width: 340px !important;
    max-width: 340px !important;
  }
  .site-header nav {
    grid-column: 2 !important;
    grid-row: 2 !important;
    padding-top: 0 !important;
  }
  .site-header .primary-nav > li > a,
  .site-header .primary-nav > li > .nav-parent {
    padding-top: 4px !important;
    padding-bottom: 4px !important;
  }
  .site-header .btn-book {
    grid-column: 3 !important;
    grid-row: 1 !important;
    align-self: end !important;
  }
}

/* Mobile: hamburger to the far right, logo stays on the left (same
   side as desktop), sized up noticeably from the old 142px/120px.
   The open mobile nav panel's grid placement is reset to auto so its
   left:0/right:0 absolute positioning spans the full header again,
   now that there are three columns instead of two. */
@media (max-width: 1200px) {
  .site-header {
    min-height: 84px !important;
  }
  .site-header .header-inner {
    grid-template-columns: auto 1fr 56px !important;
    min-height: 84px !important;
  }
  .site-header .menu-icon {
    grid-column: 3 !important;
    grid-row: 1 !important;
    justify-self: center !important;
  }
  .site-header .site-logo {
    grid-column: 1 !important;
    justify-self: start !important;
  }
  .site-header .site-logo img {
    width: 280px !important;
    max-width: 280px !important;
  }
  .site-header.mobile-open nav {
    grid-column: auto !important;
    grid-row: auto !important;
  }
  .page-content {
    padding-top: 84px !important;
  }
}
@media (max-width: 760px) {
  .site-header {
    min-height: 72px !important;
  }
  .site-header .header-inner {
    min-height: 72px !important;
  }
  .site-header .site-logo img {
    width: 230px !important;
    max-width: 230px !important;
  }
  .page-content {
    padding-top: 72px !important;
  }
}

/* ============================================================
   Footer: final layout, supersedes every earlier footer-top /
   footer-offices patch above (kept for history, all beaten by
   the !important + specificity + source-order here).
   3 equal columns, 2 rows, at every width down to 560px:
     row 1: Melbourne office | Sydney office | Social icons
     row 2: Menu             | About         | Education
   (footer-right-col was moved in the markup to sit right after
   footer-offices so it lands in row 1 via normal grid auto-flow.)
   Below 560px: single column, offices side-by-side as their own
   row, then Menu / About / Education stacked, social icons last
   (pushed to the end with `order` rather than reordering markup).
   ============================================================ */
.site-footer .footer-top { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
.site-footer .footer-offices { display: contents !important; }
.site-footer .footer-col-education,
.site-footer .footer-right-col { grid-column: auto !important; }
.site-footer .footer-col-education,
.site-footer .footer-col-education ul { text-align: left !important; }
@media (max-width: 560px) {
  /* 2 columns at this width (3 made Menu/About/Education too narrow
     and wrapped badly): offices row, Menu+About row, Education row
     (alone, 2nd column empty), social row. footer-offices and
     footer-right-col span both columns for their own full-width row. */
  .site-footer .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 14px !important; }
  .site-footer .footer-offices {
    grid-column: 1 / -1 !important;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 20px !important;
  }
  .site-footer .footer-right-col { grid-column: 1 / -1 !important; order: 999 !important; }
}

/* Contact page office cards: earlier "legacy cleanup" passes stripped
   border-radius/box-shadow to flat/square, then a later padding
   override left them that way permanently. Restore the same subtle
   rounded + shadowed card treatment used elsewhere on the site
   (e.g. .home-testimonial-card). */
.office-card {
  border-radius: 6px;
  box-shadow: 0 2px 5px rgba(23, 29, 41, 0.13);
  padding: 28px;
}

/* ============================================================
   FINAL MOBILE, ACCESSIBILITY AND CONTRAST OVERRIDES
   Keep this block at the end of the file.
   ============================================================ */
:root {
  --color-gold-accessible: #7a5b12;
  --color-gold-accessible-hover: #60470d;
  --color-focus: #7a5b12;
}

.cc-section {
  width: 100%;
  padding: 48px 0;
}

.section-inner,
.section-title,
.section-subtitle,
.page-intro-section,
.home-services-shell,
.insurance-section,
.what-we-do-section,
.home-testimonials-preview {
  min-width: 0;
}

.section-title,
h1.section-title,
h2.section-title,
.page-intro-section h1,
.insurance-title,
.home-services-shell .section-title,
.what-we-do-section .section-title,
.home-testimonials-preview .section-title {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow: visible !important;
  line-height: 1.12 !important;
  padding-top: 0.08em;
  padding-bottom: 0.14em;
  text-wrap: balance;
  overflow-wrap: anywhere;
}

/* Darker gold for normal-sized text on light backgrounds. */
.section-eyebrow,
.service-item-num,
.home-testimonial-card h3,
.faq-list summary::after,
.primary-nav > li > a,
.primary-nav > li > .nav-parent,
.office-details a,
.split-text a {
  color: var(--color-gold-accessible) !important;
}

.primary-nav > li > a:hover,
.primary-nav > li > .nav-parent:hover,
.office-details a:hover,
.split-text a:hover {
  color: var(--color-gold-accessible-hover) !important;
}

a:focus-visible,
button:focus-visible,
summary:focus-visible,
[tabindex]:focus-visible {
  outline: 3px solid var(--color-focus) !important;
  outline-offset: 3px !important;
}

@media (max-width: 760px) {
  .cc-section {
    padding: 40px 0;
  }

  .section-inner {
    width: 100% !important;
    max-width: 100% !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  .section-title,
  h1.section-title,
  h2.section-title,
  .page-intro-section h1,
  .insurance-title,
  .home-services-shell .section-title,
  .what-we-do-section .section-title,
  .home-testimonials-preview .section-title {
    font-size: clamp(2.35rem, 11.5vw, 3.5rem) !important;
    line-height: 1.13 !important;
    margin-bottom: 20px !important;
    padding-top: 0.1em !important;
    padding-bottom: 0.18em !important;
  }

  .section-subtitle,
  .page-intro-description,
  .insurance-copy,
  .service-item p,
  .home-testimonial-card p {
    font-size: 1rem !important;
    line-height: 1.7 !important;
  }

  .office-card,
  .about-text-card,
  .about-values-card,
  .testimonial-card-cc {
    padding: 24px !important;
  }

  .office-buttons,
  .cc-moved-style-010 {
    align-items: stretch;
  }

  .office-buttons a,
  .cc-moved-style-010 a,
  .service-list-item .btn-book {
    width: 100%;
    max-width: none;
    min-height: 44px;
  }
}

/* ============================================================
   UNIFIED PRIMARY BUTTON STYLE — final word, appended last so it
   wins over the earlier "correction pass" layers above. One solid
   gold background + bold white text across every primary CTA
   (Book an appointment, Read more, Chat to us, etc). Secondary /
   outline buttons (.btn-outline-red) are intentionally excluded —
   they're meant to look different from the primary action beside
   them.
   ============================================================ */
.btn-book:not(.btn-outline-red),
.btn-black-center:not(.btn-outline-red),
.btn-office:not(.btn-outline-red),
.home-button:not(.btn-outline-red),
.site-hero-cta {
  background: #cba922 !important;
  border-color: #cba922 !important;
  color: #ffffff !important;
  font-weight: 700 !important;
}

.btn-book:not(.btn-outline-red):hover,
.btn-black-center:not(.btn-outline-red):hover,
.btn-office:not(.btn-outline-red):hover,
.home-button:not(.btn-outline-red):hover,
.site-hero-cta:hover {
  background: #a68d1c !important;
  border-color: #a68d1c !important;
  color: #ffffff !important;
}

/* ============================================================
   UNIFIED HEADER POSITIONING — the homepage gets its own
   index.css stylesheet (only loaded on the homepage template),
   which set the logo/nav positioning that matches the approved
   mockup. Every other page was still on the older base values,
   so the logo sat in a visibly different spot depending on which
   page you were on. Apply the homepage's values everywhere, final
   word appended last.
   ============================================================ */
@media (min-width: 1201px) {
  .site-header .header-inner {
    gap: 24px !important;
    max-width: 1320px !important;
    padding: 0 24px !important;
    grid-template-columns: 340px 1fr 174px !important;
  }
}
@media (max-width: 1200px) {
  .site-header .header-inner {
    grid-template-columns: 56px 1fr 0 !important;
    padding: 0 22px !important;
  }
}

/* Dropdown chevron on admin-menu parent items (.nav-parent) — the
   existing chevron rule only targeted the older `span svg` pattern. */
.site-header .primary-nav > li > .nav-parent svg {
  width: 8px;
  height: 8px;
  fill: currentColor;
  flex-shrink: 0;
  margin-left: 4px;
}

/* ============================================================
   ROUNDED IMAGE CORNERS — applied consistently across every
   photographic content image (article heroes, content blocks,
   testimonials, about page, bento grid, embedded maps). The
   homepage's full-bleed hero background is deliberately excluded —
   it spans edge-to-edge with no card framing, so rounding it would
   look like a rendering error rather than a design choice. Small
   icons/logos (favicon, social icons, brand logo strip) are also
   excluded — rounding a 20-30px mark doesn't read as intentional.
   ============================================================ */
.live-article-hero img,
.article-image,
.about-storefront-frame img,
.about-image-card img,
.testimonial-img-cc,
.hero-card,
.office-map {
  border-radius: 16px !important;
  overflow: hidden !important;
}