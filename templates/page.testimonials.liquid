{% comment %}
  Converted from testimonials.html
  Suggested Shopify Page settings (set these in the Shopify admin
  when you create the Page and assign this template):
    Title: Testimonials | Cameron & Co Jewellers
    Meta description: Read testimonials from Cameron & Co customers about our jewellery insurance replacement, custom design, repairs, and remodelling services.
    Template suffix: testimonials
{% endcomment %}
<main class="page-content" id="main-content">
<div class="section-inner">
<h1 class="section-title">Testimonials from Valued Customers</h1>
<!-- ALTERNATING IMAGE / TESTIMONIAL CARD GRID -->
<div class="testimonial-grid cc-moved-style-039" role="list">
<!-- ROW 1 -->
<img alt="Loose green sapphire gemstones held with tweezers during jewellery appraisal" class="testimonial-img-wix image-fade" height="280" loading="lazy" src="{{ 'cameron-co-loose-green-sapphire-gemstones.webp' | asset_url }}" width="400"/>
<article class="testimonial-card-wix source-diamond-zone" role="listitem">
<h2 class="cc-moved-style-040">Elizabeth Young</h2>
<p class="cc-moved-style-041">
            "Very happy with the service and excellent craftsmanship, highly recommended. A big shout out to Mark who is lovely to deal with, very kind and considerate."
          </p>
</article>
<img alt="Teal sapphire and diamond halo ring collection by Cameron &amp; Co" class="testimonial-img-wix image-fade" height="280" loading="lazy" src="{{ 'cameron-co-teal-sapphire-diamond-halo-rings.webp' | asset_url }}" width="400"/>
<!-- ROW 2 -->
<article class="testimonial-card-wix source-diamond-zone" role="listitem">
<h2 class="cc-moved-style-040">Will Sutherland</h2>
<p class="cc-moved-style-041">
            "We had great service from TJ (Tejjas). He walked us through the process to get wedding rings, quoted really good prices and we ended up with rings we're really happy with. Would definitely recommend booking an appointment with Cameron &amp; Co."
          </p>
</article>
<img alt="Hands holding a custom jewellery ring design sketch by Cameron &amp; Co" class="testimonial-img-wix image-fade" height="280" loading="lazy" src="{{ 'cameron-co-custom-ring-design-sketch.webp' | asset_url }}" width="400"/>
<article class="testimonial-card-wix source-diamond-zone" role="listitem">
<h2 class="cc-moved-style-040">Kellie Harris</h2>
<p class="cc-moved-style-041">
            "Such a lovely experience. Having lost my treasured watch, Cameron &amp; Co helped with a replacement swiftly and easily. Customer service was exceptional. Thank you."
          </p>
</article>
<!-- ROW 3 -->
<img alt="Stack of coloured gemstone rings in gold and silver bezel settings" class="testimonial-img-wix image-fade" height="280" loading="lazy" src="{{ 'cameron-co-coloured-gemstone-bezel-rings.webp' | asset_url }}" width="400"/>
<article class="testimonial-card-wix source-diamond-zone" role="listitem">
<h2 class="cc-moved-style-040">Graham Phy</h2>
<p class="cc-moved-style-041">
            "Extremely good jewellery business, gives great advice. Trusted them with my mother's engagement ring that needed repairing and resizing and they did an excellent job."
          </p>
</article>
<img alt="Geometric brilliant-cut diamond outline illustration by Cameron &amp; Co" class="testimonial-img-wix image-fade" height="280" loading="lazy" src="{{ 'cameron-co-diamond-brilliant-cut-illustration.webp' | asset_url }}" width="400"/>
</div>
<div class="btn-row-center cc-moved-style-042">
<a class="btn-black-center btn-dark" href="{{ pages['contact'].url }}">Chat to us</a>
</div>
</div>
</main>
