{% comment %}
  Labelled diamond anatomy diagram (top view + side profile with dimension
  callouts), built as inline SVG so every label is real vector text —
  sharp at any zoom, on-brand colour, and editable without regenerating
  an image. Replaces the old anatomy-of-a-diamond-chart.webp.

  Usage: {% render 'diamond-anatomy-diagram' %}
{% endcomment %}

<div class="diamond-anatomy">
  <svg viewBox="0 0 620 600" role="img" aria-label="Diagram of a round brilliant diamond showing the table, crown, girdle, pavilion and culet, with dimension labels for table width, girdle diameter, crown height, pavilion depth and girdle thickness">
    <!-- Top view -->
    <g stroke="#171d29" stroke-width="1.25" fill="none">
      <circle cx="310" cy="100" r="70"/>
      <polygon points="310,50 344,72 344,128 310,150 276,128 276,72"/>
      <line x1="310" y1="30" x2="310" y2="50"/>
      <line x1="310" y1="150" x2="310" y2="170"/>
      <line x1="245" y1="65" x2="276" y2="72"/>
      <line x1="375" y1="65" x2="344" y2="72"/>
      <line x1="245" y1="135" x2="276" y2="128"/>
      <line x1="375" y1="135" x2="344" y2="128"/>
    </g>

    <!-- Side profile -->
    <g stroke="#171d29" stroke-width="1.5" fill="none" stroke-linejoin="round">
      <path d="M250,220 L370,220 L450,270 L450,284 L370,284 L250,284 L170,284 L170,270 Z"/>
      <path d="M170,284 L310,500 L450,284"/>
      <line x1="250" y1="220" x2="310" y2="500" stroke-width="0.75" opacity="0.5"/>
      <line x1="370" y1="220" x2="310" y2="500" stroke-width="0.75" opacity="0.5"/>
    </g>
    <circle cx="310" cy="500" r="3" fill="#171d29"/>

    <!-- Table Width -->
    <g stroke="#BD9C42" stroke-width="1">
      <line x1="250" y1="204" x2="370" y2="204"/>
      <line x1="250" y1="197" x2="250" y2="211"/>
      <line x1="370" y1="197" x2="370" y2="211"/>
    </g>
    <text x="310" y="192" text-anchor="middle" font-size="13" fill="#171d29">Table Width</text>

    <!-- Girdle Diameter -->
    <g stroke="#BD9C42" stroke-width="1">
      <line x1="170" y1="545" x2="450" y2="545"/>
      <line x1="170" y1="538" x2="170" y2="552"/>
      <line x1="450" y1="538" x2="450" y2="552"/>
    </g>
    <text x="310" y="568" text-anchor="middle" font-size="13" fill="#171d29">Girdle Diameter</text>

    <!-- Crown Height -->
    <g stroke="#BD9C42" stroke-width="1">
      <line x1="130" y1="220" x2="130" y2="270"/>
      <line x1="123" y1="220" x2="137" y2="220"/>
      <line x1="123" y1="270" x2="137" y2="270"/>
    </g>
    <text x="15" y="249" text-anchor="start" font-size="13" fill="#171d29">Crown Height</text>

    <!-- Pavilion Depth -->
    <g stroke="#BD9C42" stroke-width="1">
      <line x1="130" y1="284" x2="130" y2="500"/>
      <line x1="123" y1="284" x2="137" y2="284"/>
      <line x1="123" y1="500" x2="137" y2="500"/>
    </g>
    <text x="15" y="396" text-anchor="start" font-size="13" fill="#171d29">Pavilion Depth</text>

    <!-- Girdle Thickness -->
    <g stroke="#BD9C42" stroke-width="1">
      <line x1="470" y1="270" x2="470" y2="284"/>
      <line x1="463" y1="270" x2="477" y2="270"/>
      <line x1="463" y1="284" x2="477" y2="284"/>
      <line x1="477" y1="277" x2="495" y2="277"/>
    </g>
    <text x="500" y="281" text-anchor="start" font-size="13" fill="#171d29">Girdle Thickness</text>

    <!-- Culet -->
    <line x1="310" y1="500" x2="355" y2="528" stroke="#BD9C42" stroke-width="1"/>
    <text x="360" y="532" text-anchor="start" font-size="13" fill="#171d29">Culet</text>
  </svg>
</div>
